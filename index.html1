
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#100b10">
<title>JOPPEPOPE TRACKER</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.embed.ly/player-0.1.0.min.js"></script>

<style>
:root {
  color-scheme: dark;
  --bg:#100b10; --panel:rgba(35,23,27,.78);
  --solid:#24171c; --text:#fff5f0; --muted:#c0a8a7;
  --accent:#ff792f; --accent2:#ffd08a;
  --border:rgba(255,145,83,.25); --glow:rgba(255,111,40,.22);
  --shadow:rgba(0,0,0,.35);
  --blue:#63b7ff; --cyan:#86f0ff;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:25px}
body{
  margin:0;min-height:100vh;overflow-x:hidden;color:var(--text);
  background:radial-gradient(ellipse at 50% -15%,#45221e 0%,transparent 48%),var(--bg);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  transition:background 1s ease,color .8s ease;
}
body.album-past{
  --bg:#060d1b;--panel:rgba(12,28,53,.76);--solid:#101d34;
  --text:#f1f7ff;--muted:#a3bbd8;--accent:#65aaff;--accent2:#9cd6ff;
  --border:rgba(116,185,255,.23);--glow:rgba(47,132,255,.24);
  background:radial-gradient(ellipse at 50% -15%,#142c5d 0%,transparent 52%),var(--bg);
}
button,input,select,textarea{font:inherit}
button{cursor:pointer;-webkit-tap-highlight-color:transparent}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{
  outline:2px solid var(--accent2);outline-offset:3px
}
::selection{background:#ff884e;color:#170b06}
.ambient{position:fixed;inset:0;overflow:hidden;z-index:-1;pointer-events:none;contain:strict}
.ambient-grid{
  position:absolute;inset:0;opacity:.13;
  background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
  background-size:54px 54px;mask-image:linear-gradient(to bottom,black,transparent 90%)
}
.orb{position:absolute;border-radius:50%;filter:blur(70px);opacity:.25;animation:floatOrb 19s ease-in-out infinite alternate;transition:background 1s}
.orb-one{width:360px;height:360px;background:#ff663b;top:4%;left:-150px}
.orb-two{width:420px;height:420px;background:#d34b94;top:37%;right:-220px;animation-delay:-7s}
.orb-three{width:340px;height:340px;background:#ffb253;top:75%;left:15%;animation-delay:-12s}
body.album-past .orb-one{background:#177dff}
body.album-past .orb-two{background:#653bff}
body.album-past .orb-three{background:#00d6ed}
@keyframes floatOrb{
  0%{transform:translate(0,0) scale(1)}
  50%{transform:translate(55px,45px) scale(1.13)}
  100%{transform:translate(-25px,85px) scale(.92)}
}
.container{width:min(1120px,calc(100% - 36px));margin:auto;padding:26px 0 65px;position:relative}
.hero{padding:25px 0 30px;animation:intro .9s cubic-bezier(.2,.7,.2,1) both}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:48px}
.logo{display:flex;align-items:center;gap:10px;color:var(--accent2);font-size:11px;letter-spacing:2px;font-weight:950}
.logo-dot{width:9px;height:9px;border-radius:50%;background:#ff792f;box-shadow:0 0 17px #ff792f;animation:pulse 2s infinite}
.admin-button{
  border:1px solid var(--border);color:var(--text);
  background:linear-gradient(135deg,rgba(255,126,55,.13),rgba(255,255,255,.025));
  padding:11px 16px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:.8px;
  backdrop-filter:blur(18px);transition:.3s;box-shadow:0 0 20px rgba(255,111,35,.05)
}
.admin-button:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 0 28px var(--glow)}
.settings-button{border:1px solid var(--border);color:var(--text);background:rgba(255,255,255,.035);padding:11px 14px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:.7px;backdrop-filter:blur(18px);transition:.3s}
.settings-button:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 0 24px var(--glow)}
.topbar-actions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;justify-content:flex-end}
.settings-options{display:grid;gap:16px}
.settings-toggle{display:flex;align-items:center;gap:10px;color:var(--text);font-size:12px}
.settings-toggle input{accent-color:var(--accent);width:17px;height:17px}
body.reduce-motion *,body.reduce-motion *::before,body.reduce-motion *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}

.category-options{display:flex;gap:9px;flex-wrap:wrap;margin-top:7px}
.category-options label{display:flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:10px;padding:9px 11px;background:rgba(255,255,255,.035);font-size:11px;color:var(--text);cursor:pointer}
.category-options input{accent-color:var(--accent);width:15px;height:15px}
.playing-now{display:inline-grid;place-items:center;margin-left:3px;width:20px;height:20px;border:1px solid var(--accent);border-radius:7px;background:var(--glow);color:var(--accent2);font-size:11px;line-height:1;vertical-align:middle;white-space:nowrap}
.playing-now-dot{display:none}
.track-aliases{margin-top:4px;color:var(--muted);font-size:10px;line-height:1.5;overflow-wrap:anywhere}
/* Track text size setting: use stronger selectors so the main theme rules below cannot override it. */
body.text-small .track-name,
body.text-small .album-song{font-size:11px!important}
body.text-small .track-description,
body.text-small .album-description,
body.text-small .track-aliases{font-size:10px!important}
body.text-large .track-name,
body.text-large .album-song{font-size:16px!important}
body.text-large .track-description,
body.text-large .album-description{font-size:14px!important}
body.text-large .track-aliases{font-size:12px!important}
body.compact-tracks td{padding-top:9px;padding-bottom:9px}
body.hide-descriptions .track-description,body.hide-descriptions .album-description{display:none}
body.hide-category-emojis .track-category-emoji{display:none}
.playlist-collection{display:grid;gap:12px;margin-top:16px;max-height:48vh;overflow:auto}
.playlist-card{border:1px solid var(--border);border-radius:14px;padding:13px;background:rgba(255,255,255,.025)}
.playlist-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.playlist-card-title{font-size:13px;font-weight:900;color:var(--text)}
.playlist-card-actions{display:flex;gap:6px;flex-wrap:wrap}
.playlist-song{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 0;border-top:1px solid var(--border);font-size:11px;color:var(--muted)}
.playlist-song:first-of-type{margin-top:10px}
.playlist-song-name{min-width:0;overflow-wrap:anywhere;color:var(--text)}
.playlist-song-actions{display:flex;gap:5px;flex-shrink:0}
.playlist-song-actions button,.playlist-card-actions button{border:1px solid var(--border);border-radius:8px;padding:6px 8px;background:var(--panel);color:var(--text);font-size:10px;font-weight:800}
.playlist-create{display:flex;align-items:end;gap:10px;flex-wrap:wrap}
.playlist-create .form-field{flex:1;min-width:180px}

body.theme-purple{--accent:#c18aff;--accent2:#f0c0ff;--border:rgba(193,138,255,.25);--glow:rgba(171,89,255,.2)}
body.theme-green{--accent:#70e6a0;--accent2:#baffc8;--border:rgba(112,230,160,.25);--glow:rgba(65,205,126,.18)}
.hero-label{display:flex;align-items:center;gap:10px;color:var(--muted);text-transform:uppercase;letter-spacing:3px;font-size:10px;font-weight:800;margin-bottom:19px}
.live-dot{width:7px;height:7px;flex-shrink:0;border-radius:50%;background:#7bffb0;box-shadow:0 0 12px #7bffb0;animation:pulse 2s infinite}
h1{margin:0;font-size:clamp(48px,10vw,100px);font-weight:1000;line-height:.89;letter-spacing:-.075em}
.hero-gradient{
  color:transparent;background:linear-gradient(100deg,#ff814a,#ffbd7c 38%,#f77eb9 75%,#bb94ff);
  background-clip:text;-webkit-background-clip:text;filter:drop-shadow(0 0 22px rgba(255,115,66,.1))
}
body.album-past .hero-gradient{background-image:linear-gradient(100deg,#72b8ff,#72f1ff 45%,#b2a1ff)}
.subtitle{max-width:570px;margin:24px 0 0;font-size:14px;line-height:1.9;color:var(--muted)}
.hero-bottom{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}
.status-chip{display:inline-flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid var(--border);background:rgba(255,255,255,.035);border-radius:999px;color:var(--muted);font-size:10px;letter-spacing:.7px;font-weight:800}
.section{
  position:relative;isolation:isolate;margin-top:25px;overflow:hidden;
  border:1px solid var(--border);border-radius:23px;background:var(--panel);
  box-shadow:0 25px 90px var(--shadow),0 0 38px var(--glow);
  backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);
  transition:background .8s,border-color .8s,box-shadow .4s
}
.section::before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:linear-gradient(115deg,transparent 25%,rgba(255,255,255,.035) 48%,transparent 70%);
  background-size:220% 100%;animation:neonSweep 9s linear infinite
}
.section-header{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:24px 26px;border-bottom:1px solid var(--border);background:linear-gradient(110deg,rgba(255,255,255,.035),transparent)}
.eyebrow{color:var(--accent2);font-size:9px;font-weight:950;letter-spacing:2.7px;margin-bottom:9px}
.section-header h2{margin:0;font-size:16px;font-weight:950;letter-spacing:1.2px}
.section-body{padding:25px 26px}
.pill{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;padding:7px 10px;border-radius:999px;color:var(--accent2);background:var(--glow);border:1px solid var(--border);font-size:9px;font-weight:900;letter-spacing:.8px;text-transform:uppercase}
.before-section{
  --accent:#ff792f;--accent2:#ffd08a;--border:rgba(255,139,67,.29);
  --glow:rgba(255,105,35,.20);--panel:rgba(43,22,16,.85);--muted:#d8b3a0;
  color:#fff5f0;
  background:radial-gradient(ellipse at 0 0,rgba(255,94,28,.12),transparent 43%),linear-gradient(140deg,rgba(39,21,17,.97),rgba(24,15,20,.95));
  box-shadow:0 25px 80px rgba(0,0,0,.3),0 0 35px rgba(255,105,35,.10)
}
.before-section .section-header{background:linear-gradient(100deg,rgba(255,117,43,.12),transparent 75%)}
.before-section .eyebrow,.before-section .pill{color:#ffbd82}
.before-section .section-header h2{text-shadow:0 0 20px rgba(255,110,38,.15)
}
/* Category badge styling */
.before-section tbody .pill {
gap: 6px;
padding: 7px 11px;
font-size: 9px;
letter-spacing: 0.8px;
transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.before-section tbody tr:hover .pill {
transform: translateY(-1px);
box-shadow: 0 0 14px var(--glow);
}

.toolbar{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:17px}
.field{min-width:0;color:var(--text);background:rgba(0,0,0,.24);border:1px solid var(--border);border-radius:13px;padding:12px 14px;transition:border-color .25s,box-shadow .25s,transform .25s}
.field:focus,.form-field input:focus,.form-field select:focus,.form-field textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--glow),0 0 22px var(--glow);outline:none}
.toolbar .search{flex:1 1 230px}
.toolbar select{flex:0 1 195px}
#sortSelect{font-size:11px;font-weight:850;cursor:pointer;background-color:#211512;color:#ffca9d}
#sortSelect option{background:#211512;color:#fff1e8}
#sortSelect:hover{box-shadow:0 0 22px var(--glow)}
.filter-row{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:19px}
.filter-btn,.small-btn{
  position:relative;overflow:hidden;border:1px solid var(--border);background:rgba(255,255,255,.035);
  color:var(--muted);border-radius:11px;padding:10px 15px;font-size:10px;font-weight:900;letter-spacing:.8px;
  transition:transform .25s,background .25s,color .25s,box-shadow .25s,border-color .25s
}
.filter-btn:hover,.small-btn:hover{transform:translateY(-2px);color:var(--text);border-color:var(--accent)}
.before-section .filter-btn:hover{color:#ffd2ae;box-shadow:0 0 20px rgba(255,105,35,.13)}
.filter-btn.active{
  color:#241006;border-color:transparent;background:linear-gradient(110deg,var(--accent),var(--accent2));
  box-shadow:0 5px 22px var(--glow);animation:filterGlow 3s infinite
}
.filter-btn:active,.primary-btn:active,.secondary-btn:active,.danger-btn:active{transform:scale(.97)}
@keyframes filterGlow{50%{box-shadow:0 5px 30px var(--glow)}}
.table-wrap{border:1px solid var(--border);border-radius:15px;overflow-x:auto;background:rgba(0,0,0,.14)}
.before-section .table-wrap{border-color:rgba(255,132,62,.23);box-shadow:inset 0 0 24px rgba(255,105,35,.025)}
table{width:100%;border-collapse:collapse;min-width:600px}
th{padding:15px;background:rgba(255,255,255,.035);color:var(--muted);text-align:left;font-size:9px;text-transform:uppercase;letter-spacing:1.4px}
.before-section th{color:#ffbd91;background:rgba(255,117,43,.065)}
td{padding:16px 15px;border-top:1px solid rgba(255,255,255,.055);font-size:12px;color:var(--muted)}
tbody tr{transition:background .25s;animation:rowEnter .35s ease both}
tbody tr:hover{background:var(--glow)}
.before-section tbody tr:hover{background:rgba(255,112,43,.09);box-shadow:inset 3px 0 #ff792f}
.track-name{font-weight:850;color:var(--text);font-size:13px;transition:color .25s,text-shadow .25s}
.before-section tbody tr:hover .track-name{color:#ffd0a3;text-shadow:0 0 16px rgba(255,122,47,.2)}
.empty{padding:32px 15px;text-align:center;color:var(--muted);font-size:12px}
.muted{color:var(--muted)}
@keyframes rowEnter{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}
#trackTable.filter-refresh tr{animation:rowEnter .32s ease both}
#trackTable.filter-refresh tr:nth-child(2){animation-delay:25ms}
#trackTable.filter-refresh tr:nth-child(3){animation-delay:50ms}
#trackTable.filter-refresh tr:nth-child(4){animation-delay:75ms}

/* PERMANENT BLUE ALBUM */
.album-section{
  --accent:#65b5ff;--accent2:#9be9ff;--border:rgba(106,178,255,.25);
  --glow:rgba(50,144,255,.22);
  color:#f0f8ff;background:rgba(10,29,57,.83);
  border-color:rgba(102,184,255,.35);
  box-shadow:0 25px 90px rgba(0,50,160,.17),0 0 40px rgba(35,135,255,.12)
}
.album-banner{
  position:relative;isolation:isolate;overflow:hidden;min-height:310px;
  padding:clamp(30px,6vw,62px);display:flex;flex-direction:column;justify-content:center;
  color:#f0f8ff;
  background:radial-gradient(ellipse at 82% 10%,rgba(89,209,255,.36),transparent 33%),radial-gradient(ellipse at 5% 100%,rgba(109,81,255,.36),transparent 40%),linear-gradient(125deg,#07142e,#0b3672 47%,#086fbd);
  border-bottom:1px solid rgba(106,178,255,.23)
}
.album-banner::before{
  content:"";position:absolute;inset:-60%;z-index:-1;
  background:conic-gradient(from 0deg,transparent 0 30%,rgba(88,191,255,.18) 42%,transparent 55% 100%);
  animation:rotateGlow 24s linear infinite
}
.album-banner::after{
  content:"♪";position:absolute;right:5%;bottom:-125px;color:rgba(255,255,255,.075);
  font-size:clamp(240px,35vw,400px);line-height:1;font-weight:950;pointer-events:none
}
.album-kicker{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;border:1px solid rgba(142,217,255,.28);background:rgba(83,171,255,.1);border-radius:999px;padding:8px 12px;margin-bottom:22px;color:#c9edff;font-size:9px;font-weight:900;letter-spacing:2px;backdrop-filter:blur(12px)}
.album-banner .eyebrow{color:#8fe6ff}
.album-banner h2{position:relative;z-index:1;margin:0;max-width:850px;font-size:clamp(45px,9vw,91px);font-weight:1000;letter-spacing:-.075em;line-height:.89;color:transparent;background:linear-gradient(100deg,#fff,#bdeaff 42%,#75c5ff 75%,#b8a5ff);background-clip:text;-webkit-background-clip:text;filter:drop-shadow(0 4px 35px rgba(75,168,255,.2))}
.album-banner p{position:relative;z-index:1;max-width:510px;margin:22px 0 0;color:#c2dcfa;font-size:13px;line-height:1.9}
.album-section .section-body{color:#f0f8ff;background:radial-gradient(ellipse at 100% 0%,rgba(28,104,211,.13),transparent 42%),linear-gradient(180deg,rgba(8,22,44,.25),rgba(5,15,33,.35))}
.album-title-row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.album-title{font-size:10px;font-weight:950;letter-spacing:2.3px;color:#8edaff}
.album-list{display:grid;gap:10px}
.album-track{
  position:relative;overflow:hidden;display:grid;grid-template-columns:46px minmax(0,1fr) auto;align-items:center;gap:15px;padding:16px 17px;
  border:1px solid rgba(119,184,255,.19);border-radius:15px;
  background:linear-gradient(115deg,rgba(30,75,128,.34),rgba(16,37,69,.42));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.035);
  transition:transform .35s,border-color .3s,box-shadow .3s,background .3s;
  animation:trackEnter .55s cubic-bezier(.2,.7,.2,1) both
}
.album-track::before{content:"";position:absolute;inset:0 auto 0 0;width:2px;background:linear-gradient(180deg,transparent,#61baff,#9d94ff,transparent)}
.album-track:hover{transform:translateY(-4px) scale(1.008);border-color:rgba(112,196,255,.6);background:linear-gradient(115deg,rgba(37,98,163,.48),rgba(20,48,88,.6));box-shadow:0 12px 35px rgba(0,82,190,.2),0 0 22px rgba(60,155,255,.08)}
.album-number{display:grid;place-items:center;width:39px;height:39px;border-radius:12px;background:linear-gradient(145deg,rgba(87,172,255,.2),rgba(126,105,255,.14));border:1px solid rgba(127,192,255,.23);color:#a5ddff;font-size:12px;font-weight:950;transition:.3s}
.album-track:hover .album-number{transform:rotate(-4deg) scale(1.07);box-shadow:0 0 20px rgba(80,170,255,.18)}
.album-song{overflow-wrap:anywhere;color:#f3f8ff;font-size:14px;font-weight:850}
.album-subtitle{margin-top:6px;color:#a6c4e7;font-size:10px;line-height:1.5}
.album-actions{display:flex;gap:7px;align-items:center}
.album-actions button{border:1px solid rgba(120,193,255,.25);border-radius:9px;padding:8px 10px;background:rgba(70,149,235,.1);color:#bde5ff;font-size:10px;font-weight:850;transition:.25s}
.album-actions button:hover{background:rgba(83,168,255,.25);border-color:#7bc6ff;transform:translateY(-2px);box-shadow:0 0 18px rgba(83,168,255,.12)}
.album-footer{margin-top:19px;color:#87a9ce;font-size:10px;line-height:1.8}
@keyframes rotateGlow{to{transform:rotate(360deg)}}
@keyframes trackEnter{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes neonSweep{0%{background-position:180% 0}100%{background-position:-180% 0}}

/* REVEALS AND MODALS */
.reveal{opacity:0;transform:translateY(24px) scale(.99);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}
.reveal.is-visible{opacity:1;transform:translateY(0) scale(1)}
.modal-backdrop{display:none;position:fixed;inset:0;z-index:100;overflow-y:auto;padding:18px;align-items:center;justify-content:center;background:rgba(2,5,14,.77);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px)}
.modal-backdrop.open{display:flex;animation:backdropIn .22s ease both}
.modal{position:relative;width:min(530px,100%);max-height:calc(100vh - 36px);overflow-y:auto;padding:26px;border-radius:22px;border:1px solid var(--border);background:radial-gradient(ellipse at 0 0,rgba(255,111,35,.1),transparent 48%),linear-gradient(145deg,#25171b,#17121c);color:var(--text);box-shadow:0 30px 110px rgba(0,0,0,.55),0 0 45px var(--glow);animation:modalEnter .3s cubic-bezier(.2,.7,.2,1) both}
.modal h2{margin:0 0 9px;font-size:22px;font-weight:950;letter-spacing:-.7px}
.modal-desc{margin:0 0 23px;color:var(--muted);font-size:12px;line-height:1.8}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-field{display:flex;flex-direction:column;gap:8px;min-width:0}
.form-field.full{grid-column:1/-1}
.form-field label{color:var(--muted);font-size:9px;font-weight:950;text-transform:uppercase;letter-spacing:1.3px}
.form-field input,.form-field select,.form-field textarea{width:100%;border:1px solid var(--border);border-radius:11px;padding:12px;background:rgba(0,0,0,.25);color:var(--text);transition:border-color .2s,box-shadow .2s}
.form-field input:hover,.form-field select:hover,.form-field textarea:hover{border-color:var(--accent)}
.form-field textarea{min-height:85px;resize:vertical}
.form-field select option{background:#201821;color:white}
.modal-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:9px;margin-top:22px}
.primary-btn,.secondary-btn,.danger-btn{border-radius:10px;padding:11px 14px;font-size:10px;font-weight:950;letter-spacing:.5px;transition:transform .2s,filter .2s,box-shadow .2s}
.primary-btn{border:1px solid transparent;color:#100d15;background:linear-gradient(110deg,var(--accent),var(--accent2));box-shadow:0 5px 18px var(--glow)}
.secondary-btn{border:1px solid var(--border);color:var(--text);background:rgba(255,255,255,.045)}
.danger-btn{border:1px solid rgba(255,111,135,.4);color:#ff91a4;background:rgba(255,65,101,.07)}
.primary-btn:hover,.secondary-btn:hover,.danger-btn:hover{transform:translateY(-2px);filter:brightness(1.1)}
#adminModal .eyebrow,#trackModal .eyebrow,#loginModal .eyebrow{color:#ffb17a}
#adminModal .modal h2{background:linear-gradient(100deg,#fff6ef,#ffb77e 75%,#ff83a9);color:transparent;background-clip:text;-webkit-background-clip:text}
.admin-tools{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:13px;margin-bottom:22px;border:1px solid rgba(255,139,79,.17);border-radius:15px;background:rgba(255,126,55,.045)}
.admin-tools .primary-btn{min-height:47px;line-height:1.5}
#addBeforeButton{background:linear-gradient(115deg,#ff762e,#ffc27c)}
#addAlbumButton{color:#061326;background:linear-gradient(115deg,#6ab7ff,#a3f0ff);box-shadow:0 4px 18px rgba(65,155,255,.16)}
#adminTrackPicker{min-height:46px;background-color:#17121a}
#adminTrackPicker option{background:#17121a;color:#fff4ed}
.toast{position:fixed;z-index:200;bottom:22px;left:50%;width:max-content;max-width:calc(100% - 30px);padding:13px 18px;color:var(--text);background:rgba(27,25,40,.95);border:1px solid var(--border);border-radius:13px;font-size:12px;text-align:center;backdrop-filter:blur(20px);box-shadow:0 10px 40px rgba(0,0,0,.3),0 0 25px var(--glow);opacity:0;pointer-events:none;transform:translate(-50%,15px);transition:opacity .25s,transform .25s}
.toast.show{opacity:1;transform:translate(-50%,0)}
.context-menu{display:none;position:fixed;z-index:150;min-width:170px;padding:6px;border:1px solid var(--border);border-radius:12px;background:rgba(30,25,38,.97);backdrop-filter:blur(20px);box-shadow:0 15px 45px rgba(0,0,0,.45);animation:modalEnter .16s ease both}
.context-menu.open{display:block}
.context-menu button{display:block;width:100%;text-align:left;padding:10px 12px;color:var(--text);background:transparent;border:0;border-radius:7px;font-size:11px;transition:.2s}
.context-menu button:hover{padding-left:16px;background:var(--glow)}
footer{padding:28px 10px 0;text-align:center;color:var(--muted);font-size:9px;line-height:2;letter-spacing:2px}
@keyframes intro{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes modalEnter{from{opacity:0;transform:translateY(12px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes backdropIn{from{opacity:0}to{opacity:1}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.55}}
@media(max-width:620px){
  .container{width:calc(100% - 22px);padding-top:14px}
  .topbar{margin-bottom:38px}.logo{font-size:9px;letter-spacing:1.4px}
  .admin-button{padding:10px 12px}.hero{padding-top:22px}
  .section{border-radius:18px}.section-header,.section-body{padding:17px}
  .album-banner{min-height:280px;padding:28px 20px}
  .album-track{grid-template-columns:38px minmax(0,1fr);gap:11px;padding:13px 11px}
  .album-number{width:34px;height:34px}.album-actions{grid-column:2}
  .form-grid,.admin-tools{grid-template-columns:1fr}
  .form-field.full{grid-column:auto}.modal{padding:21px}
  #sortSelect{flex:1 1 100%}.filter-btn{padding:10px 12px;font-size:9px}
}
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  .reveal{opacity:1;transform:none}
}


/* Archive filter enhancements — uses the existing theme variables and colors. */
.filter-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:-4px 0 19px}
.filter-label{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:9px;font-weight:950;letter-spacing:1.5px}
#yearFilter{min-width:135px;padding:10px 12px;font-size:10px;font-weight:850;cursor:pointer;background-color:#211512;color:#ffca9d}
#yearFilter option{background:#211512;color:#fff1e8}
.filter-count{display:inline-flex;align-items:center;justify-content:center;min-width:19px;height:19px;margin-left:5px;padding:0 5px;border-radius:999px;background:rgba(255,255,255,.10);font-size:9px;letter-spacing:0}
.filter-btn.active .filter-count{background:rgba(0,0,0,.20)}
.filter-status{flex:1;min-width:150px;color:var(--muted);font-size:10px;line-height:1.6}
.filter-reset{border:1px solid var(--border);border-radius:11px;padding:10px 13px;background:rgba(255,255,255,.035);color:var(--accent2);font-size:9px;font-weight:950;letter-spacing:.8px;transition:transform .25s,border-color .25s,box-shadow .25s}
.filter-reset:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 0 18px var(--glow)}
.track-description{margin-top:6px;color:var(--text);font-size:12px;line-height:1.65;overflow-wrap:anywhere}
.track-details-text{margin-top:5px;color:var(--muted);font-size:10px;line-height:1.6;overflow-wrap:anywhere}
.album-description{margin-top:8px;max-width:620px;color:var(--text);font-size:12px;line-height:1.75;overflow-wrap:anywhere}
.album-details{margin-top:5px;color:var(--muted);font-size:10px;line-height:1.65;overflow-wrap:anywhere}
@media(max-width:640px){
  .filter-tools{align-items:stretch}
  .filter-label{flex:1;justify-content:space-between}
  #yearFilter{flex:1;min-width:0}
  .filter-status{flex-basis:100%;order:3}
  .filter-reset{margin-left:auto}
}


/* Fixed bottom mini-player; uses the existing theme variables */
body { padding-bottom: 112px; }
.mini-player {
  position: fixed; z-index: 100; left: 50%; bottom: 12px;
  transform: translateX(-50%); width: min(1040px, calc(100% - 24px));
  display: none; grid-template-columns: minmax(130px,1fr) auto minmax(140px,1.2fr) auto;
  align-items: center; gap: 13px; padding: 12px 14px;
  color: var(--text); background: var(--solid);
  border: 1px solid var(--border); border-radius: 18px;
  box-shadow: 0 16px 50px rgba(0,0,0,.42), 0 0 24px var(--glow);
  backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
}
.mini-player.visible { display: grid; animation: miniPlayerIn .28s ease both; }
@keyframes miniPlayerIn {
  from { opacity: 0; transform: translate(-50%, 12px); }
  to { opacity: 1; transform: translate(-50%, 0); }
}
.mini-track-info { display:flex; align-items:center; gap:10px; min-width:0; }
.mini-art {
  flex:0 0 42px; width:42px; height:42px; display:grid; place-items:center;
  border:1px solid var(--border); border-radius:12px;
  background:var(--panel); color:var(--accent2); font-size:20px;
}
.mini-track-copy { min-width:0; }
.mini-track-name {
  color:var(--text); font-size:12px; font-weight:800;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.mini-track-status {
  margin-top:4px; color:var(--muted); font-size:9px;
  letter-spacing:1px; text-transform:uppercase;
}
.mini-controls,.mini-extra { display:flex; align-items:center; gap:5px; }
.mini-control {
  width:33px; height:33px; padding:0; display:grid; place-items:center;
  color:var(--text); background:var(--panel); border:1px solid var(--border);
  border-radius:10px; font-size:13px; cursor:pointer; transition:transform .18s, background .18s;
}
.mini-control:hover { transform:translateY(-1px); background:var(--glow); }
.mini-control.primary {
  width:40px; height:40px; color:var(--bg);
  background:linear-gradient(120deg,var(--accent),var(--accent2)); border-color:transparent;
  font-size:15px;
}
.mini-control.active { color:var(--accent2); border-color:var(--accent); background:var(--glow); }
.mini-progress { min-width:0; display:grid; grid-template-columns:auto minmax(36px,1fr) auto; align-items:center; gap:8px; }
.mini-time { color:var(--muted); font-size:9px; font-variant-numeric:tabular-nums; white-space:nowrap; }
.mini-seek {
  width:100%; min-width:36px; height:5px; margin:0; appearance:none;
  border-radius:999px; cursor:pointer;
  background:linear-gradient(90deg,var(--accent) 0%,var(--accent) var(--progress,0%),rgba(255,255,255,.17) var(--progress,0%),rgba(255,255,255,.17) 100%);
}
.mini-seek::-webkit-slider-thumb { appearance:none; width:11px; height:11px; border-radius:50%; background:var(--accent2); }
.mini-seek::-moz-range-thumb { width:11px; height:11px; border:0; border-radius:50%; background:var(--accent2); }
.mini-volume { width:64px; accent-color:var(--accent); }
.mini-player-frame { position:fixed; left:-10000px; top:0; width:1px; height:1px; border:0; }
.mini-player-error { display:none; grid-column:1/-1; color:#ffb0a1; font-size:10px; line-height:1.45; }
@media (max-width:760px) {
  body { padding-bottom:148px; }
  .mini-player.visible { grid-template-columns:minmax(0,1fr) auto; gap:9px; padding:10px; }
  .mini-track-info { grid-column:1; grid-row:1; }
  .mini-controls { grid-column:2; grid-row:1; }
  .mini-progress { grid-column:1/-1; grid-row:2; }
  .mini-extra { grid-column:1/-1; grid-row:3; justify-content:space-between; }
  .mini-art { flex-basis:36px; width:36px; height:36px; }
  .mini-volume { width:75px; }
}
@media (max-width:390px) {
  .mini-control { width:30px; height:30px; }
  .mini-control.primary { width:36px; height:36px; }
  .mini-controls,.mini-extra { gap:4px; }
}


/* Lyrics panel for the bottom player */
.lyrics-textarea{width:100%;min-height:230px;resize:vertical;white-space:pre-wrap;line-height:1.8}
.lyrics-help{font-size:10px;color:var(--muted);line-height:1.6;margin:0 0 12px}
.lyrics-toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.lyrics-hidden-note{display:none;padding:22px 14px;text-align:center;color:var(--muted);font-size:12px;border:1px dashed var(--border);border-radius:12px}

.lyrics-hidden-note.visible{display:block}
/* Elegant synced lyrics view; follows the site's active accent theme. */
#lyricsModal .modal{width:min(760px,100%);padding:clamp(18px,4vw,34px)}
#lyricsModal .modal-desc{margin-bottom:12px}
.lyrics-stage{
  position:relative;isolation:isolate;overflow:hidden;min-height:310px;max-height:min(56vh,560px);
  padding:clamp(18px,4vw,34px) clamp(14px,4vw,30px);
  border:1px solid var(--border);border-radius:20px;
  background:radial-gradient(ellipse at 50% 0%,var(--glow),transparent 58%),linear-gradient(160deg,rgba(255,255,255,.035),rgba(0,0,0,.16));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.045);
  overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:var(--border) transparent;
  mask-image:linear-gradient(to bottom,transparent 0,#000 8%,#000 92%,transparent 100%);
}
.lyrics-stage:empty{display:none}
.lyrics-line{
  display:block;width:100%;padding:9px 0;border:0;background:transparent;text-align:left;
  color:var(--muted);font-size:clamp(18px,3.3vw,27px);font-weight:800;line-height:1.42;
  letter-spacing:-.035em;overflow-wrap:anywhere;opacity:.43;
  transform-origin:left center;transition:opacity .28s ease,color .28s ease,transform .28s ease,text-shadow .28s ease;
}
.lyrics-line.is-near{opacity:.72}
.lyrics-line.is-active{
  color:var(--text);opacity:1;transform:scale(1.015);
  text-shadow:0 0 26px var(--glow);
}
.lyrics-line.is-active .lyric-word{color:var(--text)}
.lyric-word{display:inline;color:inherit;transition:color .18s ease,text-shadow .18s ease,filter .18s ease;}
.lyric-word.is-sung{color:var(--accent2);text-shadow:0 0 13px var(--glow)}
.lyric-word.is-current{color:var(--accent2)!important;text-shadow:0 0 19px var(--glow),0 0 2px currentColor;filter:brightness(1.16);animation:lyricWordPulse .34s ease-out both;}
@keyframes lyricWordPulse{from{filter:brightness(1.45);text-shadow:0 0 24px var(--glow)}to{filter:brightness(1.16);text-shadow:0 0 19px var(--glow),0 0 2px currentColor}}
.lyrics-line.is-active .lyric-word.is-sung{color:var(--accent2)}
.lyrics-stage.plain-lyrics{mask-image:none;white-space:pre-wrap}
.lyrics-stage.plain-lyrics .lyrics-line{opacity:1;transform:none;font-size:clamp(15px,2.5vw,19px);font-weight:550;letter-spacing:0;line-height:1.9;color:var(--text);padding:2px 0}
.lyrics-stage .lyrics-empty{min-height:240px;display:grid;place-items:center;text-align:center;color:var(--muted);font-size:13px;line-height:1.8}
.lyrics-mode-chip{
  display:inline-flex;align-items:center;gap:7px;margin:0 0 10px;padding:7px 10px;
  border:1px solid var(--border);border-radius:999px;background:var(--glow);
  color:var(--accent2);font-size:9px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase;
}
.lyrics-mode-dot{width:6px;height:6px;border-radius:50%;background:var(--accent2);box-shadow:0 0 10px var(--glow)}
.lyrics-editor-hint{margin-top:8px;color:var(--muted);font-size:10px;line-height:1.7}
body.reduce-motion .lyrics-line,body.reduce-motion .lyric-word{transition:none!important;animation:none!important;filter:none!important;text-shadow:none!important}
body.reduce-motion .lyric-word.is-current{color:var(--accent2)!important}
@media(max-width:620px){
  #lyricsModal .modal{padding:17px}
  .lyrics-stage{min-height:280px;max-height:55vh;border-radius:16px}
  .lyrics-line{padding:8px 0}
}


/* Updates and compact icon-only track controls */
[hidden]{display:none!important}
.icon-play-btn{display:inline-grid;place-items:center;width:31px;height:31px;padding:0;border:1px solid var(--border);border-radius:10px;background:var(--glow);color:var(--accent2);font-size:13px;font-weight:900;vertical-align:middle;transition:transform .2s,background .2s}
.icon-play-btn:hover{transform:scale(1.07);background:var(--accent)}
.track-name-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.track-category-emoji{font-size:12px;line-height:1}
.updates-list{display:grid;gap:12px;max-height:48vh;overflow:auto}
.update-card{border:1px solid var(--border);border-radius:14px;padding:15px;background:rgba(255,255,255,.025)}
.update-card h3{margin:0;color:var(--text);font-size:14px}
.update-date{margin-top:5px;color:var(--accent2);font-size:9px;font-weight:900;letter-spacing:1px}
.update-body{margin-top:10px;color:var(--muted);font-size:12px;line-height:1.8;white-space:pre-wrap;overflow-wrap:anywhere}
.update-admin-tools{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 16px}
.update-editor{display:grid;gap:12px;margin-bottom:18px;padding:14px;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.025)}
.update-editor textarea{min-height:100px}
.updates-button{border:1px solid var(--border);color:var(--text);background:rgba(255,255,255,.035);padding:11px 14px;border-radius:999px;font-size:11px;font-weight:900;letter-spacing:.7px;backdrop-filter:blur(18px);transition:.3s}
.updates-button:hover{transform:translateY(-3px);border-color:var(--accent);box-shadow:0 0 24px var(--glow)}
@media(max-width:620px){.topbar-actions{gap:6px}.settings-button,.updates-button{padding:10px 11px;font-size:10px}.track-name-line{gap:6px}}

/* Lyrics button */
.mini-control.lyrics-cta{width:auto;padding:0 13px;font-size:10px;font-weight:950;letter-spacing:1.2px;color:#100d15;background:linear-gradient(120deg,var(--accent),var(--accent2));border-color:transparent;box-shadow:0 0 18px var(--glow);animation:lyricsPulse 2.6s ease-in-out infinite}
.mini-control.lyrics-cta:hover{filter:brightness(1.12);transform:translateY(-2px) scale(1.04)}
@keyframes lyricsPulse{50%{box-shadow:0 0 30px var(--accent)}}

/* Admin console */
.admin-console{width:min(580px,100%);background:radial-gradient(ellipse at 100% 0,var(--glow),transparent 50%),radial-gradient(ellipse at 0 0,rgba(255,111,35,.1),transparent 48%),linear-gradient(145deg,#25171b,#17121c)}
.admin-console::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;border-radius:22px 22px 0 0;background:linear-gradient(90deg,var(--accent),var(--accent2),#f77eb9,var(--accent));background-size:200% 100%;animation:neonSweep 6s linear infinite}
.admin-topline{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}
.admin-topline .eyebrow{margin:0}
.admin-live{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid var(--border);border-radius:999px;background:var(--glow);color:var(--accent2);font-size:8px;font-weight:950;letter-spacing:1.3px}
.admin-live i{width:6px;height:6px;border-radius:50%;background:#7bffb0;box-shadow:0 0 10px #7bffb0;animation:pulse 2s infinite}
.admin-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:20px}
.admin-stat{padding:13px 8px;text-align:center;border:1px solid var(--border);border-radius:14px;background:rgba(255,255,255,.035);transition:transform .25s,box-shadow .25s}
.admin-stat:hover{transform:translateY(-3px);box-shadow:0 0 20px var(--glow)}
.admin-stat b{display:block;font-size:22px;font-weight:1000;letter-spacing:-1px;color:var(--text)}
.admin-stat span{display:block;margin-top:4px;font-size:7.5px;font-weight:900;letter-spacing:1.3px;color:var(--muted)}
.admin-label{margin:18px 0 9px;color:var(--accent2);font-size:8.5px;font-weight:950;letter-spacing:2.2px}
.admin-label::after{content:"";display:inline-block;vertical-align:middle;width:40%;height:1px;margin-left:10px;background:linear-gradient(90deg,var(--border),transparent)}
.admin-console .admin-tools{margin-bottom:0}
.admin-actions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
.admin-actions.three{grid-template-columns:repeat(3,1fr);margin-top:0}
.admin-chip{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 6px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.035);color:var(--text);font-size:9px;font-weight:950;letter-spacing:.8px;transition:transform .2s,border-color .2s,box-shadow .2s,background .2s}
.admin-chip span{font-size:17px;color:var(--accent2)}
.admin-chip:hover{transform:translateY(-3px);border-color:var(--accent);background:var(--glow);box-shadow:0 0 22px var(--glow)}
.admin-chip.danger{color:#ff91a4;border-color:rgba(255,111,135,.35)}
.admin-chip.danger span{color:#ff91a4}
.admin-chip.danger:hover{background:rgba(255,65,101,.12);box-shadow:0 0 22px rgba(255,65,101,.2);border-color:#ff6f87}
@media(max-width:520px){.admin-stats,.admin-actions{grid-template-columns:repeat(2,1fr)}.admin-actions.three{grid-template-columns:1fr 1fr 1fr}}

/* Extra settings */
body.no-effects .ambient,body.no-effects .section::before,body.no-effects .album-banner::before{display:none}
body.hide-year th:nth-child(2),body.hide-year td:nth-child(2),
body.hide-length th:nth-child(3),body.hide-length td:nth-child(3){display:none}
body.lyrics-small .lyrics-line{font-size:clamp(14px,2.4vw,19px)!important}
body.lyrics-large .lyrics-line{font-size:clamp(23px,4.2vw,36px)!important}

/* Beautiful lyrics view */
#lyricsModal{background:radial-gradient(ellipse at 50% 0%,var(--glow),transparent 60%),rgba(2,5,14,.88);backdrop-filter:blur(26px) saturate(1.2);-webkit-backdrop-filter:blur(26px) saturate(1.2)}
#lyricsModal .modal{width:min(860px,100%);max-height:calc(100vh - 28px);padding:clamp(20px,4vw,40px);border-radius:28px;overflow-x:hidden;background:linear-gradient(160deg,rgba(37,23,27,.94),rgba(18,14,24,.96));box-shadow:0 40px 140px rgba(0,0,0,.65),0 0 80px var(--glow)}
#lyricsModal .modal::before,#lyricsModal .modal::after{content:"";position:absolute;z-index:0;border-radius:50%;filter:blur(80px);opacity:.38;pointer-events:none;animation:floatOrb 14s ease-in-out infinite alternate}
#lyricsModal .modal::before{width:300px;height:300px;top:-90px;left:-90px;background:var(--accent)}
#lyricsModal .modal::after{width:340px;height:340px;bottom:-130px;right:-110px;background:var(--accent2);animation-delay:-6s}
#lyricsModal .modal>*{position:relative;z-index:1}
.lyrics-topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
.lyrics-topline .eyebrow{margin:0}
.lyrics-eq{display:flex;align-items:flex-end;gap:3px;height:18px}
.lyrics-eq i{width:3px;height:100%;border-radius:3px;background:linear-gradient(var(--accent2),var(--accent));transform:scaleY(.2);transform-origin:bottom;transition:transform .3s}
body.is-playing .lyrics-eq i{animation:lyricsEq .9s ease-in-out infinite alternate}
.lyrics-eq i:nth-child(2){animation-delay:-.3s!important}.lyrics-eq i:nth-child(3){animation-delay:-.6s!important}
.lyrics-eq i:nth-child(4){animation-delay:-.15s!important}.lyrics-eq i:nth-child(5){animation-delay:-.45s!important}
@keyframes lyricsEq{from{transform:scaleY(.2)}to{transform:scaleY(1)}}
#lyricsModal h2{margin:0 0 6px;font-size:clamp(26px,5.2vw,42px);font-weight:1000;letter-spacing:-.055em;line-height:1.05;color:transparent;background:linear-gradient(100deg,var(--text) 20%,var(--accent2) 75%,var(--accent));-webkit-background-clip:text;background-clip:text}
#lyricsModal .modal-desc{margin-bottom:10px;font-size:11px;letter-spacing:.3px}
#lyricsModal .lyrics-help{opacity:.7}
.lyrics-mode-chip{background:linear-gradient(110deg,var(--glow),transparent);box-shadow:0 0 22px var(--glow)}
.lyrics-progress{height:3px;margin:2px 0 14px;border-radius:999px;background:rgba(255,255,255,.1);overflow:hidden}
.lyrics-progress span{display:block;height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--accent2));box-shadow:0 0 14px var(--accent);transition:width .25s linear}
#lyricsModal .lyrics-stage{min-height:340px;max-height:min(58vh,600px);padding:90px clamp(6px,2vw,18px);border:0;border-radius:0;background:transparent;box-shadow:none;scrollbar-width:none;scroll-behavior:smooth;mask-image:linear-gradient(to bottom,transparent 0,#000 18%,#000 82%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 18%,#000 82%,transparent 100%)}
#lyricsModal .lyrics-stage::-webkit-scrollbar{display:none}
#lyricsModal .lyrics-line{padding:11px 0;font-size:clamp(24px,4.8vw,42px);font-weight:900;letter-spacing:-.05em;line-height:1.22;opacity:.3;filter:blur(1.8px);transform-origin:left center;transition:opacity .4s ease,filter .4s ease,transform .45s cubic-bezier(.2,.7,.2,1),color .3s ease,text-shadow .3s ease}
#lyricsModal .lyrics-line.is-near{opacity:.58;filter:blur(.7px)}
#lyricsModal .lyrics-line.is-active{opacity:1;filter:none;transform:scale(1.045);text-shadow:0 0 40px var(--glow),0 0 90px var(--glow)}
#lyricsModal .lyrics-line:hover{opacity:.9;filter:none}
#lyricsModal .lyric-word.is-sung{text-shadow:0 0 22px var(--glow)}
#lyricsModal .lyrics-stage.plain-lyrics{padding:30px clamp(6px,2vw,18px);text-align:center;mask-image:linear-gradient(to bottom,transparent 0,#000 5%,#000 95%,transparent 100%);-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 5%,#000 95%,transparent 100%)}
#lyricsModal .lyrics-stage.plain-lyrics .lyrics-line{opacity:.95;filter:none;transform:none;text-align:center;padding:1px 0;font-size:clamp(17px,2.9vw,23px);font-weight:700;letter-spacing:-.015em;line-height:1.95;text-shadow:none}
#lyricsModal .lyrics-stage .lyrics-empty{font-size:15px;opacity:.75}
body.reduce-motion #lyricsModal .modal::before,body.reduce-motion #lyricsModal .modal::after,body.reduce-motion .lyrics-eq i{animation:none!important}
body.reduce-motion #lyricsModal .lyrics-line{filter:none!important}
@media(max-width:620px){#lyricsModal .modal{border-radius:22px}#lyricsModal .lyrics-stage{padding:60px 4px;min-height:300px}#lyricsModal .lyrics-line{font-size:clamp(22px,7vw,30px)}}

</style>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Outfit:wght@300;400;500;700&display=swap" rel="stylesheet">
<style id="theme-v10">
@property --a{syntax:"<angle>";inherits:false;initial-value:0deg}
:root{--bg:#06050a;--solid:#0f0d16;--text:#fbf7ff;--muted:#a69fb8;--pink:#ff5fb0;--cyan:#5ff0ff;--ease:cubic-bezier(.2,.8,.2,1);--spring:cubic-bezier(.34,1.56,.64,1);
--font-d:"Unbounded","Sora",system-ui,sans-serif;--font-u:"Outfit",ui-sans-serif,system-ui,sans-serif}
body{--accent:#ff7a3d;--accent2:#ffd36e;--panel:rgba(14,12,22,.82);--border:rgba(255,255,255,.1);--glow:rgba(255,122,61,.25)}
body.theme-purple{--accent:#b07cff;--accent2:#5ff0ff;--glow:rgba(176,124,255,.28)}
body.theme-green{--accent:#3dffa8;--accent2:#d6ff6e;--glow:rgba(61,255,168,.24)}
body.album-past{--accent:#4f9dff;--accent2:#5ff0ff;--panel:rgba(8,16,36,.82);--glow:rgba(79,157,255,.28)}
body{font-family:var(--font-u);font-size:15px;background:var(--bg);-webkit-font-smoothing:antialiased}
h1,.section-header h2,.album-banner h2,.modal h2,.track-name,.album-song,.logo{font-family:var(--font-d)}
body::before{content:"";position:fixed;inset:0;z-index:-2;pointer-events:none;
background:radial-gradient(circle at 18% 12%,color-mix(in srgb,var(--accent) 34%,transparent),transparent 38%),radial-gradient(circle at 85% 28%,color-mix(in srgb,var(--pink) 26%,transparent),transparent 36%),radial-gradient(circle at 55% 95%,color-mix(in srgb,var(--cyan) 20%,transparent),transparent 40%);
animation:drift 22s ease-in-out infinite alternate;transition:background 1s}
@keyframes drift{to{transform:scale(1.18) rotate(4deg) translate(2%,-2%)}}
body::after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.5;
background-image:radial-gradient(rgba(255,255,255,.14) 1px,transparent 1.4px);background-size:26px 26px;mask-image:radial-gradient(ellipse at 50% 30%,#000,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at 50% 30%,#000,transparent 70%)}
.ambient{display:none}
/* HERO */
.hero{position:relative}
.hero>*:not(.vinyl){position:relative;z-index:1}
.logo{font-size:10px;letter-spacing:3px}
h1{font-weight:900;font-size:clamp(46px,11vw,128px);letter-spacing:-.07em;line-height:.88;text-transform:uppercase}
h1{-webkit-text-stroke:1.5px rgba(255,255,255,.85);color:transparent}
.hero-gradient{-webkit-text-stroke:0;background:conic-gradient(from var(--a) at 50% 50%,var(--accent),var(--pink),var(--cyan),var(--accent2),var(--accent));-webkit-background-clip:text;background-clip:text;animation:spin 7s linear infinite;filter:drop-shadow(0 0 40px color-mix(in srgb,var(--pink) 45%,transparent))}
@keyframes spin{to{--a:360deg}}
.subtitle{font-size:16px;color:var(--muted);max-width:520px}
.vinyl{position:absolute;z-index:0;right:-30px;top:60px;width:min(400px,52vw);aspect-ratio:1;border-radius:50%;
background:conic-gradient(from 20deg,transparent 0,rgba(255,255,255,.2) 8%,transparent 20%,transparent 50%,rgba(255,255,255,.16) 58%,transparent 70%),repeating-radial-gradient(circle,#0a0910 0 2px,#1a1724 3px 4px);
box-shadow:0 0 0 2px rgba(255,255,255,.08),0 30px 100px rgba(0,0,0,.6),0 0 90px var(--glow);animation:rot 7s linear infinite;animation-play-state:paused;opacity:.9}
.vinyl::before{content:"";position:absolute;inset:34%;border-radius:50%;background:conic-gradient(from 0deg,var(--accent),var(--pink),var(--cyan),var(--accent2),var(--accent));box-shadow:0 0 30px var(--glow)}
.vinyl::after{content:"";position:absolute;inset:48%;border-radius:50%;background:var(--bg)}
body.is-playing .vinyl{animation-play-state:running}
@keyframes rot{to{transform:rotate(360deg)}}
@media(max-width:700px){.vinyl{opacity:.35;right:-90px;top:90px}}
.hero-bottom{margin-top:30px}
.status-chip,.admin-button,.settings-button,.updates-button{border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(14px);transition:transform .35s var(--spring),border-color .3s,box-shadow .3s}
.admin-button{background:linear-gradient(120deg,var(--accent),var(--pink));color:#12060a;border:0;font-weight:900}
.admin-button:hover,.settings-button:hover,.updates-button:hover{transform:translateY(-3px) rotate(-1deg)}
/* TICKER */
.ticker{overflow:hidden;margin:34px -50vw 0;padding:14px 0;border-block:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);position:relative;left:50%;right:50%;width:100vw;transform:rotate(-1.2deg)}
.ticker div{display:flex;width:max-content;animation:tick 28s linear infinite}
.ticker span{font-family:var(--font-d);font-size:13px;font-weight:700;letter-spacing:4px;white-space:nowrap;padding-right:30px;color:var(--text)}
.ticker span i{font-style:normal;color:var(--accent);margin:0 18px}
@keyframes tick{to{transform:translateX(-50%)}}
/* PANELS */
.section{margin-top:46px;border:0;border-radius:30px;background:linear-gradient(180deg,rgba(255,255,255,.05),transparent 30%),var(--panel);box-shadow:0 40px 120px rgba(0,0,0,.6),0 0 80px color-mix(in srgb,var(--accent) 10%,transparent)}
.section::after{content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;pointer-events:none;z-index:3;
background:conic-gradient(from var(--a),transparent 0 55%,var(--accent) 75%,var(--pink) 88%,var(--cyan) 96%,transparent);animation:spin 9s linear infinite;
-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0)}
.section::before{background:radial-gradient(500px circle at var(--mx,50%) var(--my,0),color-mix(in srgb,var(--accent) 14%,transparent),transparent 60%);animation:none}
.before-section{background:linear-gradient(180deg,rgba(255,255,255,.05),transparent 30%),var(--panel);box-shadow:0 40px 120px rgba(0,0,0,.6)}
.section-header{padding:32px 34px;background:none;border-bottom:1px solid rgba(255,255,255,.08)}
.section-header h2{font-size:clamp(18px,3vw,26px);font-weight:800;letter-spacing:-.02em}
.section-body{padding:30px 34px}
.eyebrow{font-family:var(--font-d);font-size:9px;letter-spacing:3px;color:var(--accent)}
.pill{background:var(--accent);color:#10060a;border:0;font-weight:900;box-shadow:0 0 22px var(--glow)}
.before-section .eyebrow,.before-section .pill{color:#10060a}.before-section .eyebrow{color:var(--accent)}
/* CONTROLS */
.field,.form-field input,.form-field select,.form-field textarea{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:16px}
#sortSelect,#yearFilter{background-color:#14111d;color:var(--text)}
.toolbar .search{padding:16px 20px;font-size:14px}
.filter-btn{border-radius:999px;padding:12px 18px;background:rgba(255,255,255,.05);color:var(--text);transition:transform .4s var(--spring),box-shadow .3s}
.filter-btn:hover{transform:translateY(-3px) scale(1.05)}
.filter-btn.active{color:#10060a;background:linear-gradient(110deg,var(--accent),var(--pink),var(--accent2));background-size:200% 100%;animation:sheen 4s linear infinite;box-shadow:0 10px 34px var(--glow)}
@keyframes sheen{to{background-position:200% 0}}
/* TRACKLIST */
.table-wrap{border:0;background:none;overflow-x:auto}
table{border-collapse:separate;border-spacing:0 10px;min-width:660px}
th{background:none!important;border:0;color:var(--muted);letter-spacing:3px;font-size:9px}
tbody{counter-reset:t}tbody tr{counter-increment:t;background:rgba(255,255,255,.04);transition:transform .45s var(--spring),box-shadow .3s,background .3s;box-shadow:none}
tbody td{border:0;padding:20px 16px;border-block:1px solid rgba(255,255,255,.06)}
tbody td:first-child{padding-left:76px;position:relative;border-left:1px solid rgba(255,255,255,.06);border-radius:20px 0 0 20px}
tbody td:last-child{border-right:1px solid rgba(255,255,255,.06);border-radius:0 20px 20px 0}
tbody td:first-child::before{content:counter(t,decimal-leading-zero);position:absolute;left:18px;top:50%;transform:translateY(-50%);font-family:var(--font-d);font-size:24px;font-weight:900;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.28);transition:.4s var(--ease)}
tbody tr:hover,.before-section tbody tr:hover{background:linear-gradient(100deg,color-mix(in srgb,var(--accent) 20%,transparent),color-mix(in srgb,var(--pink) 8%,transparent) 60%,rgba(255,255,255,.03));transform:translateX(8px) scale(1.005);box-shadow:0 18px 50px rgba(0,0,0,.5),0 0 40px var(--glow)}
tbody tr:hover td:first-child::before{color:var(--accent);-webkit-text-stroke:0;text-shadow:0 0 22px var(--accent)}
.track-name{font-size:14px;font-weight:700;letter-spacing:-.01em;color:var(--text)}
.icon-play-btn{width:38px;height:38px;border-radius:50%;border:0;color:#10060a;background:linear-gradient(135deg,var(--accent),var(--pink));box-shadow:0 8px 22px var(--glow);transition:transform .4s var(--spring)}
.icon-play-btn:hover{transform:scale(1.2) rotate(-8deg);background:linear-gradient(135deg,var(--accent),var(--pink))}
.playing-now{border-radius:50%;width:24px;height:24px;background:var(--accent);color:#10060a;animation:pulse 1s infinite;box-shadow:0 0 20px var(--accent)}
.track-category-emoji{font-size:15px}
/* ALBUM */
.album-section{background:linear-gradient(180deg,rgba(255,255,255,.04),transparent 30%),rgba(6,12,30,.85)}
.album-banner{min-height:420px;background:radial-gradient(circle at 80% 20%,rgba(95,240,255,.4),transparent 35%),radial-gradient(circle at 10% 100%,rgba(176,124,255,.5),transparent 45%),linear-gradient(130deg,#050a1f,#0a2a6e 55%,#0a6fd0)}
.album-banner h2{font-family:var(--font-d);font-weight:900;letter-spacing:-.07em;-webkit-text-stroke:0;background:linear-gradient(100deg,#fff,#a8f0ff 40%,#c9b4ff 80%);-webkit-background-clip:text;background-clip:text}
.album-track{border-radius:22px;padding:20px 22px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);transform-style:preserve-3d;will-change:transform;transition:transform .25s ease-out,border-color .3s,box-shadow .3s,background .3s}
.album-track:hover{background:linear-gradient(110deg,color-mix(in srgb,var(--accent) 22%,transparent),rgba(255,255,255,.04));border-color:var(--accent);box-shadow:0 24px 60px rgba(0,0,0,.5),0 0 40px var(--glow)}
.album-number{width:48px;height:48px;border-radius:16px;font-family:var(--font-d);font-size:13px;background:conic-gradient(from var(--a),var(--accent),var(--pink),var(--cyan),var(--accent));animation:spin 6s linear infinite;color:#06101f;border:0;box-shadow:0 8px 24px var(--glow)}
.album-song{font-size:17px;font-weight:800;letter-spacing:-.03em}
/* BUTTONS + MODALS */
.primary-btn{border-radius:14px;padding:14px 20px;color:#10060a;background:linear-gradient(110deg,var(--accent),var(--pink),var(--accent2));background-size:200% 100%;transition:transform .4s var(--spring),background-position .6s;box-shadow:0 10px 30px var(--glow)}
.primary-btn:hover{background-position:100% 0;transform:translateY(-3px) scale(1.04)}
.secondary-btn{border-radius:14px;padding:14px 20px;background:rgba(255,255,255,.06)}
.modal-backdrop{background:radial-gradient(circle at 50% 20%,color-mix(in srgb,var(--accent) 16%,transparent),transparent 55%),rgba(3,2,8,.82);backdrop-filter:blur(26px) saturate(1.4);-webkit-backdrop-filter:blur(26px) saturate(1.4)}
.modal{border-radius:30px;border:1.5px solid transparent;background:linear-gradient(160deg,#17121f,#0b0910) padding-box,conic-gradient(from var(--a),transparent 40%,var(--accent),var(--pink),var(--cyan),transparent 90%) border-box;animation:modalEnter .5s var(--spring) both,spin 8s linear infinite;box-shadow:0 50px 160px rgba(0,0,0,.7),0 0 90px var(--glow)}
.admin-console::before{display:none}
/* MINI PLAYER */
.mini-player{border-radius:999px;padding:12px 22px 12px 14px;border:1.5px solid transparent;background:linear-gradient(rgba(14,11,22,.9),rgba(10,8,16,.92)) padding-box,conic-gradient(from var(--a),transparent 45%,var(--accent),var(--pink),var(--cyan),transparent 92%) border-box;animation:spin 7s linear infinite;box-shadow:0 30px 90px rgba(0,0,0,.65),0 0 60px var(--glow);backdrop-filter:blur(30px) saturate(1.5)}
.mini-player.visible{animation:miniPlayerIn .4s var(--spring) both,spin 7s linear infinite}
.mini-art{border-radius:50%;border:0;color:#10060a;background:conic-gradient(var(--accent),var(--pink),var(--cyan),var(--accent2),var(--accent));box-shadow:0 0 22px var(--glow);animation:rot 4s linear infinite;animation-play-state:paused}
body.is-playing .mini-art{animation-play-state:running}
.mini-control{border-radius:50%;transition:transform .35s var(--spring)}.mini-control:hover{transform:scale(1.18)}
.mini-control.primary{background:linear-gradient(135deg,var(--accent),var(--pink));box-shadow:0 8px 26px var(--glow)}
.mini-seek{height:6px}.mini-seek::-webkit-slider-thumb{width:15px;height:15px;box-shadow:0 0 0 4px var(--glow),0 0 16px var(--accent)}
@media(max-width:760px){.mini-player{border-radius:28px}}
/* POLISH */
::selection{background:var(--pink);color:#12060a}
*{scrollbar-width:thin;scrollbar-color:var(--accent) transparent}
.toast{border-radius:999px;border-color:var(--accent);background:rgba(12,10,18,.94)}
.reveal{filter:blur(8px);transform:translateY(40px) scale(.97);transition:opacity .9s,transform 1s var(--ease),filter .9s}.reveal.is-visible{filter:none}
footer{font-family:var(--font-d);font-size:10px;margin-top:30px}
body.no-effects::before,body.no-effects::after,body.no-effects .vinyl{display:none}
body.reduce-motion *,body.reduce-motion *::before,body.reduce-motion *::after{animation:none!important}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important}.reveal{filter:none}}
/* ===== V3: features + extra beauty ===== */
#fx{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.8}
#scrollBar{position:fixed;top:0;left:0;height:3px;width:100%;z-index:300;transform-origin:left;transform:scaleX(0);background:linear-gradient(90deg,var(--accent),var(--pink),var(--cyan));box-shadow:0 0 16px var(--accent)}
.cursor-orb{position:fixed;left:0;top:0;width:340px;height:340px;margin:-170px 0 0 -170px;border-radius:50%;pointer-events:none;z-index:-1;background:radial-gradient(circle,color-mix(in srgb,var(--accent) 22%,transparent),transparent 65%);transition:opacity .4s;will-change:transform}
@media(pointer:coarse){.cursor-orb{display:none}}
body.is-playing .cursor-orb{background:radial-gradient(circle,color-mix(in srgb,var(--pink) 28%,transparent),transparent 65%)}
.hero-hint{display:inline-flex;align-items:center;gap:8px;margin-top:14px;color:var(--muted);font-size:11px}
kbd{font-family:var(--font-d);font-size:9px;padding:4px 7px;border-radius:7px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.07);color:var(--text);box-shadow:0 2px 0 rgba(255,255,255,.1)}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:30px;max-width:620px}
.stat{padding:18px 16px;border-radius:22px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.02));backdrop-filter:blur(16px);transition:transform .45s var(--spring),box-shadow .3s}
.stat:hover{transform:translateY(-5px) rotate(-1deg);box-shadow:0 18px 50px var(--glow)}
.stat b{display:block;font-family:var(--font-d);font-size:clamp(26px,5vw,40px);font-weight:900;letter-spacing:-.05em;background:linear-gradient(120deg,var(--text),var(--accent2));-webkit-background-clip:text;background-clip:text;color:transparent}
.stat span{display:block;margin-top:6px;font-size:9px;letter-spacing:2.5px;color:var(--muted);font-weight:700}
.ticker:hover div{animation-play-state:paused}
tr:has(.playing-now){background:linear-gradient(100deg,color-mix(in srgb,var(--accent) 24%,transparent),color-mix(in srgb,var(--pink) 10%,transparent))!important;box-shadow:0 0 0 1px var(--accent),0 0 50px var(--glow)}
tr:has(.playing-now) td:first-child::before{color:var(--accent);-webkit-text-stroke:0}
.album-track:has(.playing-now){border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),0 0 60px var(--glow)}
.eq{display:flex;align-items:flex-end;gap:2px;height:12px;margin-top:5px}
.eq i{width:3px;height:100%;border-radius:2px;background:linear-gradient(var(--accent2),var(--accent));transform:scaleY(.2);transform-origin:bottom}
body.is-playing .eq i{animation:eqb .8s ease-in-out infinite alternate}
.eq i:nth-child(2){animation-delay:-.25s!important}.eq i:nth-child(3){animation-delay:-.5s!important}.eq i:nth-child(4){animation-delay:-.1s!important}.eq i:nth-child(5){animation-delay:-.4s!important}
@keyframes eqb{from{transform:scaleY(.2)}to{transform:scaleY(1)}}
.mini-track-status{display:none}
.spark{position:fixed;z-index:400;width:7px;height:7px;border-radius:50%;pointer-events:none;background:var(--c,var(--accent));box-shadow:0 0 12px var(--c,var(--accent));animation:spark .75s cubic-bezier(.1,.8,.3,1) forwards}
@keyframes spark{to{transform:translate(var(--x),var(--y)) scale(0);opacity:0}}
#toTop{position:fixed;right:18px;bottom:118px;z-index:90;width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.18);background:rgba(14,11,22,.8);color:var(--text);font-size:18px;backdrop-filter:blur(16px);opacity:0;pointer-events:none;transform:translateY(14px) scale(.8);transition:.4s var(--spring)}
#toTop.show{opacity:1;pointer-events:auto;transform:none}#toTop:hover{background:var(--accent);color:#10060a;transform:translateY(-4px) scale(1.1)}
#cmdk .modal{width:min(620px,100%);padding:18px}
#cmdkInput{width:100%;padding:18px 20px;font-size:17px;border-radius:18px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:var(--text)}
#cmdkList{margin-top:12px;max-height:50vh;overflow:auto;display:grid;gap:4px}
.cmd-item{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:12px 14px;border:0;border-radius:14px;background:transparent;color:var(--text);font-size:14px;transition:background .15s,transform .2s}
.cmd-item small{margin-left:auto;color:var(--muted);font-size:9px;letter-spacing:1.6px;font-weight:800}
.cmd-item.sel,.cmd-item:hover{background:linear-gradient(100deg,color-mix(in srgb,var(--accent) 30%,transparent),rgba(255,255,255,.04));transform:translateX(4px)}
.cmd-foot{display:flex;gap:14px;flex-wrap:wrap;margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,.08);color:var(--muted);font-size:10px}
#lyricsModal .lyrics-line.is-active{text-shadow:0 0 50px var(--accent),0 0 120px var(--glow)}
.section-header h2::after{content:"";display:block;width:54px;height:3px;margin-top:12px;border-radius:3px;background:linear-gradient(90deg,var(--accent),var(--pink))}
@media(max-width:620px){.stats{gap:8px}.stat{padding:13px 10px}#toTop{bottom:150px}.hero-hint{display:none}}
body.no-effects #fx,body.no-effects .cursor-orb{display:none}
/* ===== V4: now-playing stage, favourites, splash, polish ===== */
.modal-backdrop{z-index:130}
.section-header{position:relative}
.before-section .section-header::before,.album-section .album-title-row::before{content:"01";position:absolute;right:26px;top:50%;transform:translateY(-50%);font-family:var(--font-d);font-size:clamp(54px,10vw,110px);font-weight:900;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.12);pointer-events:none;letter-spacing:-.06em}
.album-section .album-title-row{position:relative}.album-section .album-title-row::before{content:"02"}
.fav-btn{width:32px;height:32px;padding:0;border-radius:50%;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.05);color:var(--muted);font-size:15px;line-height:1;transition:transform .4s var(--spring),color .2s,box-shadow .3s}
.fav-btn:hover{transform:scale(1.2);color:var(--pink)}
.fav-btn.on{color:var(--pink);border-color:var(--pink);box-shadow:0 0 20px color-mix(in srgb,var(--pink) 55%,transparent);animation:beat .5s var(--spring)}
@keyframes beat{40%{transform:scale(1.4)}}
.fav-chip{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.05);color:var(--text);border-radius:999px;padding:12px 18px;font-size:10px;font-weight:900;letter-spacing:.8px;transition:transform .4s var(--spring),box-shadow .3s}
.fav-chip:hover{transform:translateY(-3px) scale(1.05)}
.fav-chip.on{color:#10060a;border-color:transparent;background:linear-gradient(110deg,var(--pink),var(--accent));box-shadow:0 10px 34px color-mix(in srgb,var(--pink) 45%,transparent)}
body.fav-only #trackTable tr:not(.is-fav),body.fav-only .album-track:not(.is-fav){display:none}
.ripple{position:absolute;border-radius:50%;pointer-events:none;background:rgba(255,255,255,.45);transform:scale(0);animation:rip .6s ease-out forwards}
@keyframes rip{to{transform:scale(3.4);opacity:0}}
.primary-btn,.secondary-btn,.admin-chip,.fav-chip{position:relative;overflow:hidden}
/* now playing stage */
#np{position:fixed;inset:0;z-index:110;display:none;flex-direction:column;align-items:center;justify-content:center;gap:20px;padding:24px;text-align:center;background:radial-gradient(circle at 50% 38%,color-mix(in srgb,var(--accent) 26%,transparent),transparent 60%),radial-gradient(circle at 80% 90%,color-mix(in srgb,var(--pink) 18%,transparent),transparent 50%),rgba(5,4,10,.95);backdrop-filter:blur(34px)}
#np.open{display:flex;animation:npIn .55s var(--ease) both}
@keyframes npIn{from{opacity:0;transform:scale(1.05)}to{opacity:1;transform:none}}
.np-close{position:absolute;top:18px;right:18px;width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.06);color:var(--text);font-size:20px;transition:transform .4s var(--spring)}
.np-close:hover{transform:rotate(90deg) scale(1.1)}
.np-disc{position:relative;display:grid;place-items:center;margin-bottom:6px}
.np-disc .vinyl{position:relative;right:auto;top:auto;width:min(44vh,76vw);opacity:1}
.np-rings{position:absolute;inset:0;pointer-events:none}
.np-rings i{position:absolute;inset:-4%;border-radius:50%;border:1.5px solid var(--accent);opacity:0}
body.is-playing .np-rings i{animation:ring 3.2s ease-out infinite}
.np-rings i:nth-child(2){animation-delay:1.05s!important}.np-rings i:nth-child(3){animation-delay:2.1s!important}
@keyframes ring{from{transform:scale(.96);opacity:.7}to{transform:scale(1.4);opacity:0}}
.np-eyebrow{font-family:var(--font-d);font-size:10px;letter-spacing:4px;color:var(--accent)}
#npTitle{margin:0;font-family:var(--font-d);font-weight:900;font-size:clamp(26px,6vw,58px);letter-spacing:-.05em;line-height:1;max-width:90vw;overflow-wrap:anywhere;background:conic-gradient(from var(--a),var(--text),var(--accent2),var(--pink),var(--text));-webkit-background-clip:text;background-clip:text;color:transparent;animation:spin 8s linear infinite}
.np-seek{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;width:min(580px,92vw);color:var(--muted);font-size:11px;font-variant-numeric:tabular-nums}
.np-seek .mini-seek{height:8px}
.np-ctrls{display:flex;gap:14px;align-items:center;flex-wrap:wrap;justify-content:center}
.np-ctrls .mini-control{width:54px;height:54px;font-size:18px}.np-ctrls .mini-control.primary{width:74px;height:74px;font-size:24px}
.np-ctrls .mini-control.lyrics-cta{width:auto;height:44px;font-size:11px}
.np-hint{color:var(--muted);font-size:10px;letter-spacing:1px}
/* splash */
#splash{position:fixed;inset:0;z-index:600;display:grid;place-items:center;align-content:center;gap:22px;background:radial-gradient(circle at 50% 40%,color-mix(in srgb,var(--accent) 24%,transparent),transparent 60%),var(--bg);transition:opacity .8s,visibility .8s,transform .8s var(--ease)}
#splash.hide{opacity:0;visibility:hidden;transform:scale(1.06)}
#splash .vinyl{position:relative;right:auto;top:auto;width:140px;animation-play-state:running;opacity:1}
#splash b{font-family:var(--font-d);font-size:12px;letter-spacing:6px;color:var(--text);animation:pulse 1.2s infinite}
@media(max-width:620px){.before-section .section-header::before{display:none}}
/* ===== V5: covers, cover-card, cover-driven Now Playing page ===== */
body:not(.is-admin) .admin-only{display:none!important}
body:not(.is-admin) #albumArt.empty{display:none}
body.np-open{overflow:hidden}
.mini-art{cursor:pointer}
.mini-art.has-cover{background-size:cover;background-position:center;color:transparent;animation:none!important;border-radius:14px}
/* era card */
.era-card{--card-c:var(--accent);display:flex;gap:24px;align-items:center;padding:22px;margin-bottom:26px;border-radius:28px;border:1px solid color-mix(in srgb,var(--card-c) 45%,transparent);background:radial-gradient(circle at 0 0,color-mix(in srgb,var(--card-c) 40%,transparent),transparent 60%),linear-gradient(120deg,color-mix(in srgb,var(--card-c) 30%,#0b0810),color-mix(in srgb,var(--card-c) 8%,#0b0810) 75%);box-shadow:0 24px 70px color-mix(in srgb,var(--card-c) 28%,transparent),inset 0 1px 0 rgba(255,255,255,.1);transition:background .6s,box-shadow .6s}
.era-cover{flex:0 0 clamp(96px,18vw,160px);aspect-ratio:1;border:0;border-radius:24px;background:center/cover #1a1522;box-shadow:0 20px 44px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.16);display:grid;place-items:center;font-size:46px;color:var(--accent);transition:transform .5s var(--spring)}
.era-cover:hover{transform:scale(1.06) rotate(-3deg)}
.era-cover.empty{background:linear-gradient(135deg,#251b30,#110c18);border:2px dashed rgba(255,255,255,.22)}
.era-info{min-width:0;display:grid;gap:10px}
.era-title{font-family:var(--font-d);font-size:clamp(20px,4vw,36px);font-weight:900;letter-spacing:-.05em;line-height:1;color:#fff}
.era-sub{color:rgba(255,255,255,.65);font-size:13px;overflow-wrap:anywhere}
.era-chips{display:flex;gap:7px;flex-wrap:wrap}.era-chips span{padding:6px 11px;border-radius:999px;background:rgba(255,255,255,.1);font-size:10px;font-weight:900;letter-spacing:1.4px;color:#fff}
.era-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:4px}
@media(max-width:560px){.era-card{flex-direction:column;align-items:flex-start}}
.era-art{position:absolute;z-index:2;right:7%;top:50%;width:clamp(120px,22vw,240px);aspect-ratio:1;transform:translateY(-50%) rotate(5deg);border:0;border-radius:26px;background:center/cover;color:#fff;font-size:11px;font-weight:900;letter-spacing:2px;box-shadow:0 30px 80px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.2),0 0 80px rgba(80,170,255,.35);transition:transform .5s var(--spring)}
.era-art:hover{transform:translateY(-50%) rotate(-2deg) scale(1.05)}
.era-art.empty{border:2px dashed rgba(255,255,255,.4);background:rgba(255,255,255,.06)}
@media(max-width:700px){.era-art{top:auto;bottom:18px;right:16px;width:96px;transform:rotate(5deg)}.era-art:hover{transform:rotate(0)}}
/* chips + lightbox + cover editor */
body.playable-only #trackTable tr:not(:has(.icon-play-btn)),body.playable-only .album-track:not(:has(.icon-play-btn)){display:none}
#lightbox{position:fixed;inset:0;z-index:700;display:none;place-items:center;background:rgba(3,2,8,.88);backdrop-filter:blur(22px);cursor:zoom-out}
#lightbox.open{display:grid;animation:npIn .3s both}
#lightbox img{max-width:min(88vw,720px);max-height:86vh;border-radius:28px;box-shadow:0 50px 140px rgba(0,0,0,.7),0 0 100px var(--glow)}
.cover-preview{height:180px;margin-bottom:16px;border-radius:20px;border:2px dashed rgba(255,255,255,.22);background:center/contain no-repeat rgba(255,255,255,.04)}
.deep-hit{animation:deep 1.8s ease 2}@keyframes deep{50%{box-shadow:0 0 0 3px var(--accent),0 0 60px var(--accent)}}
/* now playing page */
#np2{--npc:var(--accent);position:fixed;inset:0;z-index:110;display:none;overflow:hidden;background:#07050a}
#np2.open{display:block;animation:npIn .5s var(--ease) both}
#np2 .np-close{z-index:4;right:auto;left:18px}
.np2-bg{position:absolute;inset:-14%;background:center/cover;filter:blur(70px) saturate(1.8) brightness(.62);transform:scale(1.2);animation:npDrift 22s ease-in-out infinite alternate}
.np2-bg.nocover{background:radial-gradient(circle at 25% 20%,var(--npc),transparent 55%),radial-gradient(circle at 80% 85%,var(--pink),transparent 50%);filter:blur(40px)}
@keyframes npDrift{to{transform:scale(1.38) translate(2%,-2%) rotate(3deg)}}
.np2-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.6))}
.np2-main{position:relative;z-index:2;height:100%;max-width:640px;margin:auto;padding:30px 20px 24px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;overflow-y:auto;overflow-x:hidden}
.np2-art{position:relative;flex:0 0 auto;width:min(38vh,74vw);aspect-ratio:1;margin-bottom:8px;perspective:900px}
.np2-sleeve{position:relative;z-index:2;width:100%;height:100%;border-radius:28px;background:center/cover linear-gradient(135deg,#2a1d36,#120d1a);display:grid;place-items:center;font-size:90px;color:rgba(255,255,255,.45);box-shadow:0 40px 90px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.14),0 0 100px color-mix(in srgb,var(--npc) 50%,transparent);transition:transform .25s ease-out}
.np2-art .vinyl{position:absolute;z-index:1;right:-20%;top:5%;width:90%;opacity:1}
.np2-meta{text-align:center}
.np2-meta h2{margin:0;font-family:var(--font-d);font-size:clamp(24px,5.5vw,44px);font-weight:900;letter-spacing:-.045em;line-height:1.05;color:#fff;overflow-wrap:anywhere;text-shadow:0 4px 30px rgba(0,0,0,.45)}
.np2-artist{margin-top:8px;font-size:18px;font-weight:500;color:rgba(255,255,255,.92)}.np2-album{margin-top:4px;font-size:14px;color:rgba(255,255,255,.6)}
.np2-tags{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin-top:10px}.np2-tags span{padding:5px 11px;border-radius:999px;background:rgba(255,255,255,.14);font-size:10px;font-weight:800;letter-spacing:1.2px;color:#fff}
.np2-wave{width:100%}#np2Wave{display:block;width:100%;height:62px;cursor:pointer;touch-action:none;filter:drop-shadow(0 0 12px rgba(255,255,255,.18))}
.np2-times{display:flex;justify-content:space-between;margin-top:6px;color:rgba(255,255,255,.7);font-size:12px;font-variant-numeric:tabular-nums}
.np2-ctrls{display:flex;gap:clamp(12px,5vw,32px);align-items:center}
.np2-b{width:46px;height:46px;padding:0;border:0;border-radius:50%;background:transparent;color:rgba(255,255,255,.75);font-size:20px;transition:transform .35s var(--spring),color .2s}
.np2-b:hover{transform:scale(1.2);color:#fff}.np2-b.on{color:var(--accent2);text-shadow:0 0 16px var(--accent)}
.np2-play{width:84px;height:84px;background:#fff;color:#111;font-size:26px;letter-spacing:-2px;box-shadow:0 16px 44px rgba(0,0,0,.5),0 0 56px color-mix(in srgb,var(--npc) 60%,transparent)}.np2-play:hover{color:#000;transform:scale(1.1)}
.np2-vol{display:flex;gap:10px;align-items:center;width:min(260px,72%);color:rgba(255,255,255,.7)}.np2-vol input{flex:1;accent-color:#fff}
.np2-tools{display:flex;gap:9px;flex-wrap:wrap;justify-content:center}
.np2-t{padding:11px 15px;border-radius:999px;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.09);color:#fff;font-size:11px;font-weight:800;letter-spacing:.8px;backdrop-filter:blur(10px);transition:transform .35s var(--spring),background .2s}
.np2-t:hover{transform:translateY(-3px);background:rgba(255,255,255,.2)}.np2-t.on{background:var(--pink);color:#12060a;border-color:transparent}
.np2-drawer{position:absolute;z-index:3;top:0;right:0;bottom:0;width:min(380px,92vw);display:flex;flex-direction:column;transform:translateX(105%);transition:transform .5s var(--ease);background:rgba(10,8,16,.9);backdrop-filter:blur(30px);border-left:1px solid rgba(255,255,255,.12)}
.np2-drawer.open{transform:none}
.np2-dh{display:flex;gap:10px;align-items:center;padding:20px;border-bottom:1px solid rgba(255,255,255,.1)}
.np2-dh b{font-family:var(--font-d);font-size:11px;letter-spacing:3px;color:var(--accent)}
.np2-dh input{flex:1;min-width:0;padding:10px 14px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:#fff}
#np2List{display:grid;align-content:start;gap:4px;padding:10px;overflow:auto}
.np2-li{display:flex;align-items:center;gap:12px;padding:8px;border:0;border-radius:14px;background:transparent;color:#fff;text-align:left;font-size:13px;transition:background .2s,transform .2s}
.np2-li:hover{background:rgba(255,255,255,.1);transform:translateX(3px)}.np2-li.cur{background:color-mix(in srgb,var(--accent) 30%,transparent)}
.np2-li i{flex:0 0 40px;height:40px;border-radius:10px;background:center/cover #241b2e;display:grid;place-items:center;font-style:normal;font-size:14px;color:rgba(255,255,255,.5)}
.np2-li span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-height:760px){.np2-art{width:min(30vh,64vw)}.np2-play{width:70px;height:70px}}
/* ===== V6: collapsible sections ===== */
.coll{display:grid;grid-template-rows:1fr;transition:grid-template-rows .55s var(--ease)}
.coll-in{min-height:0;overflow:hidden}
.section.collapsed .coll{grid-template-rows:0fr}
body.no-anim .coll{transition:none}
.section-header{cursor:pointer;gap:14px}
.hdr-left{display:flex;align-items:center;gap:16px;min-width:0}
.hdr-right{display:flex;align-items:center;gap:12px;flex:0 0 auto}
.hdr-thumb,.bar-thumb{display:none;flex:0 0 52px;height:52px;border-radius:14px;background:center/cover #1a1522;box-shadow:0 8px 24px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.16)}
.hdr-thumb.has,.bar-thumb.has{display:block}
.collapse-btn{flex:0 0 40px;width:40px;height:40px;padding:0;border-radius:50%;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.07);color:var(--text);font-size:17px;line-height:1;display:grid;place-items:center;transition:transform .55s var(--spring),background .2s,color .2s}
.section-header:hover .collapse-btn,.collapse-bar:hover .collapse-btn,.collapse-btn:hover{background:var(--accent);color:#10060a}
.section.collapsed .collapse-btn{transform:rotate(180deg)}
.before-section.collapsed .section-header{border-bottom-color:transparent}
.collapse-bar{display:none;align-items:center;gap:16px;width:100%;padding:22px 28px;border:0;background:linear-gradient(110deg,rgba(79,157,255,.16),transparent 75%);color:var(--text);text-align:left;cursor:pointer}
.section.collapsed .collapse-bar{display:flex}
.bar-text{flex:1;min-width:0}
.bar-title{margin-top:6px;font-family:var(--font-d);font-size:clamp(17px,3vw,24px);font-weight:900;letter-spacing:-.03em;overflow-wrap:anywhere}
.album-banner .collapse-btn{position:absolute;top:18px;right:18px;z-index:5}
.album-section .album-banner{padding-right:clamp(30px,6vw,62px)}
@media(max-width:620px){.collapse-bar{padding:16px}.hdr-thumb,.bar-thumb{flex-basis:42px;height:42px}}
/* ===== V7: new category + category descriptions ===== */
.cat-desc{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:-4px 0 18px;padding:14px 18px;border-radius:18px;border:1px solid rgba(255,255,255,.1);border-left:3px solid var(--accent);background:linear-gradient(100deg,color-mix(in srgb,var(--accent) 12%,transparent),rgba(255,255,255,.02))}
.cat-desc[data-cat=honorable-mention]{border-left-color:#9db4d6}.cat-desc[data-cat=best]{border-left-color:#ffd36e}.cat-desc[data-cat=fan-favourite]{border-left-color:var(--pink)}.cat-desc[data-cat=worst]{border-left-color:#8a7a80}
.cat-desc-ic{font-size:26px;line-height:1}
.cat-desc-tx{flex:1;min-width:200px;display:grid;gap:3px}
.cat-desc-tx b{font-family:var(--font-d);font-size:12px;letter-spacing:1px;color:var(--text)}
.cat-desc-tx span{color:var(--muted);font-size:12px;line-height:1.55}
.cat-guide-btn{padding:9px 13px;border-radius:999px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:var(--text);font-size:9px;font-weight:900;letter-spacing:1.2px;transition:transform .35s var(--spring),border-color .2s}
.cat-guide-btn:hover{transform:translateY(-2px);border-color:var(--accent)}
.cat-guide{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px;margin:-6px 0 20px}
.cat-guide[hidden]{display:none}
.cat-guide-item{display:flex;gap:12px;padding:14px;border-radius:16px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.035);animation:rowEnter .4s ease both}
.cat-guide-item i{font-style:normal;font-size:22px;line-height:1.2}
.cat-guide-item b{display:block;margin-bottom:4px;font-size:12px;color:var(--text)}
.cat-guide-item span{color:var(--muted);font-size:11px;line-height:1.55}
.cat-help{margin-top:8px;color:var(--muted);font-size:11px;line-height:1.6}
.pill[data-cat=best]{background:linear-gradient(135deg,#ffd36e,#ff9f43);color:#241203;border:0}
.pill[data-cat=honorable-mention]{background:linear-gradient(135deg,#eef4ff,#9db4d6);color:#0e1626;border:0}
.pill[data-cat=fan-favourite]{background:linear-gradient(135deg,#ff7ec0,#b07cff);color:#1a0716;border:0}
.pill[data-cat=worst]{background:rgba(255,255,255,.08);color:#c9b3b6;border:1px solid rgba(255,255,255,.18);box-shadow:none}
.filter-btn[data-category=honorable-mention].active{background:linear-gradient(110deg,#eef4ff,#9db4d6);box-shadow:0 10px 30px rgba(157,180,214,.35)}
/* ===== V9: drag & drop ordering ===== */
.drag-h{display:none;place-items:center;width:30px;height:30px;flex:0 0 30px;border-radius:10px;border:1px dashed rgba(255,255,255,.3);color:var(--muted);font-size:14px;letter-spacing:-3px;cursor:grab;touch-action:none;user-select:none;transition:transform .3s var(--spring),color .2s,border-color .2s}
.drag-h:hover{color:var(--accent);border-color:var(--accent);transform:scale(1.12)}
body.is-admin.drag-ok #trackTable .drag-h,body.is-admin #albumList .drag-h{display:inline-grid}
.drag-on{position:relative;z-index:20;animation:none!important;transition:none!important;will-change:transform;box-shadow:0 24px 70px rgba(0,0,0,.65),0 0 0 2px var(--accent),0 0 50px var(--glow)!important;background:color-mix(in srgb,var(--accent) 22%,#14101c)!important}
body.dragging-now,body.dragging-now *{cursor:grabbing!important;user-select:none}
.order-hint{display:none;align-items:center;gap:12px;flex-wrap:wrap;margin:0 0 16px;padding:12px 16px;border-radius:16px;border:1px dashed rgba(255,255,255,.22);background:rgba(255,255,255,.035);color:var(--muted);font-size:12px;line-height:1.5}
body.is-admin .order-hint{display:flex}
.order-hint b{color:var(--text)}.order-hint .secondary-btn{padding:9px 14px;font-size:10px}
body.drag-ok .order-hint{border-style:solid;border-color:color-mix(in srgb,var(--accent) 50%,transparent);background:color-mix(in srgb,var(--accent) 8%,transparent)}
body.drag-ok .order-hint .secondary-btn{display:none}
.album-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
.album-meta .chip{padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.1);font-size:9px;font-weight:900;letter-spacing:1.2px;color:#fff}
.album-meta .pill{padding:5px 10px}
.album-edit-note{margin:14px 0 0;font-size:10px;line-height:1.8}
.cat-more-btn{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.05);color:var(--text);border-radius:999px;padding:12px 18px;font-size:10px;font-weight:900;letter-spacing:.8px;transition:transform .4s var(--spring),box-shadow .3s}
.cat-more-btn:hover{transform:translateY(-3px) scale(1.05)}
.cat-more-btn.on{color:#10060a;border-color:transparent;background:linear-gradient(110deg,var(--accent),var(--accent2));box-shadow:0 10px 34px var(--glow)}
.cat-more{display:grid;gap:16px;margin:-6px 0 18px;padding:18px;border-radius:22px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);animation:rowEnter .35s ease both}
.cat-more[hidden]{display:none}
.cat-more-search,.cat-search{width:100%;padding:12px 16px;border-radius:14px;font-size:13px}
.cat-search{margin-bottom:8px}
.cat-grp h4{margin:0 0 9px;font-family:var(--font-d);font-size:9px;letter-spacing:3px;color:var(--accent)}
.cat-grp-btns{display:flex;flex-wrap:wrap;gap:7px}
.cat-grp .filter-btn{padding:9px 13px}
.guide-grp{grid-column:1/-1;margin-top:8px;font-family:var(--font-d);font-size:9px;letter-spacing:3px;color:var(--accent)}
.category-options{max-height:210px;overflow:auto}
.pill[data-grp=ranking]{background:linear-gradient(135deg,#ffe29a,#ffb347);color:#241203;border:0}
.pill[data-grp=vibe]{background:linear-gradient(135deg,#ff9a5a,#ff5f8a);color:#1d0508;border:0}
.pill[data-grp=mood]{background:linear-gradient(135deg,#ff9ec4,#b07cff);color:#1a0716;border:0}
.pill[data-grp=style]{background:linear-gradient(135deg,#7be8ff,#5b8cff);color:#04142a;border:0}
.pill[data-grp=type]{background:linear-gradient(135deg,#7dffb2,#d6ff6e);color:#04170e;border:0}
.pill[data-grp=status]{background:rgba(255,211,110,.1);color:#ffd36e;border:1px dashed #ffd36e;box-shadow:none}
.pill[data-cat=best]{background:linear-gradient(135deg,#ffd36e,#ff9f43);color:#241203;border:0}
.pill[data-cat=honorable-mention]{background:linear-gradient(135deg,#eef4ff,#9db4d6);color:#0e1626;border:0}
.pill[data-cat=fan-favourite]{background:linear-gradient(135deg,#ff7ec0,#b07cff);color:#1a0716;border:0}
.pill[data-cat=worst]{background:rgba(255,255,255,.08);color:#c9b3b6;border:1px solid rgba(255,255,255,.18);box-shadow:none}

/* big text bar */
.big-banner{position:relative;margin:34px 0 6px;padding:clamp(22px,5vw,46px) clamp(16px,4vw,40px);text-align:center;border-radius:28px;border:1.5px solid transparent;overflow:hidden;
background:linear-gradient(160deg,rgba(26,18,34,.9),rgba(10,8,16,.92)) padding-box,conic-gradient(from var(--a),transparent 30%,var(--accent),var(--pink),var(--cyan),var(--accent2),transparent 90%) border-box;
animation:spin 9s linear infinite;box-shadow:0 30px 90px rgba(0,0,0,.55),0 0 70px var(--glow)}
.big-banner::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--accent) 28%,transparent),transparent 65%);pointer-events:none}
.big-banner-text{position:relative;display:block;font-family:var(--font-d);font-size:clamp(24px,5.6vw,72px);font-weight:900;line-height:1.05;letter-spacing:-.05em;text-transform:uppercase;
background:linear-gradient(100deg,var(--text),var(--accent2) 35%,var(--pink) 65%,var(--cyan));background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shimmer 7s linear infinite;
filter:drop-shadow(0 0 30px color-mix(in srgb,var(--pink) 40%,transparent));overflow-wrap:anywhere}
@keyframes shimmer{to{background-position:220% 0}}
body.reduce-motion .big-banner,body.reduce-motion .big-banner-text{animation:none}
</style>
</head>

<body>
<div class="ambient" aria-hidden="true">
  <div class="ambient-grid"></div><div class="orb orb-one"></div>
  <div class="orb orb-two"></div><div class="orb orb-three"></div>
</div>

<div class="container">
<header class="hero">
  <div class="topbar">
    <div class="logo"><span class="logo-dot"></span> JOPPEPOPE / MUSIC ARCHIVE</div>
    <div class="topbar-actions">
      <button class="settings-button" id="settingsButton" type="button">⚙ SETTINGS</button>
      <button class="updates-button" id="updatesButton" type="button">✦ UPDATES</button>
      <button class="admin-button" id="adminButton">✳ ADMIN</button>
    </div>
  </div>
  <div class="hero-label"><span class="live-dot"></span> THE OFFICIAL TRACK ARCHIVE</div>
  <h1>JOPPEPOPE<br><span class="hero-gradient">TRACKER.</span></h1>
  <p class="subtitle">Every song has a story. Explore the archive, discover the tracks, and follow the journey into the next era.</p>
  <div class="hero-bottom">
    <span class="status-chip"><span class="live-dot"></span> ARCHIVE ONLINE</span>
    <span class="status-chip">✦ TWO MUSICAL ERAS</span>
  </div>
</header>
<div class="big-banner" role="note"><span class="big-banner-text">Leo is best and Leo is kung and Maciek is kung and best</span></div>

<section class="section before-section reveal" id="beforeSection">
  <div class="section-header">
    <div><div class="eyebrow">01 / THE ARCHIVE</div><h2>BEFORE THE FIRST ALBUM</h2></div>
    <span class="pill" id="beforeCount">0 TRACKS</span>
  </div>
  <div class="section-body">
    <div class="toolbar">
      <input class="field search" id="searchInput" placeholder="⌕  Search the archive..." aria-label="Search tracks">
      <select class="field" id="sortSelect" aria-label="Sort tracks">
        <option value="custom">☰ CUSTOM ORDER</option>
        <option value="newest">✦ NEWEST FIRST</option>
        <option value="shuffle">🔀 SHUFFLE TRACKS / NEXT</option>
        <option value="oldest">◷ OLDEST FIRST</option>
        <option value="name">Ａ–Ｚ NAME</option>
        <option value="year">▤ BY YEAR</option>
      </select>
    </div>
<div class="filter-row">
  <button class="filter-btn active" data-category="all">✦ ALL TRACKS <span class="filter-count" id="countAll">0</span></button>
  <button class="filter-btn" data-category="best">⭐ BEST <span class="filter-count" id="countBest">0</span></button>
  <button class="filter-btn" data-category="honorable-mention">🥈 HONORABLE MENTION <span class="filter-count" id="count_honorable-mention">0</span></button>
  <button class="filter-btn" data-category="classic">👑 CLASSIC <span class="filter-count" id="count_classic">0</span></button>
  <button class="filter-btn" data-category="hidden-gem">💎 HIDDEN GEM <span class="filter-count" id="count_hidden-gem">0</span></button>
  <button class="filter-btn" data-category="viral">📈 VIRAL <span class="filter-count" id="count_viral">0</span></button>
  <button class="filter-btn" data-category="overrated">📉 OVERRATED <span class="filter-count" id="count_overrated">0</span></button>
  <button class="filter-btn" data-category="guilty-pleasure">🙈 GUILTY PLEASURE <span class="filter-count" id="count_guilty-pleasure">0</span></button>
  <button class="filter-btn" data-category="banger">🔥 BANGER <span class="filter-count" id="count_banger">0</span></button>
  <button class="filter-btn" data-category="chill">🌙 CHILL <span class="filter-count" id="count_chill">0</span></button>
  <button class="filter-btn" data-category="party">🎉 PARTY <span class="filter-count" id="count_party">0</span></button>
  <button class="filter-btn" data-category="workout">🏋️ WORKOUT <span class="filter-count" id="count_workout">0</span></button>
  <button class="filter-btn" data-category="driving">🚗 DRIVING <span class="filter-count" id="count_driving">0</span></button>
  <button class="filter-btn" data-category="summer">☀️ SUMMER <span class="filter-count" id="count_summer">0</span></button>
  <button class="filter-btn" data-category="dark">🖤 DARK <span class="filter-count" id="count_dark">0</span></button>
  <button class="filter-btn" data-category="cinematic">🎬 CINEMATIC <span class="filter-count" id="count_cinematic">0</span></button>
  <button class="filter-btn" data-category="throwback">⏳ THROWBACK <span class="filter-count" id="count_throwback">0</span></button>
  <button class="filter-btn" data-category="motivational">💪 MOTIVATIONAL <span class="filter-count" id="count_motivational">0</span></button>
  <button class="filter-btn" data-category="emotional">💔 EMOTIONAL <span class="filter-count" id="count_emotional">0</span></button>
  <button class="filter-btn" data-category="love">💘 LOVE SONG <span class="filter-count" id="count_love">0</span></button>
  <button class="filter-btn" data-category="introspective">🪞 INTROSPECTIVE <span class="filter-count" id="count_introspective">0</span></button>
  <button class="filter-btn" data-category="lyrical">✍️ LYRICAL <span class="filter-count" id="count_lyrical">0</span></button>
  <button class="filter-btn" data-category="melodic">🎶 MELODIC <span class="filter-count" id="count_melodic">0</span></button>
  <button class="filter-btn" data-category="storytelling">📖 STORYTELLING <span class="filter-count" id="count_storytelling">0</span></button>
  <button class="filter-btn" data-category="experimental">🧪 EXPERIMENTAL <span class="filter-count" id="count_experimental">0</span></button>
  <button class="filter-btn" data-category="funny">😂 FUNNY <span class="filter-count" id="count_funny">0</span></button>
  <button class="filter-btn" data-category="instrumental">🎹 INSTRUMENTAL <span class="filter-count" id="count_instrumental">0</span></button>
  <button class="filter-btn" data-category="acoustic">🎸 ACOUSTIC <span class="filter-count" id="count_acoustic">0</span></button>
  <button class="filter-btn" data-category="diss">🎯 DISS <span class="filter-count" id="count_diss">0</span></button>
  <button class="filter-btn" data-category="freestyle">🎤 FREESTYLE <span class="filter-count" id="count_freestyle">0</span></button>
  <button class="filter-btn" data-category="collab">🤝 COLLAB <span class="filter-count" id="count_collab">0</span></button>
  <button class="filter-btn" data-category="remix">🔁 REMIX / COVER <span class="filter-count" id="count_remix">0</span></button>
  <button class="filter-btn" data-category="skit">🎙️ SKIT / INTERLUDE <span class="filter-count" id="count_skit">0</span></button>
  <button class="filter-btn" data-category="unfinished">🚧 UNFINISHED <span class="filter-count" id="count_unfinished">0</span></button>
  <button class="filter-btn" data-category="leaked">🕵️ LEAKED <span class="filter-count" id="count_leaked">0</span></button>
  <button class="filter-btn" data-category="snippet">✂️ SNIPPET <span class="filter-count" id="count_snippet">0</span></button>
  <button class="filter-btn" data-category="worst">🗑️ WORST <span class="filter-count" id="countWorst">0</span></button>
  <button class="filter-btn" data-category="fan-favourite">💖 FAN FAVOURITE <span class="filter-count" id="countFanFavourite">0</span></button>
</div>
    <div class="filter-tools">
      <label class="filter-label" for="yearFilter">YEAR
        <select class="field" id="yearFilter" aria-label="Filter tracks by year">
          <option value="all">ALL YEARS</option>
        </select>
      </label>
      <div class="filter-status" id="filterStatus" aria-live="polite">Showing all tracks</div>
      <button class="filter-reset" id="resetFiltersButton" type="button">↺ RESET FILTERS</button>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Track</th><th>Year</th><th>Length</th><th>Category</th><th>Description / Details</th></tr></thead>
        <tbody id="trackTable"><tr><td colspan="5" class="empty">Loading the archive...</td></tr></tbody>
      </table>
    </div>
    <p class="muted" style="font-size:10px;line-height:1.8;margin:14px 0 0">Double-click a track to edit it while admin mode is unlocked. Right-click a track for quick commands.</p>
  </div>
</section>

<section class="section album-section reveal" id="albumSection">
  <div class="album-banner">
    <div class="album-kicker"><span class="live-dot"></span> 02 / THE NEXT ERA</div>
    <h2>ALBUM<br>COMING SOON.</h2>
    <p>A new chapter is on the way. Seven tracks, new stories, and a whole new era. The journey starts here.</p>
  </div>
  <div class="section-body" id="albumTracklist">
    <div class="album-title-row">
      <div><div class="eyebrow">THE UPCOMING RELEASE</div><div class="album-title">✦ ALBUM TRACKLIST</div></div>
      <span class="pill" id="albumCount">7 TRACKS</span>
    </div>
    <div class="album-list" id="albumList"><div class="empty">Loading album tracklist...</div></div>
    <div class="album-footer">TRACKLIST SUBJECT TO CHANGE · Untitled songs are placeholders until their names are decided.</div>
  </div>
</section>
<footer>JOPPEPOPE TRACKER<br><span style="opacity:.65">A MUSIC ARCHIVE · BUILT FOR THE NEXT ERA ✦</span></footer>
</div>

<!-- LOGIN -->
<div class="modal-backdrop" id="loginModal">
  <div class="modal">
    <div class="eyebrow">RESTRICTED AREA / 01</div>
    <h2>Welcome back.</h2>
    <p class="modal-desc">Unlock admin access to manage songs in both eras.</p>
    <form id="loginForm">
      <div class="form-field"><label for="adminEmail">Admin email</label><input id="adminEmail" type="email" autocomplete="username" required></div>
      <div class="form-field"><label for="adminPassword">Admin password</label><input id="adminPassword" type="password" autocomplete="current-password" required></div>
      <div class="modal-actions">
        <button class="secondary-btn" type="button" data-close="loginModal">CANCEL</button>
        <button class="primary-btn" type="submit">UNLOCK ACCESS ↗</button>
      </div>
    </form>
  </div>
</div>

<!-- TRACK EDITOR -->
<div class="modal-backdrop" id="trackModal">
  <div class="modal">
    <div class="eyebrow">TRACK MANAGEMENT / EDITOR</div>
    <h2 id="trackModalTitle">Add a track</h2>
    <p class="modal-desc">Edit the song information, add an audio link, or move it to another era.</p>
    <form id="trackForm">
      <input type="hidden" id="trackId">
      <div class="form-grid">
        <div class="form-field full"><label for="trackName">Track name</label><input id="trackName" maxlength="160" placeholder="Untitled" required></div>
        <div class="form-field full"><label for="trackAliases">Other names / aliases</label><input id="trackAliases" maxlength="500" placeholder="e.g. Cologne (separate multiple names with commas)"></div>
        <div class="form-field"><label for="trackEra">Era / section</label><select id="trackEra"><option value="before">Before the first album</option><option value="album">Upcoming album</option></select></div>
        <div class="form-field"><label for="trackYear">Year</label><input id="trackYear" type="number" min="1900" max="2200" placeholder="2026"></div>
        <div class="form-field"><label for="trackDate">Date</label><input id="trackDate" type="date"></div>
        <div class="form-field"><label for="trackLength">Length</label><input id="trackLength" placeholder="2:45"></div>
        <div class="form-field full"><label>Categories (choose any that fit)</label><div class="category-options" id="trackCategoryOptions">
          <label><input type="checkbox" name="trackCategory" value="best"> ⭐ Best</label>
          <label><input type="checkbox" name="trackCategory" value="honorable-mention"> 🥈 Honorable Mention</label>
          <label><input type="checkbox" name="trackCategory" value="classic"> 👑 Classic</label>
          <label><input type="checkbox" name="trackCategory" value="hidden-gem"> 💎 Hidden Gem</label>
          <label><input type="checkbox" name="trackCategory" value="viral"> 📈 Viral</label>
          <label><input type="checkbox" name="trackCategory" value="overrated"> 📉 Overrated</label>
          <label><input type="checkbox" name="trackCategory" value="guilty-pleasure"> 🙈 Guilty Pleasure</label>
          <label><input type="checkbox" name="trackCategory" value="banger"> 🔥 Banger</label>
          <label><input type="checkbox" name="trackCategory" value="chill"> 🌙 Chill</label>
          <label><input type="checkbox" name="trackCategory" value="party"> 🎉 Party</label>
          <label><input type="checkbox" name="trackCategory" value="workout"> 🏋️ Workout</label>
          <label><input type="checkbox" name="trackCategory" value="driving"> 🚗 Driving</label>
          <label><input type="checkbox" name="trackCategory" value="summer"> ☀️ Summer</label>
          <label><input type="checkbox" name="trackCategory" value="dark"> 🖤 Dark</label>
          <label><input type="checkbox" name="trackCategory" value="cinematic"> 🎬 Cinematic</label>
          <label><input type="checkbox" name="trackCategory" value="throwback"> ⏳ Throwback</label>
          <label><input type="checkbox" name="trackCategory" value="motivational"> 💪 Motivational</label>
          <label><input type="checkbox" name="trackCategory" value="emotional"> 💔 Emotional</label>
          <label><input type="checkbox" name="trackCategory" value="love"> 💘 Love Song</label>
          <label><input type="checkbox" name="trackCategory" value="introspective"> 🪞 Introspective</label>
          <label><input type="checkbox" name="trackCategory" value="lyrical"> ✍️ Lyrical</label>
          <label><input type="checkbox" name="trackCategory" value="melodic"> 🎶 Melodic</label>
          <label><input type="checkbox" name="trackCategory" value="storytelling"> 📖 Storytelling</label>
          <label><input type="checkbox" name="trackCategory" value="experimental"> 🧪 Experimental</label>
          <label><input type="checkbox" name="trackCategory" value="funny"> 😂 Funny</label>
          <label><input type="checkbox" name="trackCategory" value="instrumental"> 🎹 Instrumental</label>
          <label><input type="checkbox" name="trackCategory" value="acoustic"> 🎸 Acoustic</label>
          <label><input type="checkbox" name="trackCategory" value="diss"> 🎯 Diss</label>
          <label><input type="checkbox" name="trackCategory" value="freestyle"> 🎤 Freestyle</label>
          <label><input type="checkbox" name="trackCategory" value="collab"> 🤝 Collab</label>
          <label><input type="checkbox" name="trackCategory" value="remix"> 🔁 Remix / Cover</label>
          <label><input type="checkbox" name="trackCategory" value="skit"> 🎙️ Skit / Interlude</label>
          <label><input type="checkbox" name="trackCategory" value="unfinished"> 🚧 Unfinished</label>
          <label><input type="checkbox" name="trackCategory" value="leaked"> 🕵️ Leaked</label>
          <label><input type="checkbox" name="trackCategory" value="snippet"> ✂️ Snippet</label>
          <label><input type="checkbox" name="trackCategory" value="worst"> 🗑️ Worst</label>
          <label><input type="checkbox" name="trackCategory" value="fan-favourite"> 💖 Fan Favourite</label>
        </div></div>
        <div class="form-field"><label for="trackLink">Audio link</label><input id="trackLink" type="url" placeholder="https://..."></div>
        <div class="form-field full"><label for="trackDetails">Details / notes</label><textarea id="trackDetails" placeholder="Extra notes, credits, or other details..."></textarea></div>
        <div class="form-field full"><label for="trackDescription">Song description</label><textarea id="trackDescription" maxlength="2000" placeholder="What is this song about? Add a description that appears in the tracklist..."></textarea></div>
      </div>
      <div class="modal-actions">
        <button class="secondary-btn" type="button" data-close="trackModal">CANCEL</button>
        <button class="primary-btn" type="submit">SAVE TRACK ✦</button>
      </div>
    </form>
  </div>
</div>

<!-- ADMIN CONTROL CENTRE -->
<div class="modal-backdrop" id="adminModal">
  <div class="modal admin-console">
    <div class="admin-topline">
      <div class="eyebrow">CONTROL CENTRE / ADMIN CONSOLE</div>
      <span class="admin-live"><i></i> SESSION ACTIVE</span>
    </div>
    <h2>Your music. Your archive.</h2>
    <p class="modal-desc">Add, edit, duplicate, move or delete tracks, and manage your archive from one place.</p>
    <div class="admin-stats">
      <div class="admin-stat"><b id="statBefore">0</b><span>ARCHIVE</span></div>
      <div class="admin-stat"><b id="statAlbum">0</b><span>ALBUM</span></div>
      <div class="admin-stat"><b id="statLinks">0</b><span>WITH AUDIO</span></div>
      <div class="admin-stat"><b id="statMissing">0</b><span>NO LINK</span></div>
    </div>
    <div class="admin-label">CREATE</div>
    <div class="admin-tools">
      <button class="primary-btn" id="addBeforeButton">＋ BEFORE-ALBUM TRACK</button>
      <button class="primary-btn" id="addAlbumButton">＋ ALBUM TRACK</button>
    </div>
    <div class="admin-label">MANAGE A TRACK</div>
    <input class="field" id="adminTrackSearch" placeholder="⌕  Filter tracks..." style="width:100%;margin-bottom:10px">
    <div class="form-field"><select id="adminTrackPicker"><option value="">Select a track...</option></select></div>
    <div class="admin-actions">
      <button class="admin-chip" id="editTrackButton" type="button"><span>✎</span>EDIT</button>
      <button class="admin-chip" id="duplicateTrackButton" type="button"><span>⧉</span>DUPLICATE</button>
      <button class="admin-chip" id="moveEraButton" type="button"><span>⇄</span>MOVE ERA</button>
      <button class="admin-chip danger" id="deleteTrackButton" type="button"><span>⌫</span>DELETE</button>
    </div>
    <div class="admin-label">UTILITIES</div>
    <div class="admin-actions three">
      <button class="admin-chip" id="adminUpdatesButton" type="button"><span>✦</span>UPDATES</button>
      <button class="admin-chip" id="adminExportButton" type="button"><span>⤓</span>BACKUP</button>
      <button class="admin-chip" id="adminSignOutButton" type="button"><span>⏻</span>SIGN OUT</button>
    </div>
    <div class="modal-actions"><button class="secondary-btn" type="button" data-close="adminModal">CLOSE</button></div>
  </div>
</div>

<!-- SETTINGS -->
<div class="modal-backdrop" id="settingsModal">
  <div class="modal">
    <div class="eyebrow">PERSONALISE / SETTINGS</div>
    <h2>Make it yours.</h2>
    <p class="modal-desc">Small visual tweaks for your JOPPEPOPE TRACKER experience.</p>
    <div class="settings-options">
      <div class="form-field">
        <label for="themeSelect">Accent theme</label>
        <select id="themeSelect">
          <option value="orange">Classic orange</option>
          <option value="purple">Neon purple</option>
          <option value="green">Electric green</option>
        </select>
      </div>
      <div class="form-field">
        <label for="textSizeSelect">Track text size</label>
        <select id="textSizeSelect"><option value="normal">Normal</option><option value="small">Small</option><option value="large">Large</option></select>
      </div>
      <label class="settings-toggle"><input id="motionToggle" type="checkbox"> Reduce animations and transitions</label>
      <label class="settings-toggle"><input id="compactTracksToggle" type="checkbox"> Compact tracklist rows</label>
      <label class="settings-toggle"><input id="showDescriptionsToggle" type="checkbox" checked> Show song descriptions</label>
      <label class="settings-toggle"><input id="showCategoryEmojisToggle" type="checkbox" checked> Show category emojis</label>
      <div class="form-field"><label for="defaultSortSelect">Default sort order</label>
        <select id="defaultSortSelect"><option value="custom">Custom order</option><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="name">A–Z name</option><option value="year">By year</option><option value="shuffle">Shuffle</option></select></div>
      <div class="form-field"><label for="lyricsSizeSelect">Lyrics text size</label>
        <select id="lyricsSizeSelect"><option value="normal">Normal</option><option value="small">Small</option><option value="large">Large</option></select></div>
      <label class="settings-toggle"><input id="autoplayToggle" type="checkbox" checked> Autoplay next track when one ends</label>
      <label class="settings-toggle"><input id="rememberVolumeToggle" type="checkbox" checked> Remember my volume</label>
      <label class="settings-toggle"><input id="hideEffectsToggle" type="checkbox"> Hide background glow and effects</label>
      <label class="settings-toggle"><input id="hideYearToggle" type="checkbox"> Hide the Year column</label>
      <label class="settings-toggle"><input id="hideLengthToggle" type="checkbox"> Hide the Length column</label>
    </div>
    <div class="modal-actions">
      <button class="secondary-btn" type="button" id="resetSettingsButton">RESET</button>
      <button class="primary-btn" type="button" data-close="settingsModal">DONE ✦</button>
    </div>
  </div>
</div>


<!-- SITE UPDATES -->
<div class="modal-backdrop" id="updatesModal">
  <div class="modal">
    <div class="eyebrow">ARCHIVE LOG / LATEST NEWS</div>
    <h2>Updates.</h2>
    <p class="modal-desc">Read the latest changes and announcements. Only admin mode shows the editor.</p>
    <div id="updateAdminTools" class="update-admin-tools" hidden>
      <button class="primary-btn" type="button" id="newUpdateButton">＋ NEW UPDATE</button>
    </div>
    <form id="updateForm" class="update-editor" hidden>
      <input type="hidden" id="updateId">
      <div class="form-field"><label for="updateTitle">Update title</label><input id="updateTitle" maxlength="140" required placeholder="New tracks added"></div>
      <div class="form-field"><label for="updateBody">Update details</label><textarea id="updateBody" maxlength="5000" required placeholder="What changed?"></textarea></div>
      <div class="modal-actions">
        <button class="secondary-btn" type="button" id="cancelUpdateButton">CANCEL</button>
        <button class="primary-btn" type="submit">PUBLISH UPDATE ✦</button>
      </div>
    </form>
    <div id="updatesList" class="updates-list"><div class="empty">Loading updates...</div></div>
    <div class="modal-actions"><button class="primary-btn" type="button" data-close="updatesModal">DONE ✦</button></div>
  </div>
</div>

<div class="context-menu" id="contextMenu">
  <button id="contextEditButton">✎ Edit track</button>
  <button id="contextOpenButton">↗ Open audio link</button>
</div>

<div class="modal-backdrop" id="playlistModal">
  <div class="modal">
    <div class="eyebrow">YOUR MUSIC / PLAYLISTS</div>
    <h2>Your playlists.</h2>
    <p class="modal-desc">Create playlists on this device, add the song playing now, and play tracks in your own order.</p>
    <form id="playlistCreateForm" class="playlist-create">
      <div class="form-field"><label for="playlistName">New playlist name</label><input id="playlistName" maxlength="60" placeholder="Late night ideas..." required></div>
      <button class="primary-btn" type="submit">＋ CREATE</button>
    </form>
    <div id="playlistCollection" class="playlist-collection"><div class="empty">No playlists yet. Create one above.</div></div>
    <div class="modal-actions"><button class="primary-btn" type="button" data-close="playlistModal">DONE ✦</button></div>
  </div>
</div>

<section class="mini-player" id="miniPlayer" aria-label="Now playing">
  <div class="mini-track-info">
    <div class="mini-art" aria-hidden="true">♫</div>
    <div class="mini-track-copy">
      <div class="mini-track-name" id="miniTrackName">Nothing playing</div>
      <div class="mini-track-status" id="miniTrackStatus">JOPPEPOPE PLAYER</div>
    </div>
  </div>
  <div class="mini-controls">
    <button class="mini-control" id="miniPrevious" type="button" title="Previous track" aria-label="Previous track">|◀</button>
    <button class="mini-control primary" id="miniPlayPause" type="button" title="Play" aria-label="Play">▶</button>
    <button class="mini-control" id="miniNext" type="button" title="Next track" aria-label="Next track">▶|</button>
  </div>
  <div class="mini-progress">
    <span class="mini-time" id="miniCurrentTime">0:00</span>
    <input class="mini-seek" id="miniSeek" type="range" min="0" max="100" value="0" aria-label="Seek through track">
    <span class="mini-time" id="miniDuration">0:00</span>
  </div>
  <div class="mini-extra">
    <div style="display:flex;gap:5px;align-items:center">
      <button class="mini-control" id="miniPlaylist" type="button" title="Add to a playlist" aria-label="Open playlists">♫</button>
      <button class="mini-control lyrics-cta" id="miniLyrics" type="button" title="Open lyrics" aria-label="Open lyrics">♪ LYRICS</button>
      <button class="mini-control" id="miniRepeat" type="button" title="Repeat track" aria-label="Repeat track">↻</button>
    </div>
    <label style="display:flex;align-items:center;gap:6px;color:var(--muted);font-size:12px" title="Volume">
      <span aria-hidden="true">♪</span>
      <input class="mini-volume" id="miniVolume" type="range" min="0" max="100" value="80" aria-label="Volume">
    </label>
    <button class="mini-control" id="miniClose" type="button" title="Hide player" aria-label="Hide player">×</button>
  </div>
  <div class="mini-player-error" id="miniPlayerError" role="status" aria-live="polite"></div>
  <iframe class="mini-player-frame" id="whypFrame" title="Whyp audio engine"
    width="1" height="1" scrolling="no" frameborder="0" allow="autoplay"></iframe>
</section>

<!-- LYRICS -->
<div class="modal-backdrop" id="lyricsModal">
  <div class="modal">
    <div class="lyrics-topline"><div class="eyebrow">NOW PLAYING / LYRICS</div><div class="lyrics-eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div></div>
    <h2 id="lyricsModalTitle">Lyrics.</h2>
    <p class="modal-desc" id="lyricsTrackCaption">Lyrics for the current track.</p>
    <p class="lyrics-help" id="lyricsHelp">Lyrics are shared with everyone. Only the authenticated admin account can change them.</p>
    <div class="lyrics-toolbar" style="margin-bottom:12px">
      <button class="secondary-btn" type="button" id="toggleLyricsVisibility">HIDE LYRICS TEXT</button>
      
    </div>
    <div class="lyrics-mode-chip" id="lyricsModeChip"><span class="lyrics-mode-dot"></span><span id="lyricsModeLabel">LYRICS</span></div>
    <div class="lyrics-progress" aria-hidden="true"><span id="lyricsProgressFill"></span></div>
    <div id="lyricsPublicView" class="lyrics-stage" aria-live="polite"><div class="lyrics-empty">Loading lyrics…</div></div>
    <div id="lyricsEditorArea" hidden>
      <div class="form-field full">
        <label for="lyricsText">Lyrics or TTML</label>
        <textarea id="lyricsText" class="lyrics-textarea" maxlength="20000" placeholder="Paste normal lyrics, TTML XML, or timed lyrics here..."></textarea>
        <p class="lyrics-editor-hint">Normal lyrics will be shown as readable text. For automatic syncing, paste TTML with timed &lt;p&gt; lines and optional timed &lt;span&gt; words. TTML timings follow the song playback.</p>
      </div>
    </div>
    <div id="lyricsHiddenNote" class="lyrics-hidden-note">Lyrics text is hidden. Tap “SHOW LYRICS TEXT” to reveal it again.</div>
    <div class="modal-actions">
      <button class="secondary-btn" type="button" id="clearLyricsButton" hidden>CLEAR</button>
      <button class="primary-btn" type="button" id="saveLyricsButton" hidden>SAVE LYRICS ✦</button>
      <button class="primary-btn" type="button" data-close="lyricsModal">DONE</button>
    </div>
  </div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
"use strict";

const SUPABASE_URL = "https://ylgkbggnrymsnyuuvksf.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_akS38WHr22fSNq7JGTNeeA_M6MhVC1y";
// Set this to the email of the admin user you create in Supabase Authentication. This is not a password.
const ADMIN_EMAIL = "jonathan.ks.horn@gmail.com".toLowerCase();
const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const defaultBeforeTracks = [{
  name:"Untitled",aliases:"",year:"",date:"",details:"",description:"",length:"",link:"",
  category:"none",era:"before"
}];

const defaultAlbumTracks = [
  "Money to burn",
  "Next page (I'm on my way)",
  "Untitled",
  "Addicted",
  "Untitled",
  "Untitled",
  "Back Again"
].map((name,index)=>({
  name,aliases:"",year:"",date:"",details:"",description:"",length:"",link:"",
  category:"none",era:"album",album_order:index+1
}));

let tracks=[];
let activeCategory="all";
let isAdmin=false;
let contextTrackId=null;
let toastTimeout;
let scrollFrame=null;
const $=id=>document.getElementById(id);
window.__jp={sb:supabaseClient,isAdmin:()=>isAdmin,tracks:()=>tracks,currentId:()=>currentTrackId,play:id=>playTrackInMiniPlayer(id,true),reload:()=>loadTracks(),catLabel:categoryLabel,edit:id=>openEditTrack(id),del:id=>deleteTrack(id)};

function escapeHTML(value){
  return String(value??"").replace(/[&<>"']/g,char=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
  })[char]);
}
function showToast(message){
  $("toast").textContent=message;
  $("toast").classList.add("show");
  clearTimeout(toastTimeout);
  toastTimeout=setTimeout(()=>$("toast").classList.remove("show"),2800);
}
function openModal(id){$(id).classList.add("open")}
function closeModal(id){$(id).classList.remove("open")}

document.querySelectorAll("[data-close]").forEach(button=>{
  button.addEventListener("click",()=>closeModal(button.dataset.close));
});
document.querySelectorAll(".modal-backdrop").forEach(backdrop=>{
  backdrop.addEventListener("click",event=>{
    if(event.target===backdrop)backdrop.classList.remove("open");
  });
});
document.addEventListener("keydown",event=>{
  if(event.key==="Escape"){
    document.querySelectorAll(".modal-backdrop.open").forEach(modal=>modal.classList.remove("open"));
    $("contextMenu").classList.remove("open");
  }
});

function normalizeCategories(value){
  const valid=["best","honorable-mention","fan-favourite","classic","hidden-gem","viral","overrated","guilty-pleasure","worst","banger","chill","party","workout","driving","summer","dark","cinematic","throwback","motivational","emotional","love","introspective","lyrical","melodic","storytelling","experimental","funny","instrumental","acoustic","diss","freestyle","collab","remix","skit","unfinished","leaked","snippet"];
  const values=Array.isArray(value)?value:String(value??"").split(/[;,|]/);
  return [...new Set(values.map(item=>String(item).trim().toLowerCase()).filter(item=>valid.includes(item)))];
}
function trackCategories(track){return normalizeCategories(track?.category)}
function categoryLabel(category){return category==="best"?"⭐ BEST":category==="honorable-mention"?"🥈 HONORABLE MENTION":category==="classic"?"👑 CLASSIC":category==="hidden-gem"?"💎 HIDDEN GEM":category==="viral"?"📈 VIRAL":category==="overrated"?"📉 OVERRATED":category==="guilty-pleasure"?"🙈 GUILTY PLEASURE":category==="banger"?"🔥 BANGER":category==="chill"?"🌙 CHILL":category==="party"?"🎉 PARTY":category==="workout"?"🏋️ WORKOUT":category==="driving"?"🚗 DRIVING":category==="summer"?"☀️ SUMMER":category==="dark"?"🖤 DARK":category==="cinematic"?"🎬 CINEMATIC":category==="throwback"?"⏳ THROWBACK":category==="motivational"?"💪 MOTIVATIONAL":category==="emotional"?"💔 EMOTIONAL":category==="love"?"💘 LOVE SONG":category==="introspective"?"🪞 INTROSPECTIVE":category==="lyrical"?"✍️ LYRICAL":category==="melodic"?"🎶 MELODIC":category==="storytelling"?"📖 STORYTELLING":category==="experimental"?"🧪 EXPERIMENTAL":category==="funny"?"😂 FUNNY":category==="instrumental"?"🎹 INSTRUMENTAL":category==="acoustic"?"🎸 ACOUSTIC":category==="diss"?"🎯 DISS":category==="freestyle"?"🎤 FREESTYLE":category==="collab"?"🤝 COLLAB":category==="remix"?"🔁 REMIX / COVER":category==="skit"?"🎙️ SKIT / INTERLUDE":category==="unfinished"?"🚧 UNFINISHED":category==="leaked"?"🕵️ LEAKED":category==="snippet"?"✂️ SNIPPET":category==="worst"?"🗑️ WORST":category==="fan-favourite"?"💖 FAN FAVOURITE":category.toUpperCase()}
function setCategoryCheckboxes(value){
  const chosen=new Set(normalizeCategories(value));
  document.querySelectorAll('input[name="trackCategory"]').forEach(input=>{input.checked=chosen.has(input.value)});
}
function selectedCategories(){return [...document.querySelectorAll('input[name="trackCategory"]:checked')].map(input=>input.value).join(",")||"none"}

function cleanTrack(row){
  return {
    id:row.id??null,name:row.name||"Untitled",aliases:row.aliases||"",
    year:row.year??"",date:row.date||"",details:row.details||"",description:row.description||"",
    length:row.length||"",link:row.link||"",
    category:normalizeCategories(row.category).join(",")||"none",
    era:row.era==="album"?"album":"before",
    album_order:Number(row.album_order)||null,
    created_at:row.created_at||"",
    sort_order:row.sort_order==null?null:Number(row.sort_order)
  };
}
function trackPayload(track){
  const payload={
    name:track.name||"Untitled",aliases:track.aliases||"",
    year:track.year===""||track.year==null?null:Number(track.year),
    date:track.date||null,details:track.details||"",description:track.description||"",
    length:track.length||"",link:track.link||"",
    category:track.category||"none",
    era:track.era==="album"?"album":"before"
  };
  if(payload.era==="album")payload.album_order=Number(track.album_order)||null;
  return payload;
}
async function writeWithSchemaFallback(operation){
  let result=await operation(true);
  if(result.error&&/album_order|column/i.test(result.error.message||""))result=await operation(false);
  return result;
}
async function insertDefaults(defaults){
  const payloads=defaults.map(trackPayload);
  let result=await supabaseClient.from("tracks").insert(payloads);
  if(result.error&&/album_order|column/i.test(result.error.message||"")){
    result=await supabaseClient.from("tracks").insert(payloads.map(({album_order,...rest})=>rest));
  }
  if(result.error){console.error("Could not insert starter tracks:",result.error);return false}
  return true;
}

async function loadTracks(){
  $("trackTable").innerHTML='<tr><td colspan="5" class="empty">Connecting to the archive...</td></tr>';
  $("albumList").innerHTML='<div class="empty">Loading album tracks...</div>';
  const {data,error}=await supabaseClient.from("tracks").select("*");
  if(error){
    console.error(error);
    $("trackTable").innerHTML='<tr><td colspan="5" class="empty">Could not load tracks. Check Supabase settings and permissions.</td></tr>';
    $("albumList").innerHTML='<div class="empty">Could not load the album tracklist.</div>';
    showToast("Could not connect to the shared database.");
    return;
  }
  let rows=data||[];
  if(!rows.some(row=>row.era==="before"))await insertDefaults(defaultBeforeTracks);
  if(!rows.some(row=>row.era==="album"))await insertDefaults(defaultAlbumTracks);
  const refreshed=await supabaseClient.from("tracks").select("*");
  if(refreshed.error){console.error(refreshed.error);tracks=rows.map(cleanTrack)}
  else tracks=(refreshed.data||[]).map(cleanTrack);
  renderAll();
}

function renderAll(){if(!shuffledBeforeIds.length||!shuffledPlaybackIds.length)refreshShuffleOrders();renderTracks();renderAlbum();renderAdminPicker()}

let shuffledBeforeIds=[];
let shuffledPlaybackIds=[];
function shuffleIds(ids){
  const result=[...ids];
  for(let i=result.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[result[i],result[j]]=[result[j],result[i]];}
  return result;
}
function shuffleOrderIndex(id){const index=shuffledBeforeIds.indexOf(String(id));return index<0?Number.MAX_SAFE_INTEGER:index}
function refreshShuffleOrders(){
  shuffledBeforeIds=shuffleIds(tracks.filter(track=>track.era==="before").map(track=>String(track.id)));
  shuffledPlaybackIds=shuffleIds(tracks.filter(track=>track.link&&String(track.link).trim()).map(track=>String(track.id)));
}

function getBeforeTracks(){
  const search=$("searchInput").value.trim().toLowerCase();
  const selectedYear=$("yearFilter").value;
  let result=tracks.filter(track=>track.era==="before");
  if(activeCategory!=="all")result=result.filter(track=>trackCategories(track).includes(activeCategory));
  if(selectedYear!=="all")result=result.filter(track=>String(track.year)===selectedYear);
  if(search)result=result.filter(track=>
    [track.name,track.aliases,track.year,track.description,track.details,track.length,trackCategories(track).join(" ")].join(" ").toLowerCase().includes(search)
  );
  const sort=$("sortSelect").value;
  if(sort==="name")result.sort((a,b)=>a.name.localeCompare(b.name));
  else if(sort==="year")result.sort((a,b)=>Number(a.year||0)-Number(b.year||0));
  else if(sort==="oldest")result.sort((a,b)=>String(a.date||a.created_at||"").localeCompare(String(b.date||b.created_at||"")));
  else if(sort==="custom")result.sort((a,b)=>(a.sort_order==null?1e15:a.sort_order)-(b.sort_order==null?1e15:b.sort_order)||String(b.date||b.created_at||"").localeCompare(String(a.date||a.created_at||"")));
  else if(sort==="shuffle")result.sort((a,b)=>shuffleOrderIndex(a.id)-shuffleOrderIndex(b.id));
  else result.sort((a,b)=>String(b.date||b.created_at||"").localeCompare(String(a.date||a.created_at||"")));
  return result;
}

function updateFilterControls(){
  const before=tracks.filter(track=>track.era==="before");
  const years=[...new Set(before.map(track=>String(track.year||"").trim()).filter(Boolean))].sort((a,b)=>Number(b)-Number(a));
  const yearSelect=$("yearFilter");
  const selected=yearSelect.value||"all";
  const options=['<option value="all">ALL YEARS</option>',...years.map(year=>`<option value="${escapeHTML(year)}">${escapeHTML(year)}</option>`)];
  yearSelect.innerHTML=options.join("");
  yearSelect.value=years.includes(selected)?selected:"all";

  $("countAll").textContent=before.length;
  $("countBest").textContent=before.filter(track=>trackCategories(track).includes("best")).length;
  $("countWorst").textContent=before.filter(track=>trackCategories(track).includes("worst")).length;
  $("countFanFavourite").textContent=before.filter(track=>trackCategories(track).includes("fan-favourite")).length;
  const visible=getBeforeTracks();
  const hasFilters=Boolean($("searchInput").value.trim())||activeCategory!=="all"||yearSelect.value!=="all";
  $("filterStatus").textContent=hasFilters
    ? `Showing ${visible.length} of ${before.length} tracks${activeCategory!=="all"?" · "+activeCategory.replace(/-/g," ").toUpperCase():""}${yearSelect.value!=="all"?" · "+yearSelect.value:""}`
    : `Showing all ${before.length} archive ${before.length===1?"track":"tracks"}`;
}

function categoryEmoji(track){
  const categories=trackCategories(track);
  if(categories.includes("fan-favourite"))return "💖";
  if(categories.includes("best"))return "⭐";
  if(categories.includes("honorable-mention"))return "🥈";
  if(categories.includes("classic"))return "👑";
  if(categories.includes("hidden-gem"))return "💎";
  if(categories.includes("viral"))return "📈";
  if(categories.includes("overrated"))return "📉";
  if(categories.includes("guilty-pleasure"))return "🙈";
  if(categories.includes("banger"))return "🔥";
  if(categories.includes("chill"))return "🌙";
  if(categories.includes("party"))return "🎉";
  if(categories.includes("workout"))return "🏋️";
  if(categories.includes("driving"))return "🚗";
  if(categories.includes("summer"))return "☀️";
  if(categories.includes("dark"))return "🖤";
  if(categories.includes("cinematic"))return "🎬";
  if(categories.includes("throwback"))return "⏳";
  if(categories.includes("motivational"))return "💪";
  if(categories.includes("emotional"))return "💔";
  if(categories.includes("love"))return "💘";
  if(categories.includes("introspective"))return "🪞";
  if(categories.includes("lyrical"))return "✍️";
  if(categories.includes("melodic"))return "🎶";
  if(categories.includes("storytelling"))return "📖";
  if(categories.includes("experimental"))return "🧪";
  if(categories.includes("funny"))return "😂";
  if(categories.includes("instrumental"))return "🎹";
  if(categories.includes("acoustic"))return "🎸";
  if(categories.includes("diss"))return "🎯";
  if(categories.includes("freestyle"))return "🎤";
  if(categories.includes("collab"))return "🤝";
  if(categories.includes("remix"))return "🔁";
  if(categories.includes("skit"))return "🎙️";
  if(categories.includes("unfinished"))return "🚧";
  if(categories.includes("leaked"))return "🕵️";
  if(categories.includes("snippet"))return "✂️";
  if(categories.includes("worst"))return "🗑️";
  return "♫";
}
function renderTracks(){
  const tbody=$("trackTable");
  const before=tracks.filter(track=>track.era==="before");
  updateFilterControls();
  const visible=getBeforeTracks();
  $("beforeCount").textContent=before.length+(before.length===1?" TRACK":" TRACKS");
  if(!visible.length){
    tbody.innerHTML='<tr><td colspan="5" class="empty">No tracks found. Try changing your search or filters.</td></tr>';
    return;
  }
  tbody.innerHTML=visible.map((track,index)=>`
    <tr data-track-id="${escapeHTML(track.id)}" title="${isAdmin?"Double-click to edit":""}" style="animation-delay:${Math.min(index*30,240)}ms">
      <td><div class="track-name-line"><span class="track-category-emoji" title="Track marker">${categoryEmoji(track)}</span><div class="track-name">${escapeHTML(track.name)}</div>
        ${track.link?`<button class="icon-play-btn" type="button" data-action="play" data-id="${escapeHTML(track.id)}" title="${String(track.id)===String(currentTrackId)&&isPlaying?"Pause track":"Play track"}" aria-label="${String(track.id)===String(currentTrackId)&&isPlaying?"Pause":"Play"} ${escapeHTML(track.name)}">${String(track.id)===String(currentTrackId)&&isPlaying?"Ⅱ":"▶"}</button>`:""}
      </div>
        ${track.aliases?`<div class="track-aliases">Also known as: ${escapeHTML(track.aliases)}</div>`:""}
        ${track.description?`<div class="track-description">${escapeHTML(track.description)}</div>`:""}
        ${String(track.id)===String(currentTrackId)&&isPlaying?'<span class="playing-now" title="Playing now" aria-label="Playing now">♫</span>':""}
      </td>
      <td>${escapeHTML(track.year||"—")}</td>
      <td>${escapeHTML(track.length||"—")}</td>
      <td>${trackCategories(track).length?trackCategories(track).map(category=>`<span class="pill" style="display:inline-block;margin:2px">${categoryLabel(category)}</span>`).join(""):"—"}</td>
      <td>${track.details?`<div class="track-details-text">${escapeHTML(track.details)}</div>`:"—"}</td>
    </tr>`).join("");
}
function updateTrackPlaybackIndicators(){
  document.body.classList.toggle("is-playing",Boolean(isPlaying));
  document.querySelectorAll("#trackTable [data-action='play'],#albumList [data-action='play']").forEach(button=>{
    const active=String(button.dataset.id)===String(currentTrackId)&&isPlaying;
    button.textContent=active?"Ⅱ":"▶";
    button.title=active?"Pause track":"Play track";
    button.setAttribute("aria-label",active?"Pause track":"Play track");
  });
  document.querySelectorAll("#trackTable tr[data-track-id],#albumList .album-track[data-track-id]").forEach(item=>{
    const active=String(item.dataset.trackId)===String(currentTrackId)&&isPlaying;
    const existing=item.querySelector(".playing-now");
    if(active&&!existing){
      const name=item.querySelector(".track-name-line,.album-song");
      if(name)name.insertAdjacentHTML("afterend",'<span class="playing-now" title="Playing now" aria-label="Playing now">♫</span>');
    }else if(!active&&existing)existing.remove();
  });
}
function getAlbumTracks(){
  return tracks.filter(track=>track.era==="album").sort((a,b)=>{
    const orderA=Number(a.album_order||999),orderB=Number(b.album_order||999);
    if(orderA!==orderB)return orderA-orderB;
    return String(a.created_at||"").localeCompare(String(b.created_at||""));
  });
}
function renderAlbum(){
  const list=$("albumList"),album=getAlbumTracks();
  $("albumCount").textContent=album.length+(album.length===1?" TRACK":" TRACKS");
  if(!album.length){list.innerHTML='<div class="empty">No album tracks yet. Add some in admin.</div>';return}
  list.innerHTML=album.map((track,index)=>{
    const untitled=track.name.trim().toLowerCase()==="untitled";
    const subtitle=untitled?"TITLE TO BE ANNOUNCED":"UPCOMING ALBUM TRACK";
    return `<div class="album-track" data-track-id="${escapeHTML(track.id)}" style="animation-delay:${Math.min(index*65,390)}ms">
      <div class="album-number">${String(index+1).padStart(2,"0")}</div>
      <div><div class="album-song"><span class="track-category-emoji">${categoryEmoji(track)}</span> ${escapeHTML(track.name)} ${String(track.id)===String(currentTrackId)&&isPlaying?'<span class="playing-now" title="Playing now" aria-label="Playing now">♫</span>':""}</div>
        <div class="album-subtitle">${subtitle}</div>
        ${track.aliases?`<div class="track-aliases">Also known as: ${escapeHTML(track.aliases)}</div>`:""}
        ${track.description?`<div class="album-description">${escapeHTML(track.description)}</div>`:""}
        ${track.details?`<div class="album-details">${escapeHTML(track.details)}</div>`:""}
      </div>
      <div class="album-actions">
        ${track.link?`<button class="icon-play-btn" type="button" data-action="play" data-id="${escapeHTML(track.id)}" title="${String(track.id)===String(currentTrackId)&&isPlaying?"Pause track":"Play track"}" aria-label="${String(track.id)===String(currentTrackId)&&isPlaying?"Pause":"Play"} ${escapeHTML(track.name)}">${String(track.id)===String(currentTrackId)&&isPlaying?"Ⅱ":"▶"}</button>`:""}
        ${isAdmin?`<button data-action="edit" data-id="${escapeHTML(track.id)}">✎ EDIT</button>`:""}
      </div>
    </div>`;
  }).join("");
}
function renderAdminPicker(){
  const picker=$("adminTrackPicker"),previous=picker.value;
  const q=($("adminTrackSearch").value||"").trim().toLowerCase();
  const match=t=>!q||(t.name+" "+t.aliases).toLowerCase().includes(q);
  const allBefore=tracks.filter(t=>t.era==="before"),album=getAlbumTracks();
  const before=allBefore.filter(match).sort((a,b)=>a.name.localeCompare(b.name));
  $("statBefore").textContent=allBefore.length;
  $("statAlbum").textContent=album.length;
  const withLink=tracks.filter(t=>t.link&&t.link.trim()).length;
  $("statLinks").textContent=withLink;
  $("statMissing").textContent=tracks.length-withLink;
  picker.innerHTML='<option value="">Select a track...</option>'+
    before.map(t=>`<option value="${escapeHTML(t.id)}">🟠 BEFORE — ${escapeHTML(t.name)}</option>`).join("")+
    album.map((t,i)=>match(t)?`<option value="${escapeHTML(t.id)}">🔵 ALBUM ${String(i+1).padStart(2,"0")} — ${escapeHTML(t.name)}</option>`:"").join("");
  if(tracks.some(t=>String(t.id)===previous))picker.value=previous;
}
function findTrack(id){return tracks.find(track=>String(track.id)===String(id))}

/* Whyp-powered fixed mini-player */
let currentPlayer = null;
let currentPlayerReady = false;
let currentTrackId = null;
let isPlaying = false;
let repeatCurrent = false;
let playerLoadSerial = 0;
let playerReadyTimer = null;
let currentPlayerSeconds = 0;
let lyricsSyncLines = [];
let lyricsIsSynced = false;
let lyricsPlainText = "";

function loadPlaylists(){
  try{const data=JSON.parse(localStorage.getItem("joppepope-playlists")||"[]");return Array.isArray(data)?data.filter(item=>item&&typeof item.name==="string"&&Array.isArray(item.trackIds)).map(item=>({id:String(item.id||item.name),name:item.name,trackIds:item.trackIds.map(String)})):[]}catch{return []}
}
let playlists=loadPlaylists();
let playlistQueueIds=null;
function savePlaylists(){try{localStorage.setItem("joppepope-playlists",JSON.stringify(playlists))}catch{showToast("Could not save playlists in this browser.")}}

function playerTime(seconds) {
  if (!Number.isFinite(seconds) || seconds < 0) return "0:00";
  const value = Math.floor(seconds);
  return Math.floor(value / 60) + ":" + String(value % 60).padStart(2, "0");
}
function playableTracks() {
  const list=tracks.filter(track=>track.link&&String(track.link).trim());
  if($("sortSelect")?.value==="shuffle"&&shuffledPlaybackIds.length){
    return list.sort((a,b)=>shuffledPlaybackIds.indexOf(String(a.id))-shuffledPlaybackIds.indexOf(String(b.id)));
  }
  const has=t=>t.link&&String(t.link).trim();
  const ord=getBeforeTracks().filter(has).concat(getAlbumTracks().filter(has));
  if(currentTrackId!=null&&!ord.some(t=>String(t.id)===String(currentTrackId)))return list;
  return ord;
}
function whypEmbedUrl(rawLink) {
  try {
    const url = new URL(String(rawLink).trim());
    if (url.protocol !== "https:" || !/(^|\.)whyp\.it$/i.test(url.hostname)) return null;

    let id = "";
    const embedMatch = url.pathname.match(/^\/embeds\/track\/([A-Za-z0-9_-]+)/i);
    const trackMatch = url.pathname.match(/^\/tracks\/.*-([A-Za-z0-9]{8,})\/?$/i);

    if (embedMatch) id = embedMatch[1];
    else if (trackMatch) id = trackMatch[1];
    else return null;

    const embed = new URL("https://whyp.it/embeds/track/" + id);
    const token = url.searchParams.get("token");
    if (token) embed.searchParams.set("token", token);
    return embed.href;
  } catch { return null; }
}
function updateMiniButtons() {
  $("miniPlayPause").textContent = isPlaying ? "Ⅱ" : "▶";
  $("miniPlayPause").title = isPlaying ? "Pause" : "Play";
  $("miniPlayPause").setAttribute("aria-label", isPlaying ? "Pause" : "Play");
  $("miniRepeat").classList.toggle("active", repeatCurrent);
}
function miniStatus(message) { $("miniTrackStatus").textContent = message; }
function miniError(message) {
  const element = $("miniPlayerError");
  element.textContent = message;
  element.style.display = "block";
}
function clearMiniError() {
  const element = $("miniPlayerError");
  element.textContent = "";
  element.style.display = "none";
}
function attachWhypPlayer(serial, autoplay) {
  if (serial !== playerLoadSerial) return;
  if (!window.playerjs || !window.playerjs.Player) {
    miniError("Whyp controls could not load. Check your connection and refresh.");
    return;
  }

  const frame = $("whypFrame");
  currentPlayer = new window.playerjs.Player(frame);
  currentPlayerReady = false;
  clearTimeout(playerReadyTimer);

  playerReadyTimer = setTimeout(() => {
    if (serial === playerLoadSerial && !currentPlayerReady) {
      miniError("Whyp did not respond. Check the track URL and its embed permissions.");
    }
  }, 15000);

  currentPlayer.on("ready", () => {
    if (serial !== playerLoadSerial) return;
    currentPlayerReady = true;
    clearTimeout(playerReadyTimer);
    clearMiniError();
    currentPlayer.setVolume(Number($("miniVolume").value));
    currentPlayer.setLoop(repeatCurrent);
    miniStatus("READY");

    currentPlayer.on("play", () => {
      if (serial !== playerLoadSerial) return;
      isPlaying = true;
      miniStatus("NOW PLAYING");
      updateMiniButtons();
      updateTrackPlaybackIndicators();
    });
    currentPlayer.on("pause", () => {
      if (serial !== playerLoadSerial) return;
      isPlaying = false;
      miniStatus("PAUSED");
      updateMiniButtons();
      updateTrackPlaybackIndicators();
    });
    currentPlayer.on("timeupdate", data => {
      if (serial !== playerLoadSerial) return;
      const seconds = Number(data && data.seconds) || 0;
      const duration = Number(data && data.duration) || 0;
      currentPlayerSeconds = seconds;
      updateSyncedLyrics(seconds);
      $("miniCurrentTime").textContent = playerTime(seconds);
      $("miniDuration").textContent = playerTime(duration);
      $("miniSeek").max = String(Math.max(1, duration));
      $("miniSeek").value = String(Math.min(seconds, duration || seconds));
      const progress = duration ? Math.min(100, seconds / duration * 100) : 0;
      $("miniSeek").style.setProperty("--progress", progress + "%");
      const lpf = $("lyricsProgressFill"); if (lpf) lpf.style.width = progress + "%";
    });
    currentPlayer.on("ended", () => {
      if (serial !== playerLoadSerial) return;
      if (repeatCurrent) {
        currentPlayer.setCurrentTime(0);
        currentPlayer.play();
      } else if (extraSettings.autoplayNext) {
        playAdjacentTrack(1, true);
      }
    });
    currentPlayer.on("error", () => {
      if (serial === playerLoadSerial) miniError("Whyp couldn't play this track. Check its link and embed settings.");
    });

    if (autoplay) currentPlayer.play();
    else { isPlaying = false; updateMiniButtons(); }
  });
}
function playTrackInMiniPlayer(id, autoplay = true) {
  const track = findTrack(id);
  if (!track || !track.link) {
    showToast("This track doesn't have an audio link yet.");
    return;
  }
  const embedUrl = whypEmbedUrl(track.link);
  if (!embedUrl) {
    showToast("Use a valid Whyp track URL in the admin link field.");
    return;
  }

  const sameTrack = String(currentTrackId) === String(track.id);
  $("miniPlayer").classList.add("visible");
  $("miniTrackName").textContent = track.name || "Untitled";
  $("miniTrackName").title = track.name || "Untitled";
  clearMiniError();

  if (sameTrack && currentPlayerReady && currentPlayer) {
    if (autoplay) currentPlayer.play();
    return;
  }

  currentTrackId = track.id;
  playlistQueueIds=playlistQueueIds&&playlistQueueIds.includes(String(track.id))?playlistQueueIds:null;
  updateTrackPlaybackIndicators();
  currentPlayer = null;
  currentPlayerReady = false;
  isPlaying = false;
  updateTrackPlaybackIndicators();
  currentPlayerSeconds = 0;
  $("miniCurrentTime").textContent = "0:00";
  $("miniDuration").textContent = track.length || "0:00";
  $("miniSeek").value = "0";
  $("miniSeek").style.setProperty("--progress", "0%");
  miniStatus("CONNECTING TO WHYP…");
  updateMiniButtons();

  const serial = ++playerLoadSerial;
  clearTimeout(playerReadyTimer);
  const frame = $("whypFrame");
  frame.onload = () => attachWhypPlayer(serial, autoplay);
  frame.src = embedUrl;
}
function playAdjacentTrack(direction, autoplay = true) {
  let list=playableTracks();
  if(playlistQueueIds&&playlistQueueIds.includes(String(currentTrackId))){
    list=playlistQueueIds.map(id=>findTrack(id)).filter(track=>track&&track.link&&String(track.link).trim());
  }
  if (!list.length) { showToast("No tracks with audio links yet."); return; }
  let index = list.findIndex(track => String(track.id) === String(currentTrackId));
  if (index < 0) index = direction > 0 ? -1 : 0;
  const nextIndex = (index + direction + list.length) % list.length;
  playTrackInMiniPlayer(list[nextIndex].id, autoplay);
}
function toggleMiniPlayback() {
  if (!currentTrackId) {
    const first = playableTracks()[0];
    if (first) playTrackInMiniPlayer(first.id, true);
    else showToast("Add a Whyp audio link to a track first.");
    return;
  }
  if (!currentPlayer || !currentPlayerReady) {
    showToast("The player is still connecting to Whyp.");
    return;
  }
  if (isPlaying) currentPlayer.pause();
  else currentPlayer.play();
}


/* Existing PLAY/LISTEN buttons now use the fixed bottom player. */
function openAudio(id) { playTrackInMiniPlayer(id, true); }

$("miniPlayPause").addEventListener("click", toggleMiniPlayback);
$("miniPrevious").addEventListener("click", () => playAdjacentTrack(-1, true));
$("miniNext").addEventListener("click", () => playAdjacentTrack(1, true));
$("miniPlaylist").addEventListener("click",()=>{renderPlaylists();openModal("playlistModal")});
let lyricsTextHidden = false;
let currentLyricsTrackKey = null;
function lyricsKey(track){
  return String(track && track.id != null ? track.id : (track && track.name || "unknown"));
}
function parseLyricTime(value){
  if(value==null||value==="")return null;
  const raw=String(value).trim();
  if(/^\d+(?:\.\d+)?s$/i.test(raw))return parseFloat(raw);
  const clock=raw.match(/^(?:(\d+):)?(\d{1,2}):(\d{2}(?:\.\d+)?)$/);
  if(clock)return (Number(clock[1]||0)*3600)+(Number(clock[2]||0)*60)+Number(clock[3]);
  const ms=raw.match(/^(\d+(?:\.\d+)?)ms$/i);
  if(ms)return Number(ms[1])/1000;
  return null;
}
function getTimedText(element,parentStart=0){
  const words=[];
  const walk=node=>{
    if(node.nodeType===Node.TEXT_NODE){
      const text=node.nodeValue||"";
      if(text)words.push({text,start:null,end:null});
      return;
    }
    if(node.nodeType!==Node.ELEMENT_NODE)return;
    const begin=parseLyricTime(node.getAttribute("begin"));
    const end=parseLyricTime(node.getAttribute("end"));
    const dur=parseLyricTime(node.getAttribute("dur"));
    const start=begin==null?parentStart:parentStart+begin;
    const finish=end!=null?parentStart+end:(dur!=null?start+dur:null);
    const before=words.length;
    Array.from(node.childNodes).forEach(walk);
    if(words.length>before && (begin!=null||end!=null||dur!=null)){
      for(let i=before;i<words.length;i++){
        if(words[i].start==null)words[i].start=start;
        if(words[i].end==null)words[i].end=finish;
      }
    }
  };
  Array.from(element.childNodes).forEach(walk);
  return words;
}
function parseTTML(raw){
  if(!/<(?:\w+:)?tt\b|<(?:\w+:)?p\b[^>]*(?:begin|end|dur)=/i.test(raw))return null;
  try{
    const doc=new DOMParser().parseFromString(raw,"application/xml");
    if(doc.querySelector("parsererror"))return null;
    let nodes=Array.from(doc.getElementsByTagNameNS("*","p"));
    if(!nodes.length)nodes=Array.from(doc.getElementsByTagName("p"));
    const lines=[];
    nodes.forEach(node=>{
      const begin=parseLyricTime(node.getAttribute("begin"));
      const end=parseLyricTime(node.getAttribute("end"));
      const dur=parseLyricTime(node.getAttribute("dur"));
      const text=(node.textContent||"").replace(/\s+/g," ").trim();
      if(!text)return;
      const start=begin==null?null:begin;
      const finish=end!=null?end:(start!=null&&dur!=null?start+dur:null);
      const words=getTimedText(node,start||0).filter(word=>word.text);
      lines.push({text,start,end:finish,words});
    });
    return lines.length?lines:null;
  }catch{return null}
}
function parseLRC(raw){
  const lines=[];
  for(const sourceLine of raw.split(/\r?\n/)){
    const matches=[...sourceLine.matchAll(/\[(\d{1,2}):(\d{2}(?:\.\d{1,3})?)\]/g)];
    const text=sourceLine.replace(/(?:\[\d{1,2}:\d{2}(?:\.\d{1,3})?\])+/g,"").trim();
    if(!matches.length||!text)continue;
    matches.forEach(match=>lines.push({text,start:Number(match[1])*60+Number(match[2]),end:null,words:[]}));
  }
  if(!lines.length)return null;
  lines.sort((a,b)=>a.start-b.start);
  lines.forEach((line,index)=>{if(line.end==null)line.end=lines[index+1]?.start??null});
  return lines;
}
function renderLyrics(raw){
  const view=$("lyricsPublicView");
  lyricsSyncLines=[];
  lyricsIsSynced=false;
  lyricsPlainText=String(raw||"");
  view.classList.remove("plain-lyrics");
  view.innerHTML="";
  if(!raw.trim()){
    $("lyricsModeLabel").textContent="LYRICS NOT ADDED";
    view.innerHTML='<div class="lyrics-empty">No lyrics have been added for this track yet.</div>';
    return;
  }
  let timed=parseTTML(raw);
  if(!timed)timed=parseLRC(raw);
  if(timed){
    lyricsIsSynced=true;
    lyricsSyncLines=timed;
    $("lyricsModeLabel").textContent="SYNCED LYRICS";
    view.innerHTML=timed.map((line,index)=>{
      const words=line.words?.length?line.words.map(word=>{
        const hasTime=word.start!=null||word.end!=null;
        return `<span class="lyric-word"${hasTime?` data-word-start="${word.start==null?"":word.start}" data-word-end="${word.end==null?"":word.end}"`:""}>${escapeHTML(word.text)}</span>`;
      }).join(""):escapeHTML(line.text);
      return `<div class="lyrics-line" data-lyrics-line-index="${index}"${line.start!=null?` data-line-start="${line.start}"`:""}>${words}</div>`;
    }).join("");
    updateSyncedLyrics(currentPlayerSeconds,true);
  }else{
    $("lyricsModeLabel").textContent="LYRICS";
    view.classList.add("plain-lyrics");
    // Plain lyrics remain readable, with line breaks preserved and no fake syncing.
    view.innerHTML=raw.split(/\r?\n/).map(line=>`<div class="lyrics-line">${line.trim()?escapeHTML(line):"&nbsp;"}</div>`).join("");
  }
}
function updateSyncedLyrics(seconds,forceScroll=false){
  if(!lyricsIsSynced||!lyricsSyncLines.length||$("lyricsModal").classList.contains("open")===false)return;
  let active=-1;
  for(let i=0;i<lyricsSyncLines.length;i++){
    const line=lyricsSyncLines[i];
    if(line.start!=null&&seconds>=line.start&&(line.end==null||seconds<line.end))active=i;
    else if(line.start!=null&&seconds>=line.start)active=i;
  }
  const elements=$("lyricsPublicView").querySelectorAll("[data-lyrics-line-index]");
  elements.forEach((element,index)=>{
    element.classList.toggle("is-active",index===active);
    element.classList.toggle("is-near",active>=0&&Math.abs(index-active)<=1&&index!==active);
    element.querySelectorAll(".lyric-word").forEach(word=>{
      const start=Number(word.dataset.wordStart);
      const end=Number(word.dataset.wordEnd);
      const hasStart=word.dataset.wordStart!=="";
      const hasEnd=word.dataset.wordEnd!=="";
      const hasTiming=hasStart||hasEnd;
      const isCurrent=hasTiming&&hasStart&&seconds>=start&&(!hasEnd||seconds<end);
      const isSung=hasTiming&&hasEnd&&seconds>=end;
      word.classList.toggle("is-current",isCurrent);
      word.classList.toggle("is-sung",isSung);
    });
  });
  if(active>=0){
    const current=elements[active];
    if(current&&(forceScroll||!current.classList.contains("was-active"))){
      current.scrollIntoView({behavior:document.body.classList.contains("reduce-motion")?"auto":"smooth",block:"center"});
    }
    elements.forEach(el=>el.classList.remove("was-active"));
    if(current)current.classList.add("was-active");
  }
}
async function openLyrics(){
  const track=findTrack(currentTrackId);
  if(!track){showToast("Play a track first to open its lyrics.");return}
  currentLyricsTrackKey=lyricsKey(track);
  $("lyricsModalTitle").textContent=(track.name||"Untitled")+" — Lyrics";
  $("lyricsTrackCaption").textContent="Lyrics for "+(track.name||"Untitled")+".";
  $("lyricsPublicView").innerHTML='<div class="lyrics-empty">Loading lyrics…</div>';
  $("lyricsText").value="";
  lyricsTextHidden=false;
  $("lyricsPublicView").style.display="";
  $("lyricsHiddenNote").classList.remove("visible");
  $("toggleLyricsVisibility").textContent="HIDE LYRICS TEXT";
  const canEdit=isAdmin;
  $("lyricsEditorArea").hidden=!canEdit;
  $("saveLyricsButton").hidden=!canEdit;
  $("clearLyricsButton").hidden=!canEdit;
  $("lyricsHelp").textContent=canEdit?"Admin mode: paste normal lyrics for a clean reading view, or TTML/LRC for automatic syncing. Saved lyrics are shared with everyone.":"Lyrics for everyone to read. Timed files sync to the player when available.";
  openModal("lyricsModal");
  const {data,error}=await supabaseClient.from("track_lyrics").select("lyrics").eq("track_id",currentLyricsTrackKey).maybeSingle();
  if(error){$("lyricsPublicView").innerHTML='<div class="lyrics-empty">Could not load shared lyrics. Please check the Supabase setup.</div>';showToast("Could not load shared lyrics.");return}
  const lyrics=String(data?.lyrics||"");
  renderLyrics(lyrics);
  if(canEdit) $("lyricsText").value=lyrics;
}
$("miniLyrics").addEventListener("click",openLyrics);
$("toggleLyricsVisibility").addEventListener("click",()=>{
  lyricsTextHidden=!lyricsTextHidden;
  $("lyricsPublicView").style.display=lyricsTextHidden?"none":"";
  if(!$("lyricsEditorArea").hidden) $("lyricsEditorArea").style.display=lyricsTextHidden?"none":"";
  $("lyricsHiddenNote").classList.toggle("visible",lyricsTextHidden);
  $("toggleLyricsVisibility").textContent=lyricsTextHidden?"SHOW LYRICS TEXT":"HIDE LYRICS TEXT";
});
$("saveLyricsButton").addEventListener("click",async()=>{
  const track=findTrack(currentTrackId);
  if(!track)return showToast("Play a track first to save lyrics.");
  if(!isAdmin)return showToast("Only the admin can change shared lyrics.");
  const lyrics=$("lyricsText").value;
  const {error}=await supabaseClient.from("track_lyrics").upsert({track_id:lyricsKey(track),lyrics,updated_at:new Date().toISOString()},{onConflict:"track_id"});
  if(error){showToast("Could not save shared lyrics. Check the admin account and Supabase SQL setup.");return}
  renderLyrics(lyrics);
  showToast("Shared lyrics saved for "+(track.name||"this track")+" ✦");
});
$("clearLyricsButton").addEventListener("click",()=>{if(isAdmin) $("lyricsText").value="";});

function renderPlaylists(){
  const root=$("playlistCollection");
  if(!playlists.length){root.innerHTML='<div class="empty">No playlists yet. Create one above.</div>';return}
  root.innerHTML=playlists.map(playlist=>{
    const songTracks=playlist.trackIds.map(id=>findTrack(id)).filter(Boolean);
    return `<div class="playlist-card" data-playlist-id="${escapeHTML(playlist.id)}">
      <div class="playlist-card-head"><div><div class="playlist-card-title">♫ ${escapeHTML(playlist.name)}</div><div class="muted" style="font-size:10px;margin-top:4px">${songTracks.length} ${songTracks.length===1?"song":"songs"}</div></div>
      <div class="playlist-card-actions"><button type="button" data-playlist-action="add-current" data-playlist-id="${escapeHTML(playlist.id)}">＋ Add playing song</button><button type="button" data-playlist-action="play-all" data-playlist-id="${escapeHTML(playlist.id)}">▶ Play playlist</button><button type="button" data-playlist-action="delete" data-playlist-id="${escapeHTML(playlist.id)}">Delete</button></div></div>
      ${songTracks.length?songTracks.map((track,index)=>`<div class="playlist-song"><span class="playlist-song-name">${String(index+1).padStart(2,"0")} · ${escapeHTML(track.name)}</span><span class="playlist-song-actions"><button type="button" data-playlist-action="play-song" data-playlist-id="${escapeHTML(playlist.id)}" data-track-id="${escapeHTML(track.id)}">▶</button><button type="button" data-playlist-action="remove-song" data-playlist-id="${escapeHTML(playlist.id)}" data-track-id="${escapeHTML(track.id)}">×</button></span></div>`).join(""):'<div class="muted" style="font-size:11px;margin-top:12px">No songs added yet.</div>'}
    </div>`;
  }).join("");
}
$("playlistCreateForm").addEventListener("submit",event=>{
  event.preventDefault();const name=$("playlistName").value.trim();if(!name)return;
  if(playlists.some(item=>item.name.toLowerCase()===name.toLowerCase())){showToast("A playlist with that name already exists.");return}
  playlists.push({id:"playlist-"+Date.now()+"-"+Math.random().toString(36).slice(2,7),name,trackIds:[]});savePlaylists();$("playlistName").value="";renderPlaylists();showToast("Playlist created ♫");
});
$("playlistCollection").addEventListener("click",event=>{
  const button=event.target.closest("[data-playlist-action]");if(!button)return;
  const playlist=playlists.find(item=>item.id===button.dataset.playlistId);if(!playlist)return;
  const action=button.dataset.playlistAction;const trackId=button.dataset.trackId;
  if(action==="add-current"){
    if(!currentTrackId){showToast("Play a song first, then add it to a playlist.");return}
    if(playlist.trackIds.includes(String(currentTrackId))){showToast("That song is already in this playlist.");return}
    playlist.trackIds.push(String(currentTrackId));savePlaylists();renderPlaylists();showToast("Added to "+playlist.name+" ♫");
  }else if(action==="delete"){
    playlists=playlists.filter(item=>item.id!==playlist.id);if(playlistQueueIds&&playlistQueueIds.some(id=>playlist.trackIds.includes(id)))playlistQueueIds=null;savePlaylists();renderPlaylists();showToast("Playlist deleted");
  }else if(action==="remove-song"){
    playlist.trackIds=playlist.trackIds.filter(id=>id!==String(trackId));savePlaylists();renderPlaylists();
  }else if(action==="play-song"){
    playlistQueueIds=[...playlist.trackIds];playTrackInMiniPlayer(trackId,true);closeModal("playlistModal");
  }else if(action==="play-all"){
    const available=playlist.trackIds.map(id=>findTrack(id)).filter(track=>track&&track.link&&String(track.link).trim());
    if(!available.length){showToast("Add tracks with audio links to this playlist first.");return}
    playlistQueueIds=available.map(track=>String(track.id));playTrackInMiniPlayer(available[0].id,true);closeModal("playlistModal");
  }
});

$("miniRepeat").addEventListener("click", () => {
  repeatCurrent = !repeatCurrent;
  if (currentPlayerReady && currentPlayer) currentPlayer.setLoop(repeatCurrent);
  updateMiniButtons();
  showToast(repeatCurrent ? "Repeat on" : "Repeat off");
});
$("miniVolume").addEventListener("input", () => {
  if (currentPlayerReady && currentPlayer) currentPlayer.setVolume(Number($("miniVolume").value));
});
$("miniSeek").addEventListener("change", () => {
  if (currentPlayerReady && currentPlayer) currentPlayer.setCurrentTime(Number($("miniSeek").value));
});
$("miniClose").addEventListener("click", () => {
  if (currentPlayerReady && currentPlayer) currentPlayer.pause();
  isPlaying = false;
  updateMiniButtons();
  $("miniPlayer").classList.remove("visible");
});
function resetTrackForm(era="before"){
  $("trackId").value="";
  $("trackName").value=era==="album"?"Untitled":"";$("trackAliases").value="";
  $("trackEra").value=era;$("trackYear").value="";$("trackDate").value="";
  $("trackLength").value="";setCategoryCheckboxes([]);
  $("trackLink").value="";$("trackDetails").value="";$("trackDescription").value="";
  $("trackModalTitle").textContent="Add a track";
}
function openAddTrack(era){resetTrackForm(era);closeModal("adminModal");openModal("trackModal")}
function openEditTrack(id){
  if(!isAdmin){showToast("Unlock admin first.");return}
  const track=findTrack(id);
  if(!track){showToast("Track not found.");return}
  $("trackId").value=track.id;$("trackName").value=track.name;$("trackAliases").value=track.aliases||"";
  $("trackEra").value=track.era;$("trackYear").value=track.year;
  $("trackDate").value=track.date;$("trackLength").value=track.length;
  setCategoryCheckboxes(track.category);$("trackLink").value=track.link;
  $("trackDetails").value=track.details;$("trackDescription").value=track.description||"";$("trackModalTitle").textContent="Edit track";
  closeModal("adminModal");openModal("trackModal");
}

async function saveTrack(event){
  event.preventDefault();
  if(!isAdmin){showToast("Unlock admin first.");return}
  const id=$("trackId").value;
  const era=$("trackEra").value==="album"?"album":"before";
  const existing=id?findTrack(id):null;
  const albumOrder=era==="album"?(existing?.album_order||getAlbumTracks().length+1):null;
  const payload=trackPayload({
    name:$("trackName").value.trim()||"Untitled",aliases:$("trackAliases").value.trim(),
    year:$("trackYear").value,date:$("trackDate").value,
    length:$("trackLength").value.trim(),category:selectedCategories(),
    link:$("trackLink").value.trim(),details:$("trackDetails").value.trim(),
    description:$("trackDescription").value.trim(),era,album_order:albumOrder
  });
  const saveOperation=includeOrder=>{
    const data={...payload};
    if(!includeOrder)delete data.album_order;
    return id?supabaseClient.from("tracks").update(data).eq("id",id):supabaseClient.from("tracks").insert(data);
  };
  const result=await writeWithSchemaFallback(saveOperation);
  if(result.error){
    console.error(result.error);
    if(/aliases.*column|column.*aliases/i.test(result.error.message||"")){
      showToast("Add the aliases column in Supabase, then save again.");
    }else if(/description.*column|column.*description/i.test(result.error.message||"")){
      showToast("Add the description column in Supabase, then save again.");
    }else{
      showToast("Could not save. Check your Supabase table and permissions.");
    }
    return;
  }
  closeModal("trackModal");showToast(id?"Track updated ✦":"Track added ✦");
  await loadTracks();
}

async function deleteTrack(id){
  if(!isAdmin){showToast("Unlock admin first.");return}
  const track=findTrack(id);if(!track)return;
  if(!confirm(`Delete "${track.name}"? This cannot be undone.`))return;
  const {error}=await supabaseClient.from("tracks").delete().eq("id",id);
  if(error){console.error(error);showToast("Could not delete. Check Supabase permissions.");return}
  showToast("Track deleted.");await loadTracks();
}

function applySettings(theme,reduceMotion,extras={}){
  document.body.classList.remove("theme-purple","theme-green","text-small","text-large");
  if(theme==="purple")document.body.classList.add("theme-purple");
  if(theme==="green")document.body.classList.add("theme-green");
  const textSize=["small","normal","large"].includes(extras.textSize)?extras.textSize:"normal";
  if(textSize!=="normal")document.body.classList.add("text-"+textSize);
  document.body.classList.toggle("reduce-motion",Boolean(reduceMotion));
  document.body.classList.toggle("compact-tracks",Boolean(extras.compactTracks));
  document.body.classList.toggle("hide-descriptions",extras.showDescriptions===false);
  document.body.classList.toggle("hide-category-emojis",extras.showCategoryEmojis===false);
  $("themeSelect").value=theme;
  $("motionToggle").checked=Boolean(reduceMotion);
  $("textSizeSelect").value=textSize;
  $("compactTracksToggle").checked=Boolean(extras.compactTracks);
  $("showDescriptionsToggle").checked=extras.showDescriptions!==false;
  $("showCategoryEmojisToggle").checked=extras.showCategoryEmojis!==false;
  try{localStorage.setItem("joppepope-settings",JSON.stringify({theme,reduceMotion:Boolean(reduceMotion),textSize,compactTracks:Boolean(extras.compactTracks),showDescriptions:extras.showDescriptions!==false,showCategoryEmojis:extras.showCategoryEmojis!==false}));}catch{}
}
function currentSettingsExtras(){return {textSize:$("textSizeSelect").value,compactTracks:$("compactTracksToggle").checked,showDescriptions:$("showDescriptionsToggle").checked,showCategoryEmojis:$("showCategoryEmojisToggle").checked}}
function refreshSettings(){applySettings($("themeSelect").value,$("motionToggle").checked,currentSettingsExtras())}
function loadSettings(){
  try{
    const saved=JSON.parse(localStorage.getItem("joppepope-settings")||"{}");
    applySettings(["orange","purple","green"].includes(saved.theme)?saved.theme:"orange",Boolean(saved.reduceMotion),saved);
  }catch{applySettings("orange",false);}
}
$("settingsButton").addEventListener("click",()=>openModal("settingsModal"));
["themeSelect","motionToggle","textSizeSelect","compactTracksToggle","showDescriptionsToggle","showCategoryEmojisToggle"].forEach(id=>$(id).addEventListener("change",refreshSettings));
$("resetSettingsButton").addEventListener("click",()=>applySettings("orange",false,{textSize:"normal",compactTracks:false,showDescriptions:true,showCategoryEmojis:true}));

async function applyAuthSession(){
  const {data}=await supabaseClient.auth.getSession();
  const user=data?.session?.user;
  isAdmin=Boolean(user && String(user.email||"").toLowerCase()===ADMIN_EMAIL);
  if(isAdmin){$("adminButton").textContent="✳ ADMIN · UNLOCKED";}else{$("adminButton").textContent="✳ ADMIN";}
}
supabaseClient.auth.onAuthStateChange(()=>{setTimeout(applyAuthSession,0)});
$("adminButton").addEventListener("click",async()=>{
  await applyAuthSession();
  if(isAdmin){renderAdminPicker();openModal("adminModal")}
  else{$("adminEmail").value="";$("adminPassword").value="";openModal("loginModal");setTimeout(()=>$("adminEmail").focus(),50)}
});
$("loginForm").addEventListener("submit",async event=>{
  event.preventDefault();
  const email=$("adminEmail").value.trim().toLowerCase();
  if(email!==ADMIN_EMAIL)return showToast("That account is not the configured admin.");
  const {error}=await supabaseClient.auth.signInWithPassword({email,password:$("adminPassword").value});
  if(error){showToast("Sign-in failed. Check the email and password.");return}
  await applyAuthSession();
  if(!isAdmin){await supabaseClient.auth.signOut();return showToast("This account is not the configured admin.")}
  closeModal("loginModal");$("adminPassword").value="";
  renderAll();renderAdminPicker();openModal("adminModal");showToast("Admin signed in securely.");
});
$("trackForm").addEventListener("submit",saveTrack);
$("addBeforeButton").addEventListener("click",()=>openAddTrack("before"));
$("addAlbumButton").addEventListener("click",()=>openAddTrack("album"));
$("editTrackButton").addEventListener("click",()=>{
  const id=$("adminTrackPicker").value;
  if(!id)return showToast("Choose a track first.");
  openEditTrack(id);
});
$("deleteTrackButton").addEventListener("click",()=>{
  const id=$("adminTrackPicker").value;
  if(!id)return showToast("Choose a track first.");
  deleteTrack(id);
});

$("searchInput").addEventListener("input",renderTracks);
$("yearFilter").addEventListener("change",renderTracks);
$("resetFiltersButton").addEventListener("click",()=>{
  $("searchInput").value="";
  $("yearFilter").value="all";
  activeCategory="all";
  document.querySelectorAll(".filter-btn").forEach(btn=>btn.classList.toggle("active",btn.dataset.category==="all"));
  $("sortSelect").value="newest";
  renderTracks();
});
$("sortSelect").addEventListener("change",()=>{
  if($("sortSelect").value==="shuffle")refreshShuffleOrders();
  else playlistQueueIds=null;
  const table=$("trackTable");
  table.classList.remove("filter-refresh");
  void table.offsetWidth;
  table.classList.add("filter-refresh");
  renderTracks();
});
document.querySelectorAll(".filter-btn").forEach(button=>{
  button.addEventListener("click",()=>{
    if(button.classList.contains("active"))return;
    document.querySelectorAll(".filter-btn").forEach(btn=>btn.classList.remove("active"));
    button.classList.add("active");
    activeCategory=button.dataset.category;
    const table=$("trackTable");
    table.classList.remove("filter-refresh");
    void table.offsetWidth;
    table.classList.add("filter-refresh");
    renderTracks();
  });
});

document.addEventListener("click",event=>{
  const action=event.target.closest("[data-action]");
  if(action){
    const id=action.dataset.id;
    if(action.dataset.action==="play"){
      if(String(currentTrackId)===String(id)){
        if(currentPlayer&&currentPlayerReady)toggleMiniPlayback();
        else playTrackInMiniPlayer(id,true);
      }else openAudio(id);
    }
    if(action.dataset.action==="edit"&&isAdmin)openEditTrack(id);
    return;
  }
  const row=event.target.closest("tr[data-track-id]");
  if(row&&isAdmin&&event.detail===2)openEditTrack(row.dataset.trackId);
});

const contextMenu=$("contextMenu");
document.addEventListener("contextmenu",event=>{
  const row=event.target.closest("tr[data-track-id]");
  if(!row||!isAdmin)return;
  event.preventDefault();contextTrackId=row.dataset.trackId;
  contextMenu.style.left=Math.min(event.clientX,window.innerWidth-180)+"px";
  contextMenu.style.top=Math.min(event.clientY,window.innerHeight-100)+"px";
  contextMenu.classList.add("open");
});
document.addEventListener("click",event=>{
  if(!event.target.closest("#contextMenu"))contextMenu.classList.remove("open");
});
$("contextEditButton").addEventListener("click",()=>{
  contextMenu.classList.remove("open");
  if(contextTrackId)openEditTrack(contextTrackId);
});
$("contextOpenButton").addEventListener("click",()=>{
  contextMenu.classList.remove("open");
  if(contextTrackId)openAudio(contextTrackId);
});


/* Shared updates feed. The site_updates table must exist in Supabase. */
let siteUpdates=[];
function formatUpdateDate(value){
  if(!value)return "DATE NOT SET";
  const date=new Date(value);
  return Number.isNaN(date.getTime())?"DATE NOT SET":date.toLocaleDateString(undefined,{year:"numeric",month:"short",day:"numeric"});
}
function renderUpdates(){
  const root=$("updatesList");
  $("updateAdminTools").hidden=!isAdmin;
  if(!siteUpdates.length){root.innerHTML='<div class="empty">No updates posted yet.</div>';return}
  root.innerHTML=siteUpdates.map(update=>`
    <article class="update-card">
      <h3>${escapeHTML(update.title||"Update")}</h3>
      <div class="update-date">${escapeHTML(formatUpdateDate(update.created_at))}</div>
      <div class="update-body">${escapeHTML(update.body||"")}</div>
      ${isAdmin?`<div class="modal-actions" style="margin-top:12px"><button class="secondary-btn" type="button" data-update-action="edit" data-update-id="${escapeHTML(update.id)}">✎ EDIT</button><button class="danger-btn" type="button" data-update-action="delete" data-update-id="${escapeHTML(update.id)}">DELETE</button></div>`:""}
    </article>`).join("");
}
async function loadUpdates(){
  $("updatesList").innerHTML='<div class="empty">Loading updates...</div>';
  const {data,error}=await supabaseClient.from("site_updates").select("*").order("created_at",{ascending:false});
  if(error){
    console.error("Updates table could not be loaded:",error);
    $("updatesList").innerHTML='<div class="empty">Updates are not configured yet. Create the <code>site_updates</code> table in Supabase using the setup instructions.</div>';
    $("updateAdminTools").hidden=!isAdmin;
    return;
  }
  siteUpdates=data||[];
  renderUpdates();
}
function resetUpdateForm(){
  $("updateId").value="";
  $("updateTitle").value="";
  $("updateBody").value="";
  $("updateForm").hidden=true;
}
$("updatesButton").addEventListener("click",()=>{openModal("updatesModal");loadUpdates()});
$("newUpdateButton").addEventListener("click",()=>{
  if(!isAdmin)return showToast("Unlock admin mode first.");
  $("updateId").value="";$("updateTitle").value="";$("updateBody").value="";
  $("updateForm").hidden=false;$("updateTitle").focus();
});
$("cancelUpdateButton").addEventListener("click",resetUpdateForm);
$("updateForm").addEventListener("submit",async event=>{
  event.preventDefault();
  if(!isAdmin)return showToast("Unlock admin mode first.");
  const id=$("updateId").value;
  const payload={title:$("updateTitle").value.trim(),body:$("updateBody").value.trim()};
  if(!payload.title||!payload.body)return showToast("Add a title and update details.");
  let result;
  if(id)result=await supabaseClient.from("site_updates").update(payload).eq("id",id);
  else result=await supabaseClient.from("site_updates").insert(payload);
  if(result.error){
    console.error(result.error);
    showToast("Could not save update. Check the site_updates table and Supabase write permissions.");
    return;
  }
  resetUpdateForm();await loadUpdates();showToast("Update published.");
});
$("updatesList").addEventListener("click",async event=>{
  const button=event.target.closest("[data-update-action]");
  if(!button)return;
  if(!isAdmin)return showToast("Unlock admin mode first.");
  const update=siteUpdates.find(item=>String(item.id)===String(button.dataset.updateId));
  if(!update)return;
  if(button.dataset.updateAction==="edit"){
    $("updateId").value=update.id;$("updateTitle").value=update.title||"";$("updateBody").value=update.body||"";
    $("updateForm").hidden=false;$("updateTitle").focus();
  }else if(button.dataset.updateAction==="delete"){
    if(!confirm("Delete this update?"))return;
    const {error}=await supabaseClient.from("site_updates").delete().eq("id",update.id);
    if(error){console.error(error);showToast("Could not delete update. Check Supabase permissions.");return}
    await loadUpdates();showToast("Update deleted.");
  }
});

/* Background transitions near the album; each section keeps its own colors. */
function updateScrollTheme(){
  const album=$("albumSection");
  if(!album)return;
  document.body.classList.toggle("album-past",album.getBoundingClientRect().top<window.innerHeight*.72);
}
function scheduleScrollTheme(){
  if(scrollFrame!==null)return;
  scrollFrame=requestAnimationFrame(()=>{
    updateScrollTheme();scrollFrame=null;
  });
}
window.addEventListener("scroll",scheduleScrollTheme,{passive:true});
window.addEventListener("resize",scheduleScrollTheme);

/* Scroll reveals */
const revealItems=document.querySelectorAll(".reveal");
if("IntersectionObserver" in window){
  const observer=new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add("is-visible");
        observer.unobserve(entry.target);
      }
    });
  },{threshold:.06,rootMargin:"0px 0px -25px 0px"});
  revealItems.forEach(item=>observer.observe(item));
}else revealItems.forEach(item=>item.classList.add("is-visible"));

/* Admin console actions */
$("adminTrackSearch").addEventListener("input",renderAdminPicker);
function pickedTrack(){const t=findTrack($("adminTrackPicker").value);if(!t)showToast("Choose a track first.");return t}
$("duplicateTrackButton").addEventListener("click",async()=>{
  const t=pickedTrack();if(!t||!isAdmin)return;
  const copy={...t,name:t.name+" (copy)"};
  if(t.era==="album")copy.album_order=getAlbumTracks().length+1;
  const r=await writeWithSchemaFallback(inc=>{const d=trackPayload(copy);if(!inc)delete d.album_order;return supabaseClient.from("tracks").insert(d)});
  if(r.error){console.error(r.error);showToast("Could not duplicate track.");return}
  showToast("Track duplicated ✦");await loadTracks();
});
$("moveEraButton").addEventListener("click",async()=>{
  const t=pickedTrack();if(!t||!isAdmin)return;
  const era=t.era==="album"?"before":"album";
  const d=trackPayload({...t,era,album_order:era==="album"?getAlbumTracks().length+1:null});
  const r=await writeWithSchemaFallback(inc=>{const x={...d};if(!inc)delete x.album_order;return supabaseClient.from("tracks").update(x).eq("id",t.id)});
  if(r.error){console.error(r.error);showToast("Could not move track.");return}
  showToast("Moved to "+(era==="album"?"the album":"the archive")+" ✦");await loadTracks();
});
$("adminExportButton").addEventListener("click",()=>{
  const blob=new Blob([JSON.stringify(tracks,null,2)],{type:"application/json"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);
  a.download="joppepope-backup-"+new Date().toISOString().slice(0,10)+".json";a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);showToast("Backup downloaded ⤓");
});
$("adminUpdatesButton").addEventListener("click",()=>{closeModal("adminModal");openModal("updatesModal");loadUpdates()});
$("adminSignOutButton").addEventListener("click",async()=>{
  await supabaseClient.auth.signOut();await applyAuthSession();
  closeModal("adminModal");renderAll();showToast("Signed out.");
});

/* Extra settings (stored separately so existing settings keep working) */
const X_KEY="joppepope-settings-extra";
const xDefaults={defaultSort:"custom",lyricsSize:"normal",autoplayNext:true,rememberVolume:true,hideEffects:false,hideYear:false,hideLength:false,volume:80};
let extraSettings={...xDefaults};
try{extraSettings={...xDefaults,...JSON.parse(localStorage.getItem(X_KEY)||"{}")}}catch{}
function applyExtra(initial){
  const s=extraSettings,b=document.body;
  b.classList.toggle("no-effects",s.hideEffects);
  b.classList.toggle("hide-year",s.hideYear);
  b.classList.toggle("hide-length",s.hideLength);
  b.classList.remove("lyrics-small","lyrics-large");
  if(s.lyricsSize!=="normal")b.classList.add("lyrics-"+s.lyricsSize);
  $("defaultSortSelect").value=s.defaultSort;$("lyricsSizeSelect").value=s.lyricsSize;
  $("autoplayToggle").checked=s.autoplayNext;$("rememberVolumeToggle").checked=s.rememberVolume;
  $("hideEffectsToggle").checked=s.hideEffects;$("hideYearToggle").checked=s.hideYear;$("hideLengthToggle").checked=s.hideLength;
  if(initial){
    $("sortSelect").value=s.defaultSort;
    if(s.defaultSort==="shuffle")refreshShuffleOrders();
    if(s.rememberVolume)$("miniVolume").value=s.volume;
  }
  try{localStorage.setItem(X_KEY,JSON.stringify(s))}catch{}
}
function readExtra(){
  Object.assign(extraSettings,{
    defaultSort:$("defaultSortSelect").value,lyricsSize:$("lyricsSizeSelect").value,
    autoplayNext:$("autoplayToggle").checked,rememberVolume:$("rememberVolumeToggle").checked,
    hideEffects:$("hideEffectsToggle").checked,hideYear:$("hideYearToggle").checked,hideLength:$("hideLengthToggle").checked
  });
  applyExtra(false);
}
["defaultSortSelect","lyricsSizeSelect","autoplayToggle","rememberVolumeToggle","hideEffectsToggle","hideYearToggle","hideLengthToggle"]
  .forEach(id=>$(id).addEventListener("change",readExtra));
$("miniVolume").addEventListener("input",()=>{if(extraSettings.rememberVolume){extraSettings.volume=Number($("miniVolume").value);applyExtra(false)}});
$("resetSettingsButton").addEventListener("click",()=>{extraSettings={...xDefaults};applyExtra(true);renderTracks()});

loadSettings();
applyExtra(true);
updateScrollTheme();
loadTracks();
})();
</script>
<script>
(()=>{
const hero=document.querySelector(".hero");
if(hero&&!hero.querySelector(".vinyl")){const v=document.createElement("div");v.className="vinyl";v.setAttribute("aria-hidden","true");hero.prepend(v);
const t=document.createElement("div");t.className="ticker";t.setAttribute("aria-hidden","true");
const row="<span>JOPPEPOPE<i>✦</i>MUSIC ARCHIVE<i>✦</i>EVERY SONG HAS A STORY<i>✦</i>THE NEXT ERA<i>✦</i></span>";
t.innerHTML="<div>"+row.repeat(6)+"</div>";hero.appendChild(t);}
if(matchMedia("(prefers-reduced-motion:reduce)").matches)return;
let raf=null;
addEventListener("pointermove",e=>{if(raf)return;raf=requestAnimationFrame(()=>{raf=null;
document.querySelectorAll(".section").forEach(s=>{const r=s.getBoundingClientRect();s.style.setProperty("--mx",e.clientX-r.left+"px");s.style.setProperty("--my",e.clientY-r.top+"px")});
const c=e.target.closest&&e.target.closest(".album-track");
document.querySelectorAll(".album-track").forEach(a=>{if(a!==c)a.style.transform=""});
if(c){const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
c.style.transform=`perspective(900px) rotateY(${x*7}deg) rotateX(${-y*7}deg) translateY(-4px)`}})},{passive:true});
document.addEventListener("pointerleave",()=>document.querySelectorAll(".album-track").forEach(a=>a.style.transform=""));
})();
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const reduce=matchMedia("(prefers-reduced-motion:reduce)").matches;
const css=n=>getComputedStyle(document.body).getPropertyValue(n).trim()||"#ff7a3d";
/* scroll bar + to-top */
const bar=Object.assign(document.createElement("div"),{id:"scrollBar"});
const top=Object.assign(document.createElement("button"),{id:"toTop",type:"button",title:"Back to top",textContent:"↑"});
document.body.append(bar,top);
top.onclick=()=>scrollTo({top:0,behavior:"smooth"});
addEventListener("scroll",()=>{const h=document.documentElement,p=h.scrollTop/Math.max(1,h.scrollHeight-h.clientHeight);bar.style.transform=`scaleX(${p})`;top.classList.toggle("show",h.scrollTop>700)},{passive:true});
/* hero: stats + hint + eq */
const hero=$(".hero-bottom");
if(hero){
 hero.insertAdjacentHTML("afterend",'<div class="stats"><div class="stat"><b data-n="a">0</b><span>ARCHIVE TRACKS</span></div><div class="stat"><b data-n="b">0</b><span>ALBUM TRACKS</span></div><div class="stat"><b data-n="c">0</b><span>PLAYABLE NOW</span></div></div><div class="hero-hint"><kbd>Ctrl</kbd><kbd>K</kbd> search everything · <kbd>Space</kbd> play · <kbd>←</kbd><kbd>→</kbd> skip</div>');
}
const shown={};
function count(el,to){const from=shown[el.dataset.n]||0;shown[el.dataset.n]=to;if(reduce||from===to){el.textContent=to;return}const t0=performance.now();(function f(t){const k=Math.min(1,(t-t0)/900),e=1-Math.pow(1-k,3);el.textContent=Math.round(from+(to-from)*e);if(k<1)requestAnimationFrame(f)})(t0)}
function stats(){const n=s=>parseInt(($(s)||{}).textContent)||0;const v={a:n("#beforeCount"),b:n("#albumCount"),c:$$("#trackTable .icon-play-btn,#albumList .icon-play-btn").length};$$(".stat b").forEach(el=>count(el,v[el.dataset.n]))}
["#trackTable","#albumList"].forEach(s=>{const el=$(s);if(el)new MutationObserver(()=>{clearTimeout(stats.t);stats.t=setTimeout(stats,150)}).observe(el,{childList:true})});
const copy=$(".mini-track-copy");if(copy)copy.insertAdjacentHTML("beforeend",'<div class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>');
/* sparks on play */
document.addEventListener("click",e=>{const b=e.target.closest(".icon-play-btn");if(!b||reduce)return;const r=b.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2,cols=[css("--accent"),css("--accent2"),css("--pink"),css("--cyan")];
for(let i=0;i<14;i++){const s=document.createElement("i");s.className="spark";const a=Math.random()*6.28,d=30+Math.random()*50;s.style.cssText=`left:${cx}px;top:${cy}px;--x:${Math.cos(a)*d}px;--y:${Math.sin(a)*d}px;--c:${cols[i%4]}`;document.body.appendChild(s);setTimeout(()=>s.remove(),800)}},true);
/* cursor orb */
if(!reduce&&matchMedia("(pointer:fine)").matches){const o=Object.assign(document.createElement("div"),{className:"cursor-orb"});document.body.appendChild(o);let x=innerWidth/2,y=200,tx=x,ty=y;addEventListener("pointermove",e=>{tx=e.clientX;ty=e.clientY},{passive:true});(function f(){x+=(tx-x)*.08;y+=(ty-y)*.08;o.style.transform=`translate(${x}px,${y}px)`;requestAnimationFrame(f)})()}
/* particle constellation */
if(!reduce){const c=Object.assign(document.createElement("canvas"),{id:"fx"}),g=c.getContext("2d");document.body.prepend(c);let W,H,P=[];const N=innerWidth<700?32:70;
const rs=()=>{W=c.width=innerWidth;H=c.height=innerHeight};rs();addEventListener("resize",rs);
for(let i=0;i<N;i++)P.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3,vy:(Math.random()-.5)*.3,r:Math.random()*1.6+.5});
(function f(){if(!document.hidden&&!document.body.classList.contains("no-effects")){g.clearRect(0,0,W,H);const col=css("--accent2"),sp=document.body.classList.contains("is-playing")?2.2:1;
for(const p of P){p.x+=p.vx*sp;p.y+=p.vy*sp;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1;g.fillStyle=col;g.globalAlpha=.7;g.beginPath();g.arc(p.x,p.y,p.r,0,6.28);g.fill()}
g.strokeStyle=col;for(let i=0;i<N;i++)for(let j=i+1;j<N;j++){const dx=P[i].x-P[j].x,dy=P[i].y-P[j].y,d=dx*dx+dy*dy;if(d<14000){g.globalAlpha=(1-d/14000)*.22;g.beginPath();g.moveTo(P[i].x,P[i].y);g.lineTo(P[j].x,P[j].y);g.stroke()}}}
requestAnimationFrame(f)})()}
/* command palette */
const m=document.createElement("div");m.className="modal-backdrop";m.id="cmdk";
m.innerHTML='<div class="modal"><input id="cmdkInput" placeholder="Search tracks or run a command…" autocomplete="off" aria-label="Command palette"><div id="cmdkList"></div><div class="cmd-foot"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> play / go</span><span><kbd>Esc</kbd> close</span></div></div>';
document.body.appendChild(m);let items=[],sel=0;
const click=s=>()=>{const b=$(s);b&&b.click()};
const cmds=window.__jpCmds=[["⚙ Open settings","COMMAND",click("#settingsButton")],["✦ Open updates","COMMAND",click("#updatesButton")],["♪ Open lyrics","COMMAND",click("#miniLyrics")],["♫ Open playlists","COMMAND",click("#miniPlaylist")],["🔀 Shuffle archive","COMMAND",()=>{const s=$("#sortSelect");s.value="shuffle";s.dispatchEvent(new Event("change"))}],["↑ Back to top","COMMAND",()=>scrollTo({top:0,behavior:"smooth"})]];
function build(q){q=q.toLowerCase();const rows=[];$$("#trackTable tr[data-track-id]").forEach(r=>rows.push([(r.querySelector(".track-name")||{}).textContent||"","ARCHIVE",r]));$$("#albumList .album-track").forEach(r=>rows.push([(r.querySelector(".album-song")||{}).textContent.replace("♫","").trim(),"ALBUM",r]));
items=[...(window.__jpExtra?window.__jpExtra(q):[]),...rows.filter(r=>r[0].toLowerCase().includes(q)).slice(0,30).map(r=>[r[0],r[1],()=>{const b=r[2].querySelector(".icon-play-btn");b?b.click():r[2].scrollIntoView({behavior:"smooth",block:"center"})}]),...cmds.filter(c=>c[0].toLowerCase().includes(q))];sel=0;draw()}
function draw(){$("#cmdkList").innerHTML=items.length?items.map((it,i)=>`<button class="cmd-item${i===sel?" sel":""}" data-i="${i}">${it[1]==="COMMAND"?"":"▶ "}${it[0].replace(/</g,"&lt;")}<small>${it[1]}</small></button>`).join(""):'<div class="empty">Nothing found.</div>'}
function openK(){m.classList.add("open");$("#cmdkInput").value="";build("");setTimeout(()=>$("#cmdkInput").focus(),30)}
function run(i){const it=items[i];if(!it)return;m.classList.remove("open");it[2]()}
$("#cmdkList").addEventListener("click",e=>{const b=e.target.closest(".cmd-item");if(b)run(+b.dataset.i)});
$("#cmdkInput").addEventListener("input",e=>build(e.target.value));
$("#cmdkInput").addEventListener("keydown",e=>{if(e.key==="ArrowDown"){sel=(sel+1)%items.length;draw();e.preventDefault()}else if(e.key==="ArrowUp"){sel=(sel-1+items.length)%items.length;draw();e.preventDefault()}else if(e.key==="Enter")run(sel);const a=$(".cmd-item.sel");a&&a.scrollIntoView({block:"nearest"})});
/* hotkeys */
addEventListener("keydown",e=>{
 if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==="k"){e.preventDefault();openK();return}
 if(/INPUT|TEXTAREA|SELECT/.test((e.target||{}).tagName)||e.ctrlKey||e.metaKey||e.altKey)return;
 if($$(".modal-backdrop.open").length&&!(e.key==="l"&&0))return;
 if(e.key===" "){e.preventDefault();$("#miniPlayPause").click()}
 else if(e.key==="ArrowRight")$("#miniNext").click();
 else if(e.key==="ArrowLeft")$("#miniPrevious").click();
 else if(e.key.toLowerCase()==="l")$("#miniLyrics").click();
 else if(e.key==="/"){e.preventDefault();$("#searchInput").focus();$("#searchInput").scrollIntoView({behavior:"smooth",block:"center"})}
});
setTimeout(stats,1200);
})();
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const reduce=matchMedia("(prefers-reduced-motion:reduce)").matches;
const say=t=>{const e=$("#toast");if(!e)return;e.textContent=t;e.classList.add("show");clearTimeout(say.t);say.t=setTimeout(()=>e.classList.remove("show"),2600)};
const store={get(k,d){try{return JSON.parse(localStorage.getItem(k))??d}catch{return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch{}}};
/* splash */
const sp=document.createElement("div");sp.id="splash";sp.innerHTML='<div class="vinyl"></div><b>JOPPEPOPE</b>';document.body.appendChild(sp);
setTimeout(()=>{sp.classList.add("hide");setTimeout(()=>sp.remove(),900)},reduce?200:1500);
/* favourites */
let favs=new Set(store.get("joppepope-favs",[]).map(String));
const chip=document.createElement("button");chip.type="button";chip.className="fav-chip";chip.innerHTML='♥ FAVORITES <span class="filter-count" id="countFav">0</span>';
const fr=$(".filter-row");fr&&fr.appendChild(chip);
chip.onclick=()=>{chip.classList.toggle("on");document.body.classList.toggle("fav-only",chip.classList.contains("on"))};
const rs=$("#resetFiltersButton");rs&&rs.addEventListener("click",()=>{chip.classList.remove("on");document.body.classList.remove("fav-only")});
function tag(){
 $$("#trackTable tr[data-track-id],#albumList .album-track[data-track-id]").forEach(r=>{
  const id=String(r.dataset.trackId);let b=r.querySelector(".fav-btn");
  if(!b){b=document.createElement("button");b.type="button";b.className="fav-btn";b.dataset.fav=id;b.title="Favorite";b.setAttribute("aria-label","Favorite");
   const host=r.querySelector(".track-name-line")||r.querySelector(".album-actions");host&&(host.classList.contains("album-actions")?host.prepend(b):host.appendChild(b))}
  const on=favs.has(id);b.classList.toggle("on",on);b.textContent=on?"♥":"♡";r.classList.toggle("is-fav",on)});
 const c=$("#countFav");if(c)c.textContent=favs.size;
}
function toggleFav(id){id=String(id);favs.has(id)?favs.delete(id):favs.add(id);store.set("joppepope-favs",[...favs]);tag()}
document.addEventListener("click",e=>{const b=e.target.closest(".fav-btn");if(b){e.stopPropagation();toggleFav(b.dataset.fav)}},true);
["#trackTable","#albumList"].forEach(s=>{const el=$(s);el&&new MutationObserver(()=>queueMicrotask(tag)).observe(el,{childList:true})});
tag();window.__jpFav={toggle:toggleFav,has:id=>favs.has(String(id))};
/* ripple */
document.addEventListener("pointerdown",e=>{const b=e.target.closest(".primary-btn,.secondary-btn,.admin-chip,.fav-chip");if(!b||reduce)return;const r=b.getBoundingClientRect(),d=Math.max(r.width,r.height),s=document.createElement("span");s.className="ripple";s.style.cssText=`width:${d}px;height:${d}px;left:${e.clientX-r.left-d/2}px;top:${e.clientY-r.top-d/2}px`;b.appendChild(s);setTimeout(()=>s.remove(),650)});
/* now playing stage */
const np=document.createElement("div");np.id="np";
np.innerHTML='<button class="np-close" id="npClose" type="button" aria-label="Close">×</button><div class="np-eyebrow">NOW PLAYING</div><div class="np-disc"><div class="np-rings"><i></i><i></i><i></i></div><div class="vinyl"></div></div><h2 id="npTitle">Nothing playing</h2><div class="np-seek"><span id="npCur">0:00</span><input class="mini-seek" id="npSeek" type="range" min="0" max="100" value="0" aria-label="Seek"><span id="npDur">0:00</span></div><div class="np-ctrls"><button class="mini-control" id="npPrev" type="button" aria-label="Previous">|◀</button><button class="mini-control primary" id="npPlay" type="button" aria-label="Play">▶</button><button class="mini-control" id="npNext" type="button" aria-label="Next">▶|</button></div><div class="np-ctrls"><button class="mini-control lyrics-cta" id="npLyrics" type="button">♪ LYRICS</button><button class="mini-control" id="npFav" type="button" title="Favorite this song">♡</button><button class="mini-control" id="npRepeat" type="button" title="Repeat">↻</button></div><div class="np-hint">F or Esc to close · Space play · ← → skip</div>';
document.body.appendChild(np);
const mx=(a,b)=>{const e=$(a);e&&e.click()};
const sync=()=>{const g=i=>($(i)||{});$("#npTitle").textContent=g("#miniTrackName").textContent||"Nothing playing";$("#npCur").textContent=g("#miniCurrentTime").textContent;$("#npDur").textContent=g("#miniDuration").textContent;const ms=g("#miniSeek"),ns=$("#npSeek");if(document.activeElement!==ns){ns.max=ms.max;ns.value=ms.value}ns.style.setProperty("--progress",(ms.style&&ms.style.getPropertyValue("--progress"))||"0%");$("#npPlay").textContent=g("#miniPlayPause").textContent;$("#npRepeat").classList.toggle("active",$("#miniRepeat").classList.contains("active"));const cur=$("#trackTable tr:has(.playing-now),#albumList .album-track:has(.playing-now)");$("#npFav").textContent=cur&&favs.has(String(cur.dataset.trackId))?"♥":"♡"};
let tm;const openNP=()=>{if(window.__jpOpenNP)return window.__jpOpenNP();np.classList.add("open");sync();clearInterval(tm);tm=setInterval(sync,250)},closeNP=()=>{if(window.__jpCloseNP)return window.__jpCloseNP();np.classList.remove("open");clearInterval(tm)};
$("#npClose").onclick=closeNP;
$("#npPlay").onclick=()=>mx("#miniPlayPause");$("#npPrev").onclick=()=>mx("#miniPrevious");$("#npNext").onclick=()=>mx("#miniNext");$("#npRepeat").onclick=()=>mx("#miniRepeat");
$("#npLyrics").onclick=()=>mx("#miniLyrics");
$("#npSeek").addEventListener("change",e=>{const ms=$("#miniSeek");ms.value=e.target.value;ms.dispatchEvent(new Event("change"))});
$("#npFav").onclick=()=>{const cur=$("#trackTable tr:has(.playing-now),#albumList .album-track:has(.playing-now)");cur?toggleFav(cur.dataset.trackId):say("Start playing a song first.");sync()};
const ex=$(".mini-extra > div");if(ex){const b=document.createElement("button");b.type="button";b.className="mini-control";b.id="miniExpand";b.title="Now playing view (F)";b.textContent="⤢";ex.prepend(b);b.onclick=openNP}
const info=$(".mini-track-info");info&&info.addEventListener("click",openNP);if(info)info.style.cursor="pointer";
/* media keys, tab title, recents */
const baseTitle=document.title;let recents=store.get("joppepope-recent",[]);
const nameEl=$("#miniTrackName");
function meta(){const n=(nameEl.textContent||"").trim(),playing=document.body.classList.contains("is-playing");
 document.title=(playing&&n&&n!=="Nothing playing"?"▶ "+n+" · ":"")+baseTitle;
 if("mediaSession" in navigator){navigator.mediaSession.playbackState=playing?"playing":"paused";if(n&&n!=="Nothing playing"&&window.MediaMetadata)navigator.mediaSession.metadata=new MediaMetadata({title:n,artist:"JOPPEPOPE",album:"Music Archive"})}}
if(nameEl){new MutationObserver(()=>{const n=nameEl.textContent.trim();if(n&&n!=="Nothing playing"){recents=[n,...recents.filter(x=>x!==n)].slice(0,6);store.set("joppepope-recent",recents)}meta()}).observe(nameEl,{childList:true,characterData:true,subtree:true})}
new MutationObserver(meta).observe(document.body,{attributes:true,attributeFilter:["class"]});
if("mediaSession" in navigator){const h=(a,f)=>{try{navigator.mediaSession.setActionHandler(a,f)}catch{}};h("play",()=>mx("#miniPlayPause"));h("pause",()=>mx("#miniPlayPause"));h("nexttrack",()=>mx("#miniNext"));h("previoustrack",()=>mx("#miniPrevious"))}
/* palette extras */
const findPlay=name=>{const row=$$("#trackTable tr[data-track-id],#albumList .album-track").find(r=>((r.querySelector(".track-name,.album-song")||{}).textContent||"").replace("♫","").trim()===name);if(!row)return;const b=row.querySelector(".icon-play-btn");b?b.click():row.scrollIntoView({behavior:"smooth",block:"center"})};
window.__jpExtra=q=>q?[]:recents.map(n=>[n,"RECENT",()=>findPlay(n)]);
let sleepT;const sleep=m=>{clearTimeout(sleepT);if(!m){say("Sleep timer off");return}say("Sleep timer: pausing in "+m+" min 😴");sleepT=setTimeout(()=>{document.body.classList.contains("is-playing")&&mx("#miniPlayPause");say("Sleep timer finished. Goodnight 🌙")},m*60000)};
let party;const partyMode=()=>{if(party){clearInterval(party);party=null;document.body.style.removeProperty("--accent");document.body.style.removeProperty("--accent2");say("Party mode off");return}let h=0;say("Party mode 🎉");party=setInterval(()=>{h=(h+3)%360;document.body.style.setProperty("--accent",`hsl(${h} 100% 62%)`);document.body.style.setProperty("--accent2",`hsl(${(h+50)%360} 100% 72%)`)},70)};
const themes=["orange","purple","green"];
const add=window.__jpCmds;
if(add)add.push(["⤢ Now playing view","COMMAND",openNP],["♥ Show favorites only","COMMAND",()=>chip.click()],["🎨 Cycle accent theme","COMMAND",()=>{const s=$("#themeSelect");s.value=themes[(themes.indexOf(s.value)+1)%3];s.dispatchEvent(new Event("change"));say("Theme: "+s.value)}],["🎉 Party mode","COMMAND",partyMode],["😴 Sleep timer 15 min","COMMAND",()=>sleep(15)],["😴 Sleep timer 30 min","COMMAND",()=>sleep(30)],["😴 Sleep timer 60 min","COMMAND",()=>sleep(60)],["⏹ Cancel sleep timer","COMMAND",()=>sleep(0)]);
/* hotkeys */
addEventListener("keydown",e=>{
 if(e.key==="Escape"&&np.classList.contains("open")&&!$$(".modal-backdrop.open").length){closeNP();return}
 if(/INPUT|TEXTAREA|SELECT/.test((e.target||{}).tagName)||e.ctrlKey||e.metaKey||e.altKey||$$(".modal-backdrop.open").length)return;
 const k=e.key.toLowerCase();
 if(k==="f"){np.classList.contains("open")?closeNP():openNP()}
 else if(k==="r")mx("#miniRepeat");
 else if(k==="h"){const cur=$("#trackTable tr:has(.playing-now),#albumList .album-track:has(.playing-now)");cur&&toggleFav(cur.dataset.trackId)}
});
meta();
})();
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const JP=()=>window.__jp||{};
const reduce=matchMedia("(prefers-reduced-motion:reduce)").matches;
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const U=u=>`url("${String(u).replace(/"/g,"%22")}")`;
const say=t=>{const e=$("#toast");if(!e)return;e.textContent=t;e.classList.add("show");clearTimeout(say.t);say.t=setTimeout(()=>e.classList.remove("show"),3200)};
setInterval(()=>document.body.classList.toggle("is-admin",!!(JP().isAdmin&&JP().isAdmin())),500);
/* ---- cover settings (shared via Supabase site_settings, else this device) ---- */
let cfg={before:{},album:{},tracks:{}};
const norm=()=>{cfg.before=cfg.before||{};cfg.album=cfg.album||{};cfg.tracks=cfg.tracks||{}};
try{Object.assign(cfg,JSON.parse(localStorage.getItem("joppepope-covers")||"{}"))}catch{}norm();
async function loadCfg(){const sb=JP().sb;if(!sb)return;try{const {data,error}=await sb.from("site_settings").select("value").eq("key","covers").maybeSingle();if(!error&&data&&data.value){cfg={before:{},album:{},tracks:{},...data.value};norm();try{localStorage.setItem("joppepope-covers",JSON.stringify(cfg))}catch{}}}catch{}renderAll5()}
async function saveCfg(){let ok=true;try{localStorage.setItem("joppepope-covers",JSON.stringify(cfg))}catch{ok=false;say("Image too big for this browser's storage. Try a smaller one or a link.")}
 const sb=JP().sb;if(!sb||!(JP().isAdmin&&JP().isAdmin()))return;
 const {error}=await sb.from("site_settings").upsert({key:"covers",value:cfg,updated_at:new Date().toISOString()},{onConflict:"key"});
 if(ok)say(error?"Saved on this device only. Run the site_settings SQL to share covers with everyone.":"Cover saved for everyone ✦")}
const trackById=id=>(JP().tracks?JP().tracks():[]).find(t=>String(t.id)===String(id));
const curTrack=()=>trackById(JP().currentId&&JP().currentId());
const eraOf=t=>t&&t.era==="album"?"album":"before";
const coverOf=t=>t?(cfg.tracks[t.id]||cfg[eraOf(t)].cover||""):"";
const eraTitle=e=>cfg[e].title||(e==="album"?"Upcoming Album":"Before The First Album");
const artistOf=t=>cfg[eraOf(t)].artist||cfg.before.artist||"JOPPEPOPE";
const colorCache={};
function dominant(url){return new Promise(res=>{if(!url)return res(null);if(colorCache[url])return res(colorCache[url]);const i=new Image();i.crossOrigin="anonymous";i.onload=()=>{try{const c=document.createElement("canvas");c.width=c.height=16;const x=c.getContext("2d");x.drawImage(i,0,0,16,16);const d=x.getImageData(0,0,16,16).data;let r=0,g=0,b=0,w=0;for(let k=0;k<d.length;k+=4){const s=Math.max(d[k],d[k+1],d[k+2])-Math.min(d[k],d[k+1],d[k+2])+10;r+=d[k]*s;g+=d[k+1]*s;b+=d[k+2]*s;w+=s}res(colorCache[url]=`rgb(${r/w|0},${g/w|0},${b/w|0})`)}catch{res(null)}};i.onerror=()=>res(null);i.src=url})}
function fileToCover(f){return new Promise((ok,no)=>{const fr=new FileReader();fr.onload=()=>{const i=new Image();i.onload=()=>{const k=Math.min(1,640/Math.max(i.width,i.height)),c=document.createElement("canvas");c.width=Math.round(i.width*k);c.height=Math.round(i.height*k);c.getContext("2d").drawImage(i,0,0,c.width,c.height);ok(c.toDataURL("image/jpeg",.85))};i.onerror=no;i.src=fr.result};fr.onerror=no;fr.readAsDataURL(f)})}
/* ---- cover editor ---- */
const cm=document.createElement("div");cm.className="modal-backdrop";cm.id="coverModal";
cm.innerHTML='<div class="modal"><div class="eyebrow">ARTWORK / COVER EDITOR</div><h2 id="cvHead">Set cover</h2><p class="modal-desc">Upload an image or paste a link. Uploads are shrunk automatically.</p><div class="cover-preview" id="cvPrev"></div><div class="form-grid"><div class="form-field full"><label for="cvFile">Upload image</label><input id="cvFile" type="file" accept="image/*"></div><div class="form-field full"><label for="cvUrl">…or image link</label><input id="cvUrl" type="url" placeholder="https://..."></div><div class="form-field" id="cvNameF"><label for="cvName">Title</label><input id="cvName" maxlength="80"></div><div class="form-field" id="cvArtistF"><label for="cvArtist">Artist name</label><input id="cvArtist" maxlength="60" placeholder="JOPPEPOPE"></div></div><div class="modal-actions"><button class="danger-btn" type="button" id="cvRemove">REMOVE COVER</button><button class="secondary-btn" type="button" id="cvCancel">CANCEL</button><button class="primary-btn" type="button" id="cvSave">SAVE ✦</button></div></div>';
document.body.appendChild(cm);
cm.addEventListener("click",e=>{if(e.target===cm)cm.classList.remove("open")});$("#cvCancel").onclick=()=>cm.classList.remove("open");
let scope=null,pend="";
const prev=()=>{$("#cvPrev").style.backgroundImage=pend?U(pend):""};
function openCover(s){if(!(JP().isAdmin&&JP().isAdmin()))return say("Unlock admin first.");scope=s;const tr=!!s.track;
 const o=tr?null:cfg[s.era];pend=tr?(cfg.tracks[s.track]||""):(o.cover||"");
 $("#cvHead").textContent=tr?"Cover for this song":(s.era==="album"?"Album cover":"Archive cover");
 $("#cvNameF").style.display=$("#cvArtistF").style.display=tr?"none":"";
 $("#cvName").value=tr?"":(o.title||"");$("#cvArtist").value=tr?"":(o.artist||"");$("#cvUrl").value=/^https?:/.test(pend)?pend:"";$("#cvFile").value="";prev();cm.classList.add("open")}
$("#cvFile").onchange=async e=>{const f=e.target.files[0];if(!f)return;try{pend=await fileToCover(f);$("#cvUrl").value="";prev()}catch{say("Could not read that image.")}};
$("#cvUrl").oninput=e=>{pend=e.target.value.trim();prev()};
$("#cvRemove").onclick=()=>{pend="";$("#cvUrl").value="";prev()};
$("#cvSave").onclick=async()=>{if(!scope)return;
 if(scope.track){pend?cfg.tracks[scope.track]=pend:delete cfg.tracks[scope.track]}
 else cfg[scope.era]={...cfg[scope.era],cover:pend,title:$("#cvName").value.trim(),artist:$("#cvArtist").value.trim()};
 cm.classList.remove("open");renderAll5();await saveCfg()};
/* ---- lightbox ---- */
const lb=document.createElement("div");lb.id="lightbox";lb.innerHTML="<img alt='Cover'>";document.body.appendChild(lb);lb.onclick=()=>lb.classList.remove("open");
const showLB=u=>{lb.firstChild.src=u;lb.classList.add("open")};
/* ---- era cards ---- */
function stat(){const T=(JP().tracks?JP().tracks():[]).filter(t=>t.era==="before"),P=T.filter(t=>t.link&&String(t.link).trim());let s=0;T.forEach(t=>{const m=String(t.length||"").match(/^(\d+):(\d{2})$/);if(m)s+=m[1]*60+ +m[2]});return{n:T.length,p:P.length,s,names:T.map(t=>t.name).filter(n=>n.toLowerCase()!=="untitled")}}
const dur=s=>{const h=Math.floor(s/3600),m=Math.floor(s%3600/60);return h?`${h}h ${m}m`:`${m}m`};
async function renderCards(){const body=$("#beforeSection .section-body");if(!body)return;
 let c=$("#eraCard");if(!c){c=document.createElement("div");c.id="eraCard";c.className="era-card";body.prepend(c)}
 const s=stat(),cv=cfg.before.cover;
 c.innerHTML=`<button class="era-cover${cv?"":" empty"}" id="eraCover" type="button" aria-label="View cover">${cv?"":"♫"}</button><div class="era-info"><div class="era-title">${esc(eraTitle("before"))}</div><div class="era-sub">${esc(cfg.before.artist||"JOPPEPOPE")}${s.names.length?" · ("+esc(s.names.slice(0,3).join(", "))+"…)":""}</div><div class="era-chips"><span>${s.n} SONGS</span><span>${s.p} PLAYABLE</span>${s.s?`<span>${dur(s.s)}</span>`:""}</div><div class="era-actions"><button class="primary-btn" id="eraPlay" type="button">▶ PLAY ALL</button><button class="secondary-btn" id="eraShuffle" type="button">🔀 SHUFFLE</button><button class="secondary-btn admin-only" id="eraEdit" type="button">🖼 ${cv?"EDIT":"ADD"} COVER</button></div></div>`;
 if(cv)$("#eraCover").style.backgroundImage=U(cv);
 const col=await dominant(cv);c.style.setProperty("--card-c",col||"var(--accent)")}
function renderAlbumArt(){const b=$(".album-banner");if(!b)return;let a=$("#albumArt");if(!a){a=document.createElement("button");a.id="albumArt";a.type="button";b.appendChild(a)}const cv=cfg.album.cover;a.className="era-art"+(cv?"":" empty");a.style.backgroundImage=cv?U(cv):"";a.textContent=cv?"":"+ ADD COVER";a.setAttribute("aria-label","Album cover")}
function miniArt(){const a=$(".mini-art");if(!a)return;const cv=coverOf(curTrack());a.classList.toggle("has-cover",!!cv);a.style.backgroundImage=cv?U(cv):"";a.title="Open now playing"}
function renderAll5(){if(window.__jpOnRender)setTimeout(window.__jpOnRender,0);renderCards();renderAlbumArt();miniArt();if(np.classList.contains("open")){refreshNP();renderList()}}
document.addEventListener("click",e=>{const t=e.target.closest("#eraCover,#eraPlay,#eraShuffle,#eraEdit,#albumArt");if(!t)return;
 if(t.id==="eraCover"){cfg.before.cover?showLB(cfg.before.cover):openCover({era:"before"})}
 else if(t.id==="eraEdit")openCover({era:"before"});
 else if(t.id==="albumArt"){cfg.album.cover&&!e.shiftKey?showLB(cfg.album.cover):openCover({era:"album"})}
 else if(t.id==="eraPlay"){const b=$("#trackTable .icon-play-btn");b?b.click():say("No playable tracks yet.")}
 else if(t.id==="eraShuffle"){const s=$("#sortSelect");s.value="shuffle";s.dispatchEvent(new Event("change"));setTimeout(()=>{const b=$("#trackTable .icon-play-btn");b&&b.click()},160)}});
/* ---- extra filter chip ---- */
const fr=$(".filter-row");if(fr){const p=document.createElement("button");p.type="button";p.className="fav-chip";p.textContent="▶ PLAYABLE ONLY";p.onclick=()=>{p.classList.toggle("on");document.body.classList.toggle("playable-only",p.classList.contains("on"))};fr.appendChild(p);const r=$("#resetFiltersButton");r&&r.addEventListener("click",()=>{p.classList.remove("on");document.body.classList.remove("playable-only")})}
/* ---- now playing page ---- */
const old=$("#np");old&&old.remove();
const np=document.createElement("div");np.id="np2";
np.innerHTML='<div class="np2-bg" id="np2Bg"></div><div class="np2-shade"></div><button class="np-close" id="np2Close" type="button" aria-label="Close">⌄</button><div class="np2-main"><div class="np2-art"><div class="vinyl"></div><div class="np2-sleeve" id="np2Sleeve"><span>♫</span></div></div><div class="np2-meta"><h2 id="np2Title">Nothing playing</h2><div class="np2-artist" id="np2Artist"></div><div class="np2-album" id="np2Album"></div><div class="np2-tags" id="np2Tags"></div></div><div class="np2-wave"><canvas id="np2Wave" width="1200" height="124"></canvas><div class="np2-times"><span id="np2Cur">0:00</span><span id="np2Dur">0:00</span></div></div><div class="np2-ctrls"><button class="np2-b" id="np2Shuf" type="button" title="Shuffle">⤮</button><button class="np2-b" id="np2Prev" type="button" title="Previous">⏮</button><button class="np2-b np2-play" id="np2Play" type="button" title="Play / pause">▶</button><button class="np2-b" id="np2Next" type="button" title="Next">⏭</button><button class="np2-b" id="np2Rep" type="button" title="Repeat">⟲</button></div><div class="np2-vol"><span>🔈</span><input id="np2Vol" type="range" min="0" max="100" aria-label="Volume"></div><div class="np2-tools"><button class="np2-t" id="np2Fav" type="button">♡ FAVORITE</button><button class="np2-t" id="np2Lyr" type="button">♪ LYRICS</button><button class="np2-t" id="np2Pl" type="button">♫ PLAYLIST</button><button class="np2-t" id="np2List2" type="button">☰ TRACKS</button><button class="np2-t" id="np2Share" type="button">🔗 SHARE</button><button class="np2-t admin-only" id="np2Cov" type="button">🖼 COVER</button></div></div><aside class="np2-drawer" id="np2Drawer"><div class="np2-dh"><b>TRACKS</b><input id="np2Q" placeholder="Filter…" aria-label="Filter tracks"></div><div id="np2List"></div></aside>';
document.body.appendChild(np);
let bars=[],dirty=true,lastP=-1,drag=false,dragP=0,tmr;
const seeded=s=>{let h=2166136261;for(const c of s){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}return()=>{h+=0x6D2B79F5;let t=h;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}};
function makeBars(seed){const r=seeded(seed||"x"),n=120;bars=[];let v=.5;for(let i=0;i<n;i++){v=Math.max(.14,Math.min(1,v+(r()-.5)*.55));bars.push(v*(.55+.45*Math.sin(i/n*Math.PI)))}}
function drawWave(p){const c=$("#np2Wave"),x=c.getContext("2d"),W=c.width,H=c.height,n=bars.length||1,bw=W/n;x.clearRect(0,0,W,H);for(let i=0;i<bars.length;i++){const h=Math.max(8,bars[i]*H*.92),on=i/n<p;x.fillStyle=on?"#fff":"rgba(255,255,255,.3)";x.beginPath();x.roundRect?x.roundRect(i*bw+bw*.18,(H-h)/2,bw*.64,h,bw*.3):x.rect(i*bw+bw*.18,(H-h)/2,bw*.64,h);x.fill()}x.fillStyle="#fff";x.shadowColor="#fff";x.shadowBlur=14;x.fillRect(Math.max(0,Math.min(W-3,p*W-1.5)),2,3,H-4);x.shadowBlur=0}
const wv=$("#np2Wave"),ratio=e=>{const r=wv.getBoundingClientRect();return Math.max(0,Math.min(1,(e.clientX-r.left)/r.width))};
wv.addEventListener("pointerdown",e=>{drag=true;wv.setPointerCapture(e.pointerId);dragP=ratio(e);drawWave(dragP)});
wv.addEventListener("pointermove",e=>{if(drag){dragP=ratio(e);drawWave(dragP)}});
wv.addEventListener("pointerup",()=>{if(!drag)return;drag=false;const ms=$("#miniSeek");ms.value=dragP*(+ms.max||1);ms.dispatchEvent(new Event("change"));lastP=-1});
async function refreshNP(){const t=curTrack(),cv=coverOf(t),sl=$("#np2Sleeve"),bg=$("#np2Bg");
 $("#np2Title").textContent=t?t.name:"Nothing playing";$("#np2Artist").textContent=t?artistOf(t):"";$("#np2Album").textContent=t?eraTitle(eraOf(t)):"";
 const g=[];if(t){if(t.year)g.push(t.year);if(t.length)g.push(t.length);String(t.category||"").split(",").forEach(c=>{if(c&&c!=="none")g.push((window.__jp&&window.__jp.catLabel?window.__jp.catLabel(c):c))});if(t.era==="album")g.push("UPCOMING ALBUM")}
 $("#np2Tags").innerHTML=g.map(x=>`<span>${esc(x)}</span>`).join("");
 sl.style.backgroundImage=cv?U(cv):"";sl.firstElementChild.style.display=cv?"none":"";bg.style.backgroundImage=cv?U(cv):"";bg.classList.toggle("nocover",!cv);
 makeBars(t?t.id+t.name:"");dirty=true;
 const col=await dominant(cv);np.style.setProperty("--npc",col||"var(--accent)")}
function sync(){const ms=$("#miniSeek"),p=Math.min(1,(+ms.value||0)/(+ms.max||1));
 $("#np2Cur").textContent=$("#miniCurrentTime").textContent;$("#np2Dur").textContent=$("#miniDuration").textContent;
 if(!drag&&(dirty||Math.abs(p-lastP)>.0005)){drawWave(p);lastP=p;dirty=false}
 $("#np2Play").textContent=document.body.classList.contains("is-playing")?"❚❚":"▶";
 $("#np2Shuf").classList.toggle("on",$("#sortSelect").value==="shuffle");$("#np2Rep").classList.toggle("on",$("#miniRepeat").classList.contains("active"));
 const t=curTrack(),F=window.__jpFav,f=!!(t&&F&&F.has(t.id));$("#np2Fav").classList.toggle("on",f);$("#np2Fav").textContent=f?"♥ FAVORITED":"♡ FAVORITE";
 const v=$("#np2Vol");if(document.activeElement!==v)v.value=$("#miniVolume").value}
function renderList(){const q=$("#np2Q").value.toLowerCase(),cur=String(JP().currentId&&JP().currentId());
 const L=(JP().tracks?JP().tracks():[]).filter(t=>t.link&&String(t.link).trim()&&String(t.name).toLowerCase().includes(q));
 const el=$("#np2List");el.innerHTML=L.length?L.map(t=>`<button class="np2-li${String(t.id)===cur?" cur":""}" data-id="${esc(t.id)}"><i>${coverOf(t)?"":"♫"}</i><span>${esc(t.name)}</span></button>`).join(""):'<div class="empty">No playable tracks.</div>';
 [...el.children].forEach(b=>{const t=trackById(b.dataset.id),cv=coverOf(t);if(cv)b.firstChild.style.backgroundImage=U(cv)})}
function openNP(){if(np.classList.contains("open"))return closeNP();if(!curTrack())return say("Play a song first.");np.classList.add("open");document.body.classList.add("np-open");refreshNP();renderList();sync();clearInterval(tmr);tmr=setInterval(sync,250)}
function closeNP(){np.classList.remove("open");document.body.classList.remove("np-open");clearInterval(tmr);$("#np2Drawer").classList.remove("open")}
window.__jpOpenNP=openNP;window.__jpCloseNP=closeNP;
const mx=s=>{const e=$(s);e&&e.click()};
$("#np2Close").onclick=closeNP;$("#np2Play").onclick=()=>mx("#miniPlayPause");$("#np2Prev").onclick=()=>mx("#miniPrevious");$("#np2Next").onclick=()=>mx("#miniNext");$("#np2Rep").onclick=()=>mx("#miniRepeat");
$("#np2Shuf").onclick=()=>{const s=$("#sortSelect");s.value=s.value==="shuffle"?"newest":"shuffle";s.dispatchEvent(new Event("change"));say(s.value==="shuffle"?"Shuffle on 🔀":"Shuffle off")};
$("#np2Vol").oninput=e=>{const m=$("#miniVolume");m.value=e.target.value;m.dispatchEvent(new Event("input"))};
$("#np2Lyr").onclick=()=>mx("#miniLyrics");$("#np2Pl").onclick=()=>mx("#miniPlaylist");
$("#np2Fav").onclick=()=>{const t=curTrack(),F=window.__jpFav;t&&F&&F.toggle(t.id);sync()};
$("#np2List2").onclick=()=>{$("#np2Drawer").classList.toggle("open");renderList()};
$("#np2Q").oninput=renderList;
$("#np2List").onclick=e=>{const b=e.target.closest(".np2-li");if(b&&JP().play)JP().play(b.dataset.id)};
const shareLink=()=>{const t=curTrack();if(!t)return say("Play a song first.");const u=location.href.split("#")[0]+"#t="+encodeURIComponent(t.id);(navigator.clipboard?navigator.clipboard.writeText(u):Promise.reject()).then(()=>say("Link copied 🔗"),()=>say(u))};
$("#np2Share").onclick=shareLink;
$("#np2Cov").onclick=()=>{const t=curTrack();t?openCover({track:t.id}):say("Play a song first.")};
np.addEventListener("pointermove",e=>{if(reduce)return;const s=$("#np2Sleeve"),r=s.getBoundingClientRect(),c=v=>Math.max(-.5,Math.min(.5,v));s.style.transform=`rotateY(${c((e.clientX-r.left)/r.width-.5)*10}deg) rotateX(${-c((e.clientY-r.top)/r.height-.5)*10}deg)`});
/* ---- keys ---- */
let escModal=false;addEventListener("keydown",e=>{if(e.key==="Escape")escModal=$$(".modal-backdrop.open").length>0},true);
addEventListener("keydown",e=>{if(/INPUT|TEXTAREA|SELECT/.test((e.target||{}).tagName)||e.ctrlKey||e.metaKey||e.altKey)return;
 if(e.key==="Escape"&&lb.classList.contains("open")){lb.classList.remove("open");return}
 if(!np.classList.contains("open"))return;
 if(e.key==="Escape"&&!escModal)closeNP();
 else if(!$$(".modal-backdrop.open").length){const m=$("#miniVolume");
  if(e.key==="ArrowUp"||e.key==="ArrowDown"){e.preventDefault();m.value=Math.max(0,Math.min(100,+m.value+(e.key==="ArrowUp"?5:-5)));m.dispatchEvent(new Event("input"));say("Volume "+m.value+"%")}
  else if(e.key.toLowerCase()==="q"){$("#np2Drawer").classList.toggle("open");renderList()}}});
/* ---- palette extras ---- */
const C=window.__jpCmds;if(C)C.push(["🔗 Copy link to current song","COMMAND",shareLink],["🖼 Edit archive cover","COMMAND",()=>openCover({era:"before"})],["🖼 Edit album cover","COMMAND",()=>openCover({era:"album"})]);
/* ---- observers, deep link ---- */
let deb;const later=()=>{clearTimeout(deb);deb=setTimeout(()=>{renderCards();miniArt()},180)};
["#trackTable","#albumList"].forEach(s=>{const el=$(s);el&&new MutationObserver(later).observe(el,{childList:true})});
const nm=$("#miniTrackName");nm&&new MutationObserver(()=>{miniArt();if(np.classList.contains("open")){refreshNP();renderList()}}).observe(nm,{childList:true,characterData:true,subtree:true});
function deep(){const m=location.hash.match(/^#t=(.+)$/);if(!m)return;let n=0;const iv=setInterval(()=>{const t=trackById(decodeURIComponent(m[1]));if(t||++n>40){clearInterval(iv);if(!t)return;const row=$(`[data-track-id="${CSS.escape(String(t.id))}"]`);if(row){row.scrollIntoView({behavior:"smooth",block:"center"});row.classList.add("deep-hit")}setTimeout(()=>{if(t.link&&JP().play){JP().play(t.id);setTimeout(openNP,800)}},900)}},300)}
window.__jpEra={title:eraTitle,cover:e=>cfg[e].cover||"",raw:e=>cfg[e].title||"",trackCover:coverOf,artist:artistOf};renderAll5();loadCfg();deep();
})();
(()=>{
const $=s=>document.querySelector(s);
const K="joppepope-collapsed";let st={};try{st=JSON.parse(localStorage.getItem(K)||"{}")}catch{}
const secs={before:$("#beforeSection"),album:$("#albumSection")};
const U=u=>`url("${String(u).replace(/"/g,"%22")}")`;
const wrap=(sec,nodes)=>{const c=document.createElement("div");c.className="coll";const i=document.createElement("div");i.className="coll-in";nodes.forEach(n=>i.appendChild(n));c.appendChild(i);sec.appendChild(c)};
const mkBtn=label=>{const b=document.createElement("button");b.type="button";b.className="collapse-btn";b.textContent="⌃";b.title=label;b.setAttribute("aria-label",label);return b};
/* archive: header becomes the bar */
const bs=secs.before;let hThumb,hH2;
if(bs){const hdr=bs.querySelector(".section-header"),body=bs.querySelector(".section-body"),pill=hdr.querySelector(".pill"),left=hdr.firstElementChild;
 hThumb=document.createElement("span");hThumb.className="hdr-thumb";
 const L=document.createElement("div");L.className="hdr-left";hdr.prepend(L);L.append(hThumb,left);
 const R=document.createElement("div");R.className="hdr-right";hdr.appendChild(R);R.append(pill,mkBtn("Collapse / expand"));
 hH2=left.querySelector("h2");wrap(bs,[body]);
 hdr.addEventListener("click",()=>toggle("before"))}
/* album: banner + tracklist collapse into a bar */
const as=secs.album;let bThumb,bTitle,bCount;
if(as){const banner=as.querySelector(".album-banner"),body=$("#albumTracklist");
 const bar=document.createElement("button");bar.type="button";bar.className="collapse-bar";
 bar.innerHTML='<span class="bar-thumb"></span><div class="bar-text"><div class="eyebrow">02 / THE NEXT ERA</div><div class="bar-title"></div></div><span class="pill"></span><span class="collapse-btn" aria-hidden="true">⌃</span>';
 as.prepend(bar);bThumb=bar.querySelector(".bar-thumb");bTitle=bar.querySelector(".bar-title");bCount=bar.querySelector(".pill");
 wrap(as,[banner,body]);banner.appendChild(mkBtn("Collapse album"));
 banner.querySelector(".collapse-btn").addEventListener("click",e=>{e.stopPropagation();set("album",true)});
 bar.addEventListener("click",()=>toggle("album"))}
function set(k,v,persist=true){const s=secs[k];if(!s)return;s.classList.toggle("collapsed",!!v);st[k]=!!v;s.querySelectorAll(".collapse-btn,.collapse-bar").forEach(x=>x.setAttribute("aria-expanded",String(!v)));if(persist)try{localStorage.setItem(K,JSON.stringify(st))}catch{}}
function toggle(k){set(k,!(secs[k]&&secs[k].classList.contains("collapsed")))}
function refresh(){const E=window.__jpEra||{};
 if(hThumb){const c=E.cover&&E.cover("before");hThumb.classList.toggle("has",!!c);hThumb.style.backgroundImage=c?U(c):"";const t=E.raw&&E.raw("before");if(t&&hH2)hH2.textContent=t.toUpperCase()}
 if(bThumb){const c=E.cover&&E.cover("album");bThumb.classList.toggle("has",!!c);bThumb.style.backgroundImage=c?U(c):"";bTitle.textContent=(E.raw&&E.raw("album"))||"Album — Coming Soon"}
 if(bCount){const n=$("#albumCount");bCount.textContent=n?n.textContent:""}}
window.__jpOnRender=refresh;
const ac=$("#albumCount");ac&&new MutationObserver(refresh).observe(ac,{childList:true,characterData:true,subtree:true});
/* start state without animation */
document.body.classList.add("no-anim");set("before",st.before,false);set("album",st.album,false);refresh();
requestAnimationFrame(()=>requestAnimationFrame(()=>document.body.classList.remove("no-anim")));
/* auto-open when something inside needs to be seen */
const so=$("#searchInput");so&&so.addEventListener("focus",()=>{if(st.before)set("before",false)});
const orig=Element.prototype.scrollIntoView;
Element.prototype.scrollIntoView=function(...a){const s=this.closest&&this.closest(".section.collapsed");if(s){const k=s===secs.album?"album":"before";set(k,false);setTimeout(()=>orig.apply(this,a),580);return}return orig.apply(this,a)};
/* palette commands */
const C=window.__jpCmds;if(C)C.push(["⇅ Collapse everything","COMMAND",()=>{set("before",true);set("album",true)}],["⇵ Expand everything","COMMAND",()=>{set("before",false);set("album",false)}],["▾ Toggle archive section","COMMAND",()=>toggle("before")],["▾ Toggle album section","COMMAND",()=>toggle("album")]);
window.__jpCollapse={set,toggle};
})();
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const CATS={"all": ["✦", "All tracks", "Every song in the archive, with no filter applied.", ""], "best": ["⭐", "Best", "The top of the archive. The songs that define this era.", "ranking"], "honorable-mention": ["🥈", "Honorable Mention", "So close to the best. These almost took the top spot and just fell short.", "ranking"], "fan-favourite": ["💖", "Fan Favourite", "The songs fans keep coming back to, whatever the rankings say.", "ranking"], "classic": ["👑", "Classic", "Timeless. Still hits no matter when you play it.", "ranking"], "hidden-gem": ["💎", "Hidden Gem", "Underrated. Deserves way more plays than it gets.", "ranking"], "viral": ["📈", "Viral", "Blew up, or got shared everywhere.", "ranking"], "overrated": ["📉", "Overrated", "Gets more love than it earned. Fight me.", "ranking"], "guilty-pleasure": ["🙈", "Guilty Pleasure", "Not the coolest pick, but you replay it anyway.", "ranking"], "worst": ["🗑️", "Worst", "The rough ones. Kept for the history, not for the replays.", "ranking"], "banger": ["🔥", "Banger", "High energy. Turn it up loud.", "vibe"], "chill": ["🌙", "Chill", "Late-night, low-key and laid-back.", "vibe"], "party": ["🎉", "Party", "Made for the club, the car and the group chat.", "vibe"], "workout": ["🏋️", "Workout", "Gym fuel. Lift heavier.", "vibe"], "driving": ["🚗", "Driving", "Windows down, volume up.", "vibe"], "summer": ["☀️", "Summer", "Sun, heat and good times.", "vibe"], "dark": ["🖤", "Dark", "Heavy, moody and a little menacing.", "vibe"], "cinematic": ["🎬", "Cinematic", "Big and widescreen, like a movie scene.", "vibe"], "throwback": ["⏳", "Throwback", "Takes you straight back to an older era.", "vibe"], "motivational": ["💪", "Motivational", "Gets you up and moving toward your goals.", "vibe"], "emotional": ["💔", "Emotional", "The ones that hit right in the feelings.", "mood"], "love": ["💘", "Love Song", "About love, crushes and everything in between.", "mood"], "introspective": ["🪞", "Introspective", "Looking inward. Honest, personal and reflective.", "mood"], "lyrical": ["✍️", "Lyrical", "All about the writing: bars, wordplay and flow.", "style"], "melodic": ["🎶", "Melodic", "Driven by catchy melodies and hooks.", "style"], "storytelling": ["📖", "Storytelling", "Tells a full story from start to finish.", "style"], "experimental": ["🧪", "Experimental", "Weird sounds, new ideas and risks taken.", "style"], "funny": ["😂", "Funny", "Jokes, humour and good energy.", "style"], "instrumental": ["🎹", "Instrumental", "No vocals, just the music.", "style"], "acoustic": ["🎸", "Acoustic", "Stripped back and raw.", "style"], "diss": ["🎯", "Diss", "Aimed at someone. Shots fired.", "type"], "freestyle": ["🎤", "Freestyle", "Off the top, no script.", "type"], "collab": ["🤝", "Collab", "Features another artist.", "type"], "remix": ["🔁", "Remix / Cover", "A remix, flip or cover of another song.", "type"], "skit": ["🎙️", "Skit / Interlude", "A short skit, intro or interlude.", "type"], "unfinished": ["🚧", "Unfinished", "Demos, snippets and works in progress.", "status"], "leaked": ["🕵️", "Leaked", "Never officially released. Found its way out anyway.", "status"], "snippet": ["✂️", "Snippet", "Only a short clip of it exists.", "status"]};const GROUPS=[["ranking", "RANKINGS"], ["vibe", "VIBES"], ["mood", "MOODS"], ["style", "STYLE & SOUND"], ["type", "TYPE OF SONG"], ["status", "STATUS"]];
window.__jpCats=CATS;
const CORE=["all","best","honorable-mention","fan-favourite","worst"],ORIG=["all","best","fan-favourite","worst"];
const fr=$(".filter-row");
if(fr){
 const moreBtn=document.createElement("button");moreBtn.type="button";moreBtn.className="cat-more-btn";
 const panel=document.createElement("div");panel.className="cat-more";panel.hidden=true;
 panel.innerHTML='<input class="field cat-more-search" placeholder="⌕ Find a category…" aria-label="Find a category">'+GROUPS.map(g=>`<div class="cat-grp" data-g="${g[0]}"><h4>${g[1]}</h4><div class="cat-grp-btns"></div></div>`).join("");
 fr.append(moreBtn);fr.after(panel);
 $$(".filter-btn[data-category]").forEach(b=>{const k=b.dataset.category,v=CATS[k];if(v)b.title=v[2];if(CORE.includes(k)||!v)return;const t=panel.querySelector(`.cat-grp[data-g="${v[3]}"] .cat-grp-btns`);t&&t.appendChild(b)});
 const bar=document.createElement("div");bar.className="cat-desc";
 bar.innerHTML='<span class="cat-desc-ic"></span><div class="cat-desc-tx"><b></b><span></span></div><button type="button" class="cat-guide-btn" aria-expanded="false">ⓘ CATEGORY GUIDE</button>';
 const guide=document.createElement("div");guide.className="cat-guide";guide.hidden=true;
 guide.innerHTML=GROUPS.map(g=>`<div class="guide-grp">${g[1]}</div>`+Object.entries(CATS).filter(([k,v])=>v[3]===g[0]).map(([k,v],i)=>`<div class="cat-guide-item" style="animation-delay:${i*30}ms"><i>${v[0]}</i><div><b>${v[1]}</b><span>${v[2]}</span></div></div>`).join("")).join("");
 panel.after(bar,guide);
 const show=k=>{const v=CATS[k]||CATS.all;bar.dataset.cat=k;bar.querySelector(".cat-desc-ic").textContent=v[0];bar.querySelector("b").textContent=v[1];bar.querySelector(".cat-desc-tx span").textContent=v[2]};
 const label=()=>{const a=$(".filter-btn.active"),k=a?a.dataset.category:"all",inPanel=a&&panel.contains(a);moreBtn.classList.toggle("on",!!inPanel);moreBtn.textContent=inPanel?CATS[k][0]+" "+CATS[k][1].toUpperCase()+(panel.hidden?" ▾":" ▴"):"＋ MORE CATEGORIES"+(panel.hidden?"":" ▴");show(k)};
 label();
 const sync=()=>setTimeout(label,0);fr.addEventListener("click",sync);panel.addEventListener("click",sync);
 const rs=$("#resetFiltersButton");rs&&rs.addEventListener("click",sync);
 moreBtn.onclick=()=>{panel.hidden=!panel.hidden;label()};
 panel.querySelector(".cat-more-search").addEventListener("input",e=>{const q=e.target.value.trim().toLowerCase();panel.querySelectorAll(".cat-grp").forEach(g=>{let n=0;g.querySelectorAll(".filter-btn").forEach(b=>{const m=!q||b.textContent.toLowerCase().includes(q);b.style.display=m?"":"none";if(m)n++});g.style.display=n?"":"none"})});
 const gb=bar.querySelector(".cat-guide-btn");gb.onclick=()=>{guide.hidden=!guide.hidden;gb.setAttribute("aria-expanded",String(!guide.hidden))};
}
const LAB={};Object.entries(CATS).forEach(([k,v])=>{if(k!=="all")LAB[v[1].toUpperCase()]=k});
const NEWC=Object.keys(CATS).filter(k=>!ORIG.includes(k));
function deco(){$$("#trackTable td .pill").forEach(p=>{if(p.dataset.cat)return;const t=p.textContent.toUpperCase().replace(/^[^A-Z]+/,"").trim(),k=LAB[t];if(k){p.dataset.cat=k;p.dataset.grp=CATS[k][3];p.title=CATS[k][2]}});
 const T=(window.__jp&&window.__jp.tracks?window.__jp.tracks():[]).filter(t=>t.era==="before");
 NEWC.forEach(k=>{const el=$("#count_"+k);if(el)el.textContent=T.filter(t=>String(t.category||"").split(",").includes(k)).length})}
const tt=$("#trackTable");tt&&new MutationObserver(deco).observe(tt,{childList:true});deco();setTimeout(deco,1500);
const co=$("#trackCategoryOptions");
if(co){const s=document.createElement("input");s.className="field cat-search";s.placeholder="⌕ Find a category…";s.setAttribute("aria-label","Find a category");co.before(s);
 const h=document.createElement("div");h.className="cat-help";h.textContent="Pick as many as fit. Hover one to see what it means.";co.after(h);
 s.addEventListener("input",()=>{const q=s.value.trim().toLowerCase();co.querySelectorAll("label").forEach(l=>{l.style.display=!q||l.textContent.toLowerCase().includes(q)?"":"none"})});
 co.querySelectorAll("label").forEach(l=>{const v=CATS[l.querySelector("input").value];if(!v)return;l.title=v[2];const f=()=>{h.textContent=v[1]+": "+v[2]};l.addEventListener("mouseenter",f);l.addEventListener("change",f)})}
})();
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const JP=()=>window.__jp||{};
const say=t=>{const e=$("#toast");if(!e)return;e.textContent=t;e.classList.add("show");clearTimeout(say.t);say.t=setTimeout(()=>e.classList.remove("show"),3600)};
const T=()=>JP().tracks?JP().tracks():[];
const by=id=>T().find(t=>String(t.id)===String(id));
/* when is archive dragging allowed? only on the full list in Custom order */
const archiveOK=()=>{const a=$("#sortSelect"),c=document.querySelector(".filter-btn.active"),y=$("#yearFilter"),s=$("#searchInput");
 return !!a&&a.value==="custom"&&!s.value.trim()&&(!c||c.dataset.category==="all")&&(!y||y.value==="all")&&!document.body.classList.contains("fav-only")&&!document.body.classList.contains("playable-only")};
setInterval(()=>document.body.classList.toggle("drag-ok",archiveOK()),400);
/* hint bar */
const tb=$(".toolbar");
if(tb){const h=document.createElement("div");h.className="order-hint";
 h.innerHTML='<span class="hint-off">☰ <b>Reorder songs:</b> switch to Custom order with no filters, then drag the ⋮⋮ handles.</span><span class="hint-on">☰ <b>Drag the ⋮⋮ handles</b> to put songs where you want. It saves instantly and everyone sees your order.</span><button class="secondary-btn" id="orderEnable" type="button">☰ USE CUSTOM ORDER</button>';
 tb.after(h);
 const st=document.createElement("style");st.textContent="body.drag-ok .hint-off,body:not(.drag-ok) .hint-on{display:none}";document.head.appendChild(st);
 $("#orderEnable").onclick=()=>{const r=$("#resetFiltersButton");r&&r.click();const s=$("#sortSelect");s.value="custom";s.dispatchEvent(new Event("change"));const c=document.querySelector(".fav-chip.on");c&&c.click()}}
/* handles */
const mk=()=>{const s=document.createElement("span");s.className="drag-h";s.textContent="⋮⋮";s.title="Drag to reorder";s.setAttribute("role","button");s.setAttribute("aria-label","Drag to reorder");return s};
function handles(){$$("#trackTable tr[data-track-id] .track-name-line").forEach(n=>{if(!n.querySelector(".drag-h"))n.prepend(mk())});$$("#albumList .album-track .album-actions").forEach(n=>{if(!n.querySelector(".drag-h"))n.prepend(mk())})}
["#trackTable","#albumList"].forEach(s=>{const el=$(s);el&&new MutationObserver(handles).observe(el,{childList:true})});handles();
/* pointer-based sorting (mouse + touch) */
let d=null;
function start(e,cont,sel,which){const h=e.target.closest(".drag-h");if(!h||!(JP().isAdmin&&JP().isAdmin()))return;if(which==="archive"&&!archiveOK())return;
 const row=h.closest(sel);if(!row)return;e.preventDefault();h.setPointerCapture(e.pointerId);
 const r=row.getBoundingClientRect();d={row,cont,sel,which,grab:e.clientY-r.top,first:row.dataset.trackId,order:[...cont.querySelectorAll(sel)].map(x=>x.dataset.trackId).join()};
 row.classList.add("drag-on");document.body.classList.add("dragging-now")}
$("#trackTable").addEventListener("pointerdown",e=>start(e,$("#trackTable"),"tr[data-track-id]","archive"));
$("#albumList").addEventListener("pointerdown",e=>start(e,$("#albumList"),".album-track[data-track-id]","album"));
addEventListener("pointermove",e=>{if(!d)return;e.stopPropagation();
 const r=d.row;r.style.transform="";const nat=r.getBoundingClientRect(),want=e.clientY-d.grab,mid=want+nat.height/2;
 for(const s of d.cont.querySelectorAll(d.sel)){if(s===r)continue;const sr=s.getBoundingClientRect();if(mid>sr.top&&mid<sr.bottom){const before=want;sr.top>nat.top?s.after(r):s.before(r);break}}
 r.style.transform="";const n2=r.getBoundingClientRect().top;r.style.transform=`translateY(${want-n2}px)`;
 if(e.clientY<90)scrollBy(0,-16);else if(e.clientY>innerHeight-90)scrollBy(0,16)},true);
const finish=async()=>{if(!d)return;const x=d;d=null;x.row.classList.remove("drag-on");x.row.style.transform="";document.body.classList.remove("dragging-now");
 const ids=[...x.cont.querySelectorAll(x.sel)].map(r=>r.dataset.trackId);if(ids.join()===x.order)return;
 try{x.which==="album"?await saveAlbum(ids):await saveArchive(ids,x.first)}catch(err){console.error(err);say(/sort_order|column/i.test(String(err&&err.message))?"Add the sort_order column in Supabase first (see the SQL I sent).":"Could not save the new order. Check admin and Supabase permissions.");JP().reload&&JP().reload()}};
addEventListener("pointerup",finish);addEventListener("pointercancel",finish);
async function run(updates,col){const sb=JP().sb;for(let i=0;i<updates.length;i+=15){const res=await Promise.all(updates.slice(i,i+15).map(([id,v])=>sb.from("tracks").update({[col]:v}).eq("id",id)));const bad=res.find(r=>r.error);if(bad)throw bad.error}}
async function saveArchive(ids,movedId){const objs=ids.map(by).filter(Boolean),i=ids.indexOf(String(movedId)),prev=objs[i-1],next=objs[i+1];let ups=[];
 if(objs.every(t=>t.sort_order!=null)){const a=prev?prev.sort_order:null,b=next?next.sort_order:null;let v;if(a==null&&b==null)v=1000;else if(a==null)v=b-1000;else if(b==null)v=a+1000;else v=(a+b)/2;
  if((a==null||v>a)&&(b==null||v<b))ups=[[objs[i].id,v]]}
 if(!ups.length)objs.forEach((t,k)=>{const v=(k+1)*1000;if(t.sort_order!==v)ups.push([t.id,v])});
 say(ups.length>1?"Saving the order for the first time…":"Order saved ✦");
 ups.forEach(([id,v])=>{by(id).sort_order=v});$("#sortSelect").dispatchEvent(new Event("change"));
 await run(ups,"sort_order");if(ups.length>1)say("Order saved ✦")}
async function saveAlbum(ids){const ups=[];ids.forEach((id,k)=>{const t=by(id);if(t&&t.album_order!==k+1){ups.push([id,k+1]);t.album_order=k+1}});if(!ups.length)return;await run(ups,"album_order");say("Album order saved ✦");JP().reload&&JP().reload()}
})();
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const JP=()=>window.__jp||{};
const admin=()=>!!(JP().isAdmin&&JP().isAdmin());
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const say=t=>{const e=$("#toast");if(!e)return;e.textContent=t;e.classList.add("show");clearTimeout(say.t);say.t=setTimeout(()=>e.classList.remove("show"),3000)};
const T=()=>JP().tracks?JP().tracks():[];
/* album songs show the same details as archive songs: categories, year, length */
function meta(){const C=window.__jpCats||{};
 $$("#albumList .album-track[data-track-id]").forEach(r=>{const t=T().find(x=>String(x.id)===r.dataset.trackId),info=r.children[1];if(!t||!info)return;
  let m=info.querySelector(".album-meta");const cats=String(t.category||"").split(",").filter(c=>c&&c!=="none");
  const html=cats.map(k=>`<span class="pill" data-cat="${esc(k)}" data-grp="${esc((C[k]||[])[3]||"")}" title="${esc((C[k]||[])[2]||"")}">${esc(JP().catLabel?JP().catLabel(k):k)}</span>`).join("")+(t.year?`<span class="chip">${esc(t.year)}</span>`:"")+(t.length?`<span class="chip">${esc(t.length)}</span>`:"");
  if(!html){m&&m.remove();return}
  if(!m){m=document.createElement("div");m.className="album-meta";const s=info.querySelector(".album-subtitle");s?s.after(m):info.appendChild(m)}
  if(m.dataset.h!==html){m.innerHTML=html;m.dataset.h=html}})}
const al=$("#albumList");if(al){new MutationObserver(meta).observe(al,{childList:true});meta();setTimeout(meta,1500);
 al.insertAdjacentHTML("afterend",'<p class="muted admin-only album-edit-note">Double-click an album track to edit it, or right-click for quick commands. Drag ⋮⋮ to reorder.</p>')}
/* edit album songs exactly like archive songs: double-click or right-click */
document.addEventListener("dblclick",e=>{if(!admin())return;const r=e.target.closest("#albumList .album-track");if(!r||e.target.closest("button"))return;JP().edit&&JP().edit(r.dataset.trackId)});
const menu=document.createElement("div");menu.className="context-menu";menu.id="albumMenu";
menu.innerHTML='<button data-a="edit">✎ Edit track</button><button data-a="play">▶ Play / open audio link</button><button data-a="move">⇄ Move to the archive</button><button data-a="del">🗑 Delete track</button>';
document.body.appendChild(menu);let mid=null;
document.addEventListener("contextmenu",e=>{const r=e.target.closest("#albumList .album-track");if(!r||!admin())return;e.preventDefault();mid=r.dataset.trackId;Object.assign(menu.style,{left:Math.min(e.clientX,innerWidth-200)+"px",top:Math.min(e.clientY,innerHeight-200)+"px"});menu.classList.add("open")});
document.addEventListener("click",e=>{if(!e.target.closest("#albumMenu"))menu.classList.remove("open")});
addEventListener("keydown",e=>{if(e.key==="Escape")menu.classList.remove("open")});
menu.addEventListener("click",async e=>{const b=e.target.closest("button");if(!b||!mid)return;menu.classList.remove("open");const a=b.dataset.a,t=T().find(x=>String(x.id)===String(mid));if(!t)return;
 if(a==="edit")JP().edit(mid);
 else if(a==="play")t.link?JP().play(mid):say("This track has no audio link yet.");
 else if(a==="del")JP().del(mid);
 else if(a==="move"){const {error}=await JP().sb.from("tracks").update({era:"before",album_order:null}).eq("id",mid);if(error){say("Could not move the track.");return}say("Moved to the archive ✦");JP().reload()}});
})();
</script>
</body>
</html>
<!-- ===== JOPPEPOPE UPGRADE PACK: paste this whole block right before </body> ===== -->
<style id="jp-upgrade">
/* ---------- NEW THEMES (Settings → Extra theme) ---------- */
body.xt-rose:not(.album-past){--accent:#ff5c8a;--accent2:#ffc2d4;--pink:#ff8fb1;--cyan:#ffd1a8;--glow:rgba(255,92,138,.28)}
body.xt-ice:not(.album-past){--accent:#6fd3ff;--accent2:#e2f8ff;--pink:#a9a6ff;--cyan:#7dffea;--glow:rgba(111,211,255,.26)}
body.xt-gold:not(.album-past){--accent:#ffc247;--accent2:#fff0b8;--pink:#ff9a3d;--cyan:#ffe08a;--glow:rgba(255,194,71,.28)}
body.xt-blood:not(.album-past){--accent:#ff2e3d;--accent2:#ff9aa2;--pink:#b3122a;--cyan:#ff6b4a;--glow:rgba(255,46,61,.3)}
body.xt-mono{--accent:#f2f2f2;--accent2:#bdbdbd;--pink:#8c8c8c;--cyan:#d9d9d9;--glow:rgba(255,255,255,.14)}
body.xt-vapor:not(.album-past){--accent:#ff71ce;--accent2:#01cdfe;--pink:#b967ff;--cyan:#05ffa1;--glow:rgba(185,103,255,.3)}
body.xt-aurora{--accent:#3dffa8;--accent2:#6fd3ff;--pink:#b07cff;--cyan:#ffd36e}
body.xt-aurora::before{animation:drift 12s ease-in-out infinite alternate,hue 24s linear infinite}
@keyframes hue{to{filter:hue-rotate(360deg)}}
body.xt-mono h1,body.xt-mono .hero-gradient{filter:grayscale(1)}
/* ---------- GLOBAL POLISH ---------- */
.toolbar{position:sticky;top:8px;z-index:30;padding:10px;margin-inline:-10px;border-radius:20px;background:rgba(10,8,16,.72);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid rgba(255,255,255,.08)}
tbody tr td:first-child{box-shadow:inset 0 0 0 0 var(--accent);transition:box-shadow .35s}
tbody tr:hover td:first-child{box-shadow:inset 4px 0 0 0 var(--accent)}
.pill{transition:transform .3s var(--spring),filter .2s}.pill:hover{transform:translateY(-2px) scale(1.06);filter:brightness(1.12)}
.filter-btn.active{outline:1px solid color-mix(in srgb,var(--accent) 70%,#fff);outline-offset:2px}
.filter-count:empty{display:none}
.modal{backdrop-filter:blur(8px)}
.cmd-item small{padding:3px 8px;border-radius:999px;background:rgba(255,255,255,.08)}
/* ---------- CATEGORY SUPERPOWERS ---------- */
.cat-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 16px}
.cat-tools .fav-chip{padding:10px 14px}
.cat-mode{display:inline-flex;border:1px solid rgba(255,255,255,.14);border-radius:999px;overflow:hidden}
.cat-mode button{border:0;background:transparent;color:var(--muted);padding:10px 14px;font-size:10px;font-weight:900;letter-spacing:.8px}
.cat-mode button.on{background:var(--accent);color:#10060a}
.multi-bar{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 14px}
.multi-bar:empty{display:none}
.multi-bar .pill{cursor:pointer;gap:6px}
.multi-bar .pill::after{content:"×";opacity:.7}
.cat-heat{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:0 0 14px}
.cat-heat button{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:10px 12px;border-radius:14px;border:1px solid rgba(255,255,255,.1);background:linear-gradient(90deg,color-mix(in srgb,var(--accent) calc(var(--w,0)*55%),transparent),rgba(255,255,255,.03));color:var(--text);font-size:11px;text-align:left;transition:transform .3s var(--spring)}
.cat-heat button:hover{transform:translateY(-2px)}
.cat-heat b{font-family:var(--font-d);font-size:12px}
/* ---------- ADMIN TOOLS ---------- */
#toolsModal .modal{width:min(900px,100%)}
.tl-top{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.tl-top .field{flex:1 1 200px;padding:11px 14px;border-radius:14px}
.tl-aud{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tl-aud button{padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.05);color:var(--text);font-size:10px;font-weight:900}
.tl-aud button.on{background:var(--accent);color:#10060a}
.tl-list{max-height:34vh;overflow:auto;border:1px solid rgba(255,255,255,.1);border-radius:16px;margin-bottom:14px}
.tl-row{display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid rgba(255,255,255,.06);font-size:12px;cursor:pointer}
.tl-row:hover{background:var(--glow)}.tl-row input{accent-color:var(--accent);width:16px;height:16px}
.tl-row small{margin-left:auto;color:var(--muted);font-size:9px;letter-spacing:1px;text-align:right}
.tl-box{display:grid;gap:10px;padding:14px;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.03);margin-bottom:12px}
.tl-box h4{margin:0;font-family:var(--font-d);font-size:10px;letter-spacing:3px;color:var(--accent)}
.tl-chips{display:flex;gap:6px;flex-wrap:wrap;max-height:130px;overflow:auto}
.tl-chips button{padding:7px 11px;border-radius:999px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.05);color:var(--text);font-size:11px;transition:transform .25s var(--spring)}
.tl-chips button:hover{transform:scale(1.06)}
.tl-chips button.on{background:var(--accent);color:#10060a;border-color:transparent}
.tl-chips button.rm{background:rgba(255,65,101,.9);color:#fff;border-color:transparent}
.tl-acts{display:flex;gap:8px;flex-wrap:wrap}
.tl-acts input,.tl-acts select{padding:10px 12px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:var(--text);width:120px}
.tl-acts select option{background:#14111d}
.admin-actions.three.four{grid-template-columns:repeat(4,1fr)}
</style>

<script id="jp-upgrade-js">
(()=>{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const JP=()=>window.__jp||{},CATS=()=>window.__jpCats||{};
const T=()=>JP().tracks?JP().tracks():[];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const say=t=>{const e=$("#toast");if(!e)return;e.textContent=t;e.classList.add("show");clearTimeout(say.t);say.t=setTimeout(()=>e.classList.remove("show"),3000)};
const catList=t=>String(t.category||"").split(",").map(s=>s.trim()).filter(c=>c&&c!=="none");
const catKeys=()=>Object.keys(CATS()).filter(k=>k!=="all");
const lab=k=>(CATS()[k]?CATS()[k][0]+" "+CATS()[k][1]:k);

/* ===== 1. EXTRA THEMES ===== */
const XT=[["","Default (use accent theme)"],["rose","🌹 Rose"],["ice","🧊 Ice"],["gold","👑 Gold"],["blood","🩸 Blood red"],["vapor","🌴 Vaporwave"],["aurora","🌌 Aurora (animated)"],["mono","⚫ Monochrome"]];
function setXT(v){document.body.className=document.body.className.replace(/\bxt-\w+/g,"").trim();if(v)document.body.classList.add("xt-"+v);try{localStorage.setItem("jp-xt",v)}catch{}const s=$("#xtSel");if(s)s.value=v}
const so=$(".settings-options");
if(so){const d=document.createElement("div");d.className="form-field";d.innerHTML='<label for="xtSel">Extra theme</label><select id="xtSel">'+XT.map(x=>`<option value="${x[0]}">${x[1]}</option>`).join("")+"</select>";so.prepend(d);$("#xtSel").onchange=e=>setXT(e.target.value)}
let saved="";try{saved=localStorage.getItem("jp-xt")||""}catch{}setXT(saved);

/* ===== 2. CATEGORIES: multi-select filter (ANY / ALL), heatmap, palette ===== */
let sel=new Set(),mode="any";
const fr=$(".filter-row");
const tools=document.createElement("div");tools.className="cat-tools";
tools.innerHTML='<span class="cat-mode"><button data-m="any" class="on">MATCH ANY</button><button data-m="all">MATCH ALL</button></span><button class="fav-chip" id="heatBtn" type="button">📊 CATEGORY MAP</button><button class="fav-chip" id="clearMulti" type="button">✕ CLEAR PICKS</button>';
const bar=document.createElement("div");bar.className="multi-bar";
const heat=document.createElement("div");heat.className="cat-heat";heat.hidden=true;
const anchor=$(".cat-desc")||fr;if(anchor)anchor.after(tools,bar,heat);
function apply(){
  $$("#trackTable tr[data-track-id]").forEach(r=>{
    if(!sel.size){r.style.display="";return}
    const t=T().find(x=>String(x.id)===r.dataset.trackId);if(!t){return}
    const c=catList(t),ok=mode==="all"?[...sel].every(k=>c.includes(k)):[...sel].some(k=>c.includes(k));
    r.style.display=ok?"":"none"});
  bar.innerHTML=[...sel].map(k=>`<span class="pill" data-cat="${k}" data-x="${k}">${esc(lab(k))}</span>`).join("");
  const n=$$("#trackTable tr[data-track-id]").filter(r=>r.style.display!=="none").length;
  if(sel.size){const f=$("#filterStatus");if(f)f.textContent=`Showing ${n} tracks matching ${mode.toUpperCase()} of ${sel.size} picked categories`}}
bar.onclick=e=>{const p=e.target.closest("[data-x]");if(p){sel.delete(p.dataset.x);apply()}};
tools.onclick=e=>{const m=e.target.closest("[data-m]");if(m){mode=m.dataset.m;$$(".cat-mode button").forEach(b=>b.classList.toggle("on",b===m));apply()}
  if(e.target.id==="clearMulti"){sel.clear();apply()}
  if(e.target.id==="heatBtn"){heat.hidden=!heat.hidden;if(!heat.hidden)drawHeat()}};
function drawHeat(){const T0=T().filter(t=>t.era==="before"),cnt={};catKeys().forEach(k=>cnt[k]=T0.filter(t=>catList(t).includes(k)).length);
  const mx=Math.max(1,...Object.values(cnt));
  heat.innerHTML=catKeys().sort((a,b)=>cnt[b]-cnt[a]).map(k=>`<button type="button" data-k="${k}" style="--w:${cnt[k]/mx}" title="Click to add to multi-filter (shift+click any button for the same)"><span>${esc(lab(k))}</span><b>${cnt[k]}</b></button>`).join("")}
heat.onclick=e=>{const b=e.target.closest("[data-k]");if(!b)return;const k=b.dataset.k;sel.has(k)?sel.delete(k):sel.add(k);apply()};
if(fr)fr.addEventListener("click",e=>{const b=e.target.closest(".filter-btn");if(b&&e.shiftKey&&b.dataset.category!=="all"){e.stopImmediatePropagation();e.preventDefault();const k=b.dataset.category;sel.has(k)?sel.delete(k):sel.add(k);apply()}},true);
$(".cat-more")&&$(".cat-more").addEventListener("click",e=>{const b=e.target.closest(".filter-btn");if(b&&e.shiftKey){e.stopImmediatePropagation();e.preventDefault();const k=b.dataset.category;sel.has(k)?sel.delete(k):sel.add(k);apply()}},true);
const tt=$("#trackTable");tt&&new MutationObserver(()=>{if(sel.size)apply()}).observe(tt,{childList:true});
/* complete counts for every category button */
function counts(){const T0=T().filter(t=>t.era==="before");catKeys().forEach(k=>{const el=$("#count_"+k);if(el)el.textContent=T0.filter(t=>catList(t).includes(k)).length});if(!heat.hidden)drawHeat()}
tt&&new MutationObserver(counts).observe(tt,{childList:true});setTimeout(counts,1500);
/* palette: filter by any category */
const C=window.__jpCmds;if(C){catKeys().forEach(k=>C.push(["🏷 Filter: "+lab(k),"CATEGORY",()=>{const b=$(`.filter-btn[data-category="${k}"]`);b&&b.click();scrollTo({top:$("#beforeSection").offsetTop,behavior:"smooth"})}]));
  C.push(["📊 Category map","COMMAND",()=>$("#heatBtn").click()],["🛠 Admin tools","ADMIN",()=>openTools()],["🎲 Play a random track","COMMAND",()=>{const p=T().filter(t=>t.link);p.length&&JP().play(p[Math.random()*p.length|0].id)}],["📥 Export CSV","ADMIN",()=>csv()])}

/* ===== 3. ADMIN TOOLS MODAL: bulk edit, audit, CSV, import ===== */
const m=document.createElement("div");m.className="modal-backdrop";m.id="toolsModal";
m.innerHTML=`<div class="modal"><div class="eyebrow">ADMIN / POWER TOOLS</div><h2>Bulk control.</h2><p class="modal-desc">Select tracks, then tag, retag, move, set year, or delete them in one click. Audit shows what's still incomplete.</p>
<div class="tl-aud" id="tlAud"></div>
<div class="tl-top"><input class="field" id="tlQ" placeholder="⌕ Filter tracks…"><button class="secondary-btn" id="tlAll" type="button">SELECT ALL SHOWN</button><button class="secondary-btn" id="tlNone" type="button">CLEAR</button></div>
<div class="tl-list" id="tlList"></div>
<div class="tl-box"><h4>CATEGORIES FOR <span id="tlN">0</span> SELECTED</h4><div class="tl-chips" id="tlChips"></div>
<div class="tl-acts"><button class="primary-btn" id="tlAdd" type="button">＋ ADD PICKED</button><button class="secondary-btn" id="tlRem" type="button">− REMOVE PICKED</button><button class="secondary-btn" id="tlSet" type="button">= REPLACE WITH PICKED</button><button class="secondary-btn" id="tlClr" type="button">CLEAR ALL CATEGORIES</button></div></div>
<div class="tl-box"><h4>OTHER ACTIONS</h4><div class="tl-acts"><input id="tlYear" type="number" placeholder="Year"><button class="secondary-btn" id="tlYearGo" type="button">SET YEAR</button><button class="secondary-btn" id="tlMove" type="button">⇄ MOVE ERA</button><button class="danger-btn" id="tlDel" type="button">⌫ DELETE</button></div></div>
<div class="tl-box"><h4>DATA</h4><div class="tl-acts"><button class="secondary-btn" id="tlCsv" type="button">⤓ EXPORT CSV</button><label class="secondary-btn" style="cursor:pointer">⤒ IMPORT BACKUP JSON<input id="tlImp" type="file" accept=".json" hidden></label><button class="secondary-btn" id="tlDup" type="button">⧉ DUPLICATE SELECTED</button></div></div>
<div class="modal-actions"><button class="primary-btn" type="button" data-close="toolsModal">DONE ✦</button></div></div>`;
document.body.appendChild(m);
m.addEventListener("click",e=>{if(e.target===m||e.target.closest("[data-close=toolsModal]"))m.classList.remove("open")});
let chosen=new Set(),picked=new Set(),aud="all";
const AUD={all:["ALL",()=>true],link:["NO LINK",t=>!(t.link||"").trim()],desc:["NO DESCRIPTION",t=>!(t.description||"").trim()],cat:["NO CATEGORY",t=>!catList(t).length],year:["NO YEAR",t=>!t.year],len:["NO LENGTH",t=>!t.length],untitled:["UNTITLED",t=>/^untitled$/i.test(t.name.trim())],dup:["DUPLICATE NAMES",(t,all)=>all.filter(x=>x.name.toLowerCase()===t.name.toLowerCase()).length>1]};
const shown=()=>{const q=$("#tlQ").value.trim().toLowerCase(),all=T();return all.filter(t=>AUD[aud][1](t,all)&&(!q||(t.name+" "+t.aliases).toLowerCase().includes(q)))};
function draw(){const all=T();
  $("#tlAud").innerHTML=Object.entries(AUD).map(([k,v])=>`<button type="button" data-a="${k}" class="${aud===k?"on":""}">${v[0]} · ${all.filter(t=>v[1](t,all)).length}</button>`).join("");
  $("#tlList").innerHTML=shown().map(t=>`<label class="tl-row"><input type="checkbox" data-id="${esc(t.id)}" ${chosen.has(String(t.id))?"checked":""}><span>${t.era==="album"?"🔵":"🟠"} ${esc(t.name)}</span><small>${esc(catList(t).map(k=>(CATS()[k]||[""])[0]).join(" ")||"no categories")}</small></label>`).join("")||'<div class="empty">Nothing here. 🎉</div>';
  $("#tlN").textContent=chosen.size;
  $("#tlChips").innerHTML=catKeys().map(k=>`<button type="button" data-c="${k}" class="${picked.has(k)?"on":""}" title="${esc((CATS()[k]||[])[2]||"")}">${esc(lab(k))}</button>`).join("")}
$("#tlAud").onclick=e=>{const b=e.target.closest("[data-a]");if(b){aud=b.dataset.a;draw()}};
$("#tlQ").oninput=draw;
$("#tlList").onchange=e=>{const i=e.target.closest("input[data-id]");if(!i)return;i.checked?chosen.add(i.dataset.id):chosen.delete(i.dataset.id);$("#tlN").textContent=chosen.size};
$("#tlChips").onclick=e=>{const b=e.target.closest("[data-c]");if(!b)return;const k=b.dataset.c;picked.has(k)?picked.delete(k):picked.add(k);draw()};
$("#tlAll").onclick=()=>{shown().forEach(t=>chosen.add(String(t.id)));draw()};
$("#tlNone").onclick=()=>{chosen.clear();draw()};
const ids=()=>[...chosen];
const guard=()=>{if(!(JP().isAdmin&&JP().isAdmin())){say("Unlock admin first.");return false}if(!chosen.size){say("Select at least one track.");return false}return true};
async function write(fn,msg){const rs=await Promise.all(ids().map(fn));const bad=rs.find(r=>r.error);if(bad){console.error(bad.error);say("Some changes failed. Check Supabase permissions.");}else say(msg+" ✦");await JP().reload();draw()}
const upCats=f=>write(id=>{const t=T().find(x=>String(x.id)===id),c=f(catList(t));return JP().sb.from("tracks").update({category:c.join(",")||"none"}).eq("id",t.id)},"Categories updated");
$("#tlAdd").onclick=()=>{if(!guard())return;if(!picked.size)return say("Pick categories first.");upCats(c=>[...new Set([...c,...picked])])};
$("#tlRem").onclick=()=>{if(!guard())return;if(!picked.size)return say("Pick categories first.");upCats(c=>c.filter(k=>!picked.has(k)))};
$("#tlSet").onclick=()=>{if(!guard())return;upCats(()=>[...picked])};
$("#tlClr").onclick=()=>{if(!guard())return;if(confirm("Remove ALL categories from "+chosen.size+" tracks?"))upCats(()=>[])};
$("#tlYearGo").onclick=()=>{if(!guard())return;const y=$("#tlYear").value;write(id=>JP().sb.from("tracks").update({year:y?Number(y):null}).eq("id",id),"Year set")};
$("#tlMove").onclick=()=>{if(!guard())return;write(id=>{const t=T().find(x=>String(x.id)===id),to=t.era==="album"?"before":"album";return JP().sb.from("tracks").update(to==="album"?{era:to,album_order:99}:{era:to,album_order:null}).eq("id",id)},"Moved")};
$("#tlDel").onclick=()=>{if(!guard())return;if(confirm("Permanently delete "+chosen.size+" tracks?")){write(id=>JP().sb.from("tracks").delete().eq("id",id),"Deleted");chosen.clear()}};
$("#tlDup").onclick=()=>{if(!guard())return;const rows=ids().map(id=>T().find(x=>String(x.id)===id)).map(t=>({name:t.name+" (copy)",aliases:t.aliases,year:t.year||null,date:t.date||null,details:t.details,description:t.description,length:t.length,link:t.link,category:t.category,era:t.era}));JP().sb.from("tracks").insert(rows).then(r=>{r.error?say("Could not duplicate."):say("Duplicated ✦");JP().reload().then?.(draw)})};
function csv(){const q=v=>'"'+String(v??"").replace(/"/g,'""')+'"',h=["name","aliases","era","year","date","length","category","link","description","details"];
  const b=new Blob([[h.join(",")].concat(T().map(t=>h.map(k=>q(t[k])).join(","))).join("\n")],{type:"text/csv"}),a=document.createElement("a");a.href=URL.createObjectURL(b);a.download="joppepope-"+new Date().toISOString().slice(0,10)+".csv";a.click();say("CSV downloaded ⤓")}
$("#tlCsv").onclick=csv;
$("#tlImp").onchange=async e=>{const f=e.target.files[0];if(!f)return;if(!(JP().isAdmin&&JP().isAdmin()))return say("Unlock admin first.");try{const rows=JSON.parse(await f.text());if(!Array.isArray(rows))throw 0;
  const have=new Set(T().map(t=>t.name.toLowerCase()+"|"+t.era)),fresh=rows.filter(r=>r.name&&!have.has(String(r.name).toLowerCase()+"|"+(r.era==="album"?"album":"before"))).map(r=>({name:r.name,aliases:r.aliases||"",year:r.year||null,date:r.date||null,details:r.details||"",description:r.description||"",length:r.length||"",link:r.link||"",category:r.category||"none",era:r.era==="album"?"album":"before"}));
  if(!fresh.length)return say("Nothing new to import.");const r=await JP().sb.from("tracks").insert(fresh);r.error?say("Import failed."):say("Imported "+fresh.length+" new tracks ✦");JP().reload()}catch{say("That isn't a valid backup file.")}e.target.value=""};
function openTools(){if(!(JP().isAdmin&&JP().isAdmin()))return say("Unlock admin first.");$$(".modal-backdrop.open").forEach(x=>x.classList.remove("open"));draw();m.classList.add("open")}
const ut=$(".admin-actions.three");if(ut){ut.classList.add("four");const b=document.createElement("button");b.className="admin-chip";b.type="button";b.innerHTML="<span>🛠</span>TOOLS";b.onclick=openTools;ut.prepend(b)}
addEventListener("keydown",e=>{if(e.ctrlKey&&e.shiftKey&&e.key.toLowerCase()==="a"){e.preventDefault();openTools()}});
})();
</script>
<!-- ===== END UPGRADE PACK ===== -->
